<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.ProjectAnalyticsView"
    x:DataType="vm:ProjectAnalyticsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">

                    <!-- ================================================= -->
                    <!-- HEADER -->
                    <!-- ================================================= -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <!-- MENU -->
                        <Button
                            Grid.Column="0"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Project Analytics"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Performance and usage insights"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>

                        <!-- THEME -->
                        <Button
                            Grid.Column="2"
                            Text="{Binding ThemeIcon}"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                        <!-- REFRESH -->
                        <Button
                            Grid.Column="3"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- PROJECT PICKER -->
                    <!-- ================================================= -->

                    <Frame
                        Padding="0"
                        CornerRadius="12"
                        HasShadow="False"
                        BorderColor="{DynamicResource InputBorder}"
                        BackgroundColor="{DynamicResource InputBg}"
                        HeightRequest="50"
                        Margin="20,16,20,0">

                        <Grid
                            ColumnDefinitions="Auto,*">

                            <Label
                                Grid.Column="0"
                                Text="&#xf07c;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Text3}"
                                Margin="14,0,0,0"
                                VerticalOptions="Center"/>

                            <Picker
                                Grid.Column="1"
                                ItemsSource="{Binding Projects}"
                                SelectedItem="{Binding SelectedProject}"
                                ItemDisplayBinding="{Binding ProjectName}"
                                Title="Select a project..."
                                TitleColor="{DynamicResource Text3}"
                                TextColor="{DynamicResource Text1}"
                                FontSize="14"
                                Margin="8,0"
                                BackgroundColor="Transparent"/>

                        </Grid>

                    </Frame>


                    <!-- ================================================= -->
                    <!-- LOADING -->
                    <!-- ================================================= -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,20"/>


                    <!-- ================================================= -->
                    <!-- EMPTY STATE -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        IsVisible="{Binding IsIdle}"
                        Padding="40"
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Label
                            Text="&#xf080;"
                            FontFamily="FontAwesome"
                            FontSize="42"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="No Project Selected"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Select a project above to view analytics"
                            FontSize="13"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- ANALYTICS CONTENT -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        IsVisible="{Binding HasSelectedProject}"
                        Spacing="0">


                        <!-- ================================================= -->
                        <!-- PROJECT BANNER -->
                        <!-- ================================================= -->

                        <Frame
                            BackgroundColor="#1d4ed8"
                            BorderColor="Transparent"
                            CornerRadius="16"
                            Padding="16"
                            HasShadow="False"
                            Margin="20,16,20,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="14">

                                <Frame
                                    Grid.Column="0"
                                    BackgroundColor="#2563eb"
                                    BorderColor="Transparent"
                                    CornerRadius="10"
                                    Padding="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    HasShadow="False"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf080;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        TextColor="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Frame>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="Analytics Report"
                                        FontSize="10"
                                        TextColor="#93c5fd"/>

                                    <Label
                                        Text="{Binding SelectedProject.ProjectName}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="White"/>

                                    <HorizontalStackLayout
                                        Spacing="6">

                                        <Label
                                            Text="&#xf3c5;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="#bfdbfe"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="{Binding SelectedProject.Location}"
                                            FontSize="11"
                                            TextColor="#bfdbfe"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        FontSize="11"
                                        TextColor="#bfdbfe">

                                        <Label.FormattedText>
                                            <FormattedString>

                                                <Span Text="{Binding SelectedProject.StartDateLabel}"/>

                                                <Span Text="  -  "/>

                                                <Span Text="{Binding SelectedProject.EndDateLabel}"/>

                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                    <Label
                                        Text="{Binding SelectedProject.DurationLabel}"
                                        FontSize="10"
                                        TextColor="#93c5fd"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- TOOL OVERVIEW -->
                        <!-- ================================================= -->

                        <HorizontalStackLayout
                            Spacing="8"
                            Margin="20,20,20,10">

                            <Label
                                Text="&#xf0ad;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Text2}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="Tool Overview"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>


                        <!-- COMPACT TOOL SUMMARY -->

                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="16"
                            Padding="10,14"
                            HasShadow="False"
                            Margin="20,0">

                            <Grid
                                ColumnDefinitions="*,*,*,*"
                                ColumnSpacing="4">


                                <!-- TOTAL -->

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalTools}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <!-- AVAILABLE -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf00c;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding AvailableTools}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Available"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <!-- DAMAGED -->

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf071;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding DamagedTools}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Damaged"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <!-- LOST -->

                                <VerticalStackLayout
                                    Grid.Column="3"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf00d;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Red}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding LostTools}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Red}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Lost"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- TRANSACTION SUMMARY -->
                        <!-- ================================================= -->

                        <HorizontalStackLayout
                            Spacing="8"
                            Margin="20,20,20,10">

                            <Label
                                Text="&#xf15c;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Text2}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="Transaction Summary"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>


                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="16"
                            Padding="10,14"
                            HasShadow="False"
                            Margin="20,0">

                            <Grid
                                ColumnDefinitions="*,*,*,*"
                                ColumnSpacing="4">


                                <!-- TOTAL -->

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf15c;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalTransactions}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <!-- BORROWS -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf49e;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalBorrows}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Borrows"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <!-- RETURNS -->

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf2ea;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalReturns}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Returns"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <!-- TRANSFERS -->

                                <VerticalStackLayout
                                    Grid.Column="3"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf362;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalTransfers}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Transfers"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- WORKER PERFORMANCE -->
                        <!-- ================================================= -->

                        <HorizontalStackLayout
                            Spacing="8"
                            Margin="20,20,20,10">

                            <Label
                                Text="&#xf508;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Text2}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="Worker Performance"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>


                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="16"
                            Padding="0"
                            HasShadow="False"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="0">


                                <!-- MOST ACTIVE WORKER -->

                                <Frame
                                    IsVisible="{Binding HasMostActiveWorker}"
                                    BackgroundColor="#0a2a1e"
                                    BorderColor="Transparent"
                                    CornerRadius="0"
                                    Padding="16,12"
                                    HasShadow="False">

                                    <VerticalStackLayout
                                        Spacing="4">

                                        <HorizontalStackLayout
                                            Spacing="6">

                                            <Label
                                                Text="&#xf091;"
                                                FontFamily="FontAwesome"
                                                FontSize="11"
                                                TextColor="#10b981"
                                                VerticalOptions="Center"/>

                                            <Label
                                                Text="Most Active Worker"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#10b981"/>

                                        </HorizontalStackLayout>

                                        <Label
                                            Text="{Binding MostActiveWorker.WorkerName}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text1}"/>

                                        <HorizontalStackLayout
                                            Spacing="12">

                                            <Label
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}">

                                                <Label.FormattedText>
                                                    <FormattedString>

                                                        <Span Text="Borrows: "/>

                                                        <Span
                                                            Text="{Binding MostActiveWorker.Borrows}"
                                                            FontAttributes="Bold"/>

                                                    </FormattedString>
                                                </Label.FormattedText>

                                            </Label>

                                            <Label
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}">

                                                <Label.FormattedText>
                                                    <FormattedString>

                                                        <Span Text="Transfers: "/>

                                                        <Span
                                                            Text="{Binding MostActiveWorker.TransfersReceived}"
                                                            FontAttributes="Bold"/>

                                                    </FormattedString>
                                                </Label.FormattedText>

                                            </Label>

                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </Frame>


                                <BoxView
                                    IsVisible="{Binding HasMostActiveWorker}"
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- WORKERS -->

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding WorkerStats}"
                                    Spacing="0">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:WorkerStatItem">

                                            <VerticalStackLayout
                                                Spacing="0">

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    Padding="16,12"
                                                    ColumnSpacing="12">


                                                    <!-- AVATAR -->

                                                    <Frame
                                                        Grid.Column="0"
                                                        BackgroundColor="#1d4ed8"
                                                        CornerRadius="18"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        Padding="0"
                                                        HasShadow="False"
                                                        BorderColor="Transparent"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding WorkerInitials}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="White"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"/>

                                                    </Frame>


                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="6"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding WorkerName}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>


                                                        <FlexLayout
                                                            Direction="Row"
                                                            Wrap="Wrap"
                                                            AlignItems="Center">


                                                            <!-- BORROWS -->

                                                            <Frame
                                                                BackgroundColor="{DynamicResource BlueSubtle}"
                                                                BorderColor="Transparent"
                                                                CornerRadius="8"
                                                                Padding="8,4"
                                                                Margin="0,0,6,4"
                                                                HasShadow="False">

                                                                <Label
                                                                    FontSize="10"
                                                                    FontAttributes="Bold"
                                                                    TextColor="{DynamicResource Blue}">

                                                                    <Label.FormattedText>
                                                                        <FormattedString>

                                                                            <Span Text="Borrows  "/>

                                                                            <Span Text="{Binding Borrows}"/>

                                                                        </FormattedString>
                                                                    </Label.FormattedText>

                                                                </Label>

                                                            </Frame>


                                                            <!-- TRANSFERS -->

                                                            <Frame
                                                                BackgroundColor="{DynamicResource BgElevated}"
                                                                BorderColor="Transparent"
                                                                CornerRadius="8"
                                                                Padding="8,4"
                                                                Margin="0,0,6,4"
                                                                HasShadow="False">

                                                                <Label
                                                                    FontSize="10"
                                                                    FontAttributes="Bold"
                                                                    TextColor="{DynamicResource Blue}">

                                                                    <Label.FormattedText>
                                                                        <FormattedString>

                                                                            <Span Text="Transfers  "/>

                                                                            <Span Text="{Binding TransfersReceived}"/>

                                                                        </FormattedString>
                                                                    </Label.FormattedText>

                                                                </Label>

                                                            </Frame>


                                                            <!-- DAMAGE -->

                                                            <Frame
                                                                IsVisible="{Binding HasDamages}"
                                                                BackgroundColor="{DynamicResource RedBg}"
                                                                BorderColor="Transparent"
                                                                CornerRadius="8"
                                                                Padding="8,4"
                                                                Margin="0,0,6,4"
                                                                HasShadow="False">

                                                                <Label
                                                                    FontSize="10"
                                                                    FontAttributes="Bold"
                                                                    TextColor="{DynamicResource Red}">

                                                                    <Label.FormattedText>
                                                                        <FormattedString>

                                                                            <Span Text="Damages  "/>

                                                                            <Span Text="{Binding Damages}"/>

                                                                        </FormattedString>
                                                                    </Label.FormattedText>

                                                                </Label>

                                                            </Frame>

                                                        </FlexLayout>

                                                    </VerticalStackLayout>

                                                </Grid>


                                                <BoxView
                                                    HeightRequest="1"
                                                    Color="{DynamicResource BorderSoft}"
                                                    Margin="16,0"/>

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- TOOL USAGE -->
                        <!-- ================================================= -->

                        <HorizontalStackLayout
                            Spacing="8"
                            Margin="20,20,20,10">

                            <Label
                                Text="&#xf0ad;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Text2}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="Tool Usage"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>


                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="16"
                            Padding="0"
                            HasShadow="False"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="0">


                                <!-- MOST USED TOOL -->

                                <Frame
                                    IsVisible="{Binding HasMostUsedTool}"
                                    BackgroundColor="#0f1c35"
                                    BorderColor="Transparent"
                                    CornerRadius="0"
                                    Padding="16,12"
                                    HasShadow="False">

                                    <VerticalStackLayout
                                        Spacing="3">

                                        <HorizontalStackLayout
                                            Spacing="6">

                                            <Label
                                                Text="&#xf091;"
                                                FontFamily="FontAwesome"
                                                FontSize="11"
                                                TextColor="{DynamicResource Blue}"
                                                VerticalOptions="Center"/>

                                            <Label
                                                Text="Most Used Tool"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Blue}"/>

                                        </HorizontalStackLayout>

                                        <Label
                                            Text="{Binding MostUsedTool.ToolName}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text1}"/>

                                        <Label
                                            FontSize="12"
                                            TextColor="{DynamicResource Text3}">

                                            <Label.FormattedText>
                                                <FormattedString>

                                                    <Span Text="{Binding MostUsedTool.ToolId}"/>

                                                    <Span Text="  ·  "/>

                                                    <Span
                                                        Text="{Binding MostUsedTool.Usage,
                                                        StringFormat='{0} times borrowed'}"/>

                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>

                                    </VerticalStackLayout>

                                </Frame>


                                <BoxView
                                    IsVisible="{Binding HasMostUsedTool}"
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- TOOL ROWS -->

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding ToolStats}"
                                    Spacing="0">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:ToolStatItem">

                                            <VerticalStackLayout
                                                Spacing="0">

                                                <Grid
                                                    ColumnDefinitions="*,Auto,Auto,Auto"
                                                    Padding="16,12"
                                                    ColumnSpacing="8">


                                                    <VerticalStackLayout
                                                        Grid.Column="0"
                                                        Spacing="2"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding ToolName}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                        <Label
                                                            Text="{Binding ToolId}"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Blue}"/>

                                                    </VerticalStackLayout>


                                                    <!-- USAGE -->

                                                    <Frame
                                                        Grid.Column="1"
                                                        BackgroundColor="{DynamicResource BlueSubtle}"
                                                        BorderColor="Transparent"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        HasShadow="False"
                                                        VerticalOptions="Center">

                                                        <HorizontalStackLayout
                                                            Spacing="4">

                                                            <Label
                                                                Text="&#xf49e;"
                                                                FontFamily="FontAwesome"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Blue}"
                                                                VerticalOptions="Center"/>

                                                            <Label
                                                                Text="{Binding Usage}"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Blue}"/>

                                                        </HorizontalStackLayout>

                                                    </Frame>


                                                    <!-- DAMAGE -->

                                                    <Frame
                                                        Grid.Column="2"
                                                        BackgroundColor="{DynamicResource RedBg}"
                                                        BorderColor="Transparent"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        HasShadow="False"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding HasDamages}">

                                                        <HorizontalStackLayout
                                                            Spacing="4">

                                                            <Label
                                                                Text="&#xf071;"
                                                                FontFamily="FontAwesome"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Red}"
                                                                VerticalOptions="Center"/>

                                                            <Label
                                                                Text="{Binding Damages}"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Red}"/>

                                                        </HorizontalStackLayout>

                                                    </Frame>


                                                    <!-- STATUS -->

                                                    <Frame
                                                        Grid.Column="3"
                                                        BackgroundColor="{DynamicResource BgElevated}"
                                                        BorderColor="Transparent"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        HasShadow="False"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding Status}"
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding StatusColor}"/>

                                                    </Frame>

                                                </Grid>


                                                <BoxView
                                                    HeightRequest="1"
                                                    Color="{DynamicResource BorderSoft}"
                                                    Margin="16,0"/>

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- DAMAGE REPORT SUMMARY -->
                        <!-- ================================================= -->

                        <HorizontalStackLayout
                            Spacing="8"
                            Margin="20,20,20,10">

                            <Label
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="Damage Report Summary"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>


                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="16"
                            Padding="0"
                            HasShadow="False"
                            Margin="20,0">

                            <Grid
                                ColumnDefinitions="*,*,*"
                                Padding="16">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding TotalReports}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding PendingReports}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Pending"
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding ResolvedReports}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Resolved"
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- RISK INSIGHTS -->
                        <!-- ================================================= -->

                        <HorizontalStackLayout
                            Spacing="8"
                            Margin="20,20,20,10">

                            <Label
                                Text="&#xf002;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Text2}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="Risk Insights"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>


                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="16"
                            Padding="16"
                            HasShadow="False"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="12">


                                <!-- DISPUTED -->

                                <HorizontalStackLayout
                                    Spacing="8">

                                    <Label
                                        Text="&#xf24e;"
                                        FontFamily="FontAwesome"
                                        FontSize="13"
                                        TextColor="{DynamicResource Text3}"
                                        VerticalOptions="Center"/>

                                    <Label
                                        FontSize="13"
                                        TextColor="{DynamicResource Text2}">

                                        <Label.FormattedText>
                                            <FormattedString>

                                                <Span
                                                    Text="{Binding DisputedReports}"
                                                    FontAttributes="Bold"/>

                                                <Span Text=" report(s) currently disputed"/>

                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </HorizontalStackLayout>


                                <!-- HIGH RISK -->

                                <Label
                                    Text="High-risk tools (2+ incidents)"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text3}"/>

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding HighRiskTools}"
                                    Spacing="4">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:ToolRiskItem">

                                            <Label
                                                Text="{Binding Label}"
                                                FontSize="12"
                                                TextColor="{DynamicResource Red}"/>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>


                                <!-- WORKER RISK -->

                                <Label
                                    Text="Workers frequently in reports (2+)"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text3}"/>

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding FrequentlyInvolvedWorkers}"
                                    Spacing="4">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:WorkerRiskItem">

                                            <Label
                                                Text="{Binding Label}"
                                                FontSize="12"
                                                TextColor="{DynamicResource Amber}"/>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Frame>

                    </VerticalStackLayout>


                    <!-- FOOTER -->

                    <Label
                        Text="© 2026 StockGuard"
                        FontSize="10"
                        TextColor="{DynamicResource Text3}"
                        HorizontalOptions="Center"
                        Margin="0,20,0,0"/>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.ProjectAnalyticsView"
    x:DataType="vm:ProjectAnalyticsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- ═══════════════════════════════════════
                         HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">


                        <!-- MENU -->
                        <Button
                            Grid.Column="0"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>


                        <!-- TITLE -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Project Analytics"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Project equipment and activity overview."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>


                        <!-- REFRESH -->
                        <Button
                            Grid.Column="2"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>


                        <!-- THEME -->
                       

                    </Grid>



                    <!-- ═══════════════════════════════════════
                         PAGE INTRO
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            Text="Analytics"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Review equipment usage, worker activity, and damage records."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         PROJECT SELECTION
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,22,20,0"
                        Spacing="8">

                        <Label
                            Text="Select Project"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Border
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource InputBg}"
                            HeightRequest="50">

                            <Grid
                                ColumnDefinitions="Auto,*">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf07c;"
                                    FontFamily="FontAwesome"
                                    FontSize="15"
                                    TextColor="{DynamicResource Text3}"
                                    Margin="14,0,0,0"
                                    VerticalOptions="Center"/>

                                <Picker
                                    Grid.Column="1"
                                    ItemsSource="{Binding Projects}"
                                    SelectedItem="{Binding SelectedProject}"
                                    ItemDisplayBinding="{Binding ProjectName}"
                                    Title="Select a project..."
                                    TitleColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    FontSize="14"
                                    Margin="8,0"
                                    BackgroundColor="Transparent"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         LOADING
                         ═══════════════════════════════════════ -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,18,0,0"/>



                    <!-- ═══════════════════════════════════════
                         NO PROJECT
                         ═══════════════════════════════════════ -->

                    <Border
                        IsVisible="{Binding IsIdle}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource BgCard}"
                        Padding="26"
                        Margin="20,18,20,0">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="&#xf080;"
                                FontFamily="FontAwesome"
                                FontSize="25"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No Project Selected"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Select a project to view its analytics."
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>



                    <!-- ═══════════════════════════════════════
                         ANALYTICS CONTENT
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        IsVisible="{Binding HasSelectedProject}"
                        Spacing="0">


                        <!-- ═══════════════════════════════════════
                             SELECTED PROJECT
                             ═══════════════════════════════════════ -->

                        <Border
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="14"
                            Margin="20,18,20,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf1ad;"
                                    FontFamily="FontAwesome"
                                    FontSize="19"
                                    TextColor="{DynamicResource Blue}"
                                    WidthRequest="38"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding SelectedProject.ProjectName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        LineBreakMode="TailTruncation"/>

                                    <HorizontalStackLayout
                                        Spacing="5">

                                        <Label
                                            Text="&#xf3c5;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="{Binding SelectedProject.Location}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"
                                            LineBreakMode="TailTruncation"/>

                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout
                                        Spacing="5">

                                        <Label
                                            Text="&#xf073;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}">

                                            <Label.FormattedText>

                                                <FormattedString>

                                                    <Span
                                                        Text="{Binding SelectedProject.StartDateLabel}"/>

                                                    <Span
                                                        Text=" - "/>

                                                    <Span
                                                        Text="{Binding SelectedProject.EndDateLabel}"/>

                                                </FormattedString>

                                            </Label.FormattedText>

                                        </Label>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>



                        <!-- ═══════════════════════════════════════
                             EQUIPMENT OVERVIEW
                             ═══════════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,24,20,0"
                            Spacing="10">


                            <!-- SECTION HEADER -->
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf0ad;"
                                    FontFamily="FontAwesome"
                                    FontSize="15"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="Equipment Overview"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>

                                <HorizontalStackLayout
                                    Grid.Column="2"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf201;"
                                        FontFamily="FontAwesome"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Text="Current status"
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}"/>

                                </HorizontalStackLayout>

                            </Grid>


                            <!-- ROW 1 -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- REQUIRED -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf46d;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding RequiredTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Required"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- BORROWED -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf466;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding BorrowedTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Borrowed"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>


                            <!-- ROW 2 -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- REMAINING -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf252;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding RemainingNeededTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Remaining Needed"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- DAMAGED -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf071;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Red}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding DamagedTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Red}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Damaged / Repair"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>


                            <!-- ROW 3 - LOST -->
                            <Grid
                                ColumnDefinitions="*">


                                <!-- LOST -->
                                <Border
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <!-- SAME QUESTION MARK ICON AS TOOL LIST -->
                                        <Label
                                            Text="&#xf128;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                        <!-- GRAY LOST COUNT -->
                                        <Label
                                            Text="{Binding LostTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text2}"
                                            HorizontalOptions="Center"/>

                                        <!-- GRAY LOST LABEL -->
                                        <Label
                                            Text="Lost"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>



                        <!-- ═══════════════════════════════════════
                             ACTIVITY SUMMARY
                             ═══════════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,24,20,0"
                            Spacing="10">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf201;"
                                    FontFamily="FontAwesome"
                                    FontSize="15"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="Activity Summary"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>

                            </Grid>


                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- TOTAL -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf03a;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding TotalActivities}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Total Activities"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- BORROWS -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf466;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding ProjectBorrows}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Project Borrows"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>


                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- RETURNS -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf2ea;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding WorkerReturns}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Worker Returns"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- CHECK INS -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf14a;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding TotalCheckIns}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Check-Ins"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>



                        <!-- ═══════════════════════════════════════
                             WORKER ACTIVITY
                             ═══════════════════════════════════════ -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8"
                            Padding="20,24,20,10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf0c0;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Blue}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Worker Activity"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <Border
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="0">


                                <!-- MOST ACTIVE WORKER -->
                                <VerticalStackLayout
                                    IsVisible="{Binding HasMostActiveWorker}"
                                    Padding="14"
                                    Spacing="5">

                                    <HorizontalStackLayout
                                        Spacing="6">

                                        <Label
                                            Text="&#xf005;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="{DynamicResource Green}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="Most Active Worker"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"
                                            VerticalOptions="Center"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        Text="{Binding MostActiveWorker.WorkerName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}">

                                        <Label.FormattedText>

                                            <FormattedString>

                                                <Span
                                                    Text="Assignments "/>

                                                <Span
                                                    Text="{Binding MostActiveWorker.AssignmentsAccepted}"
                                                    FontAttributes="Bold"/>

                                                <Span
                                                    Text="  ·  Returns "/>

                                                <Span
                                                    Text="{Binding MostActiveWorker.Returns}"
                                                    FontAttributes="Bold"/>

                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                </VerticalStackLayout>


                                <BoxView
                                    IsVisible="{Binding HasMostActiveWorker}"
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- WORKERS -->
                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding WorkerStats}"
                                    Spacing="0">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:WorkerStatItem">

                                            <VerticalStackLayout
                                                Spacing="0">

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="11"
                                                    Padding="14">


                                                    <!-- USER ICON -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 18"
                                                        BackgroundColor="{DynamicResource BgElevated}"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="&#xf007;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="14"
                                                            TextColor="{DynamicResource Blue}"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"/>

                                                    </Border>


                                                    <!-- DETAILS -->
                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="5"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding WorkerName}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                        <HorizontalStackLayout
                                                            Spacing="10">

                                                            <Label
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Blue}">

                                                                <Label.FormattedText>

                                                                    <FormattedString>

                                                                        <Span
                                                                            Text="Assignments "/>

                                                                        <Span
                                                                            Text="{Binding AssignmentsAccepted}"
                                                                            FontAttributes="Bold"/>

                                                                    </FormattedString>

                                                                </Label.FormattedText>

                                                            </Label>

                                                            <Label
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Green}">

                                                                <Label.FormattedText>

                                                                    <FormattedString>

                                                                        <Span
                                                                            Text="Returns "/>

                                                                        <Span
                                                                            Text="{Binding Returns}"
                                                                            FontAttributes="Bold"/>

                                                                    </FormattedString>

                                                                </Label.FormattedText>

                                                            </Label>

                                                            <Label
                                                                IsVisible="{Binding HasDamages}"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Red}">

                                                                <Label.FormattedText>

                                                                    <FormattedString>

                                                                        <Span
                                                                            Text="Reports "/>

                                                                        <Span
                                                                            Text="{Binding Damages}"
                                                                            FontAttributes="Bold"/>

                                                                    </FormattedString>

                                                                </Label.FormattedText>

                                                            </Label>

                                                        </HorizontalStackLayout>

                                                    </VerticalStackLayout>

                                                </Grid>

                                                <BoxView
                                                    HeightRequest="1"
                                                    Color="{DynamicResource BorderSoft}"
                                                    Margin="14,0"/>

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>



                        <!-- ═══════════════════════════════════════
                             TOOL USAGE
                             ═══════════════════════════════════════ -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8"
                            Padding="20,24,20,10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf0ad;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Blue}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Tool Usage"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <Border
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="0">


                                <!-- MOST USED -->
                                <VerticalStackLayout
                                    IsVisible="{Binding HasMostUsedTool}"
                                    Padding="14"
                                    Spacing="5">

                                    <HorizontalStackLayout
                                        Spacing="6">

                                        <Label
                                            Text="&#xf005;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="{DynamicResource Blue}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="Most Used Tool"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            VerticalOptions="Center"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        Text="{Binding MostUsedTool.ToolName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}">

                                        <Label.FormattedText>

                                            <FormattedString>

                                                <Span
                                                    Text="{Binding MostUsedTool.ToolId}"/>

                                                <Span
                                                    Text="  ·  "/>

                                                <Span
                                                    Text="{Binding MostUsedTool.Usage,
                                                    StringFormat='{0} assignment(s)'}"/>

                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                </VerticalStackLayout>


                                <BoxView
                                    IsVisible="{Binding HasMostUsedTool}"
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- TOOL LIST -->
                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding ToolStats}"
                                    Spacing="0">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate
                                            x:DataType="models:ToolStatItem">

                                            <VerticalStackLayout
                                                Spacing="0">

                                                <Grid
                                                    ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="11"
                                                    Padding="14">


                                                    <!-- TOOL ICON -->
                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf0ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="18"
                                                        TextColor="{DynamicResource Blue}"
                                                        WidthRequest="34"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        VerticalOptions="Center"/>


                                                    <!-- DETAILS -->
                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding ToolName}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                        <Label
                                                            Text="{Binding ToolId}"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <HorizontalStackLayout
                                                            Spacing="10">

                                                            <Label
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Blue}">

                                                                <Label.FormattedText>

                                                                    <FormattedString>

                                                                        <Span
                                                                            Text="Assignments "/>

                                                                        <Span
                                                                            Text="{Binding Usage}"
                                                                            FontAttributes="Bold"/>

                                                                    </FormattedString>

                                                                </Label.FormattedText>

                                                            </Label>

                                                            <Label
                                                                IsVisible="{Binding HasDamages}"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Red}">

                                                                <Label.FormattedText>

                                                                    <FormattedString>

                                                                        <Span
                                                                            Text="Damage Reports "/>

                                                                        <Span
                                                                            Text="{Binding Damages}"
                                                                            FontAttributes="Bold"/>

                                                                    </FormattedString>

                                                                </Label.FormattedText>

                                                            </Label>

                                                        </HorizontalStackLayout>

                                                    </VerticalStackLayout>


                                                    <!-- STATUS -->
                                                    <HorizontalStackLayout
                                                        Grid.Column="2"
                                                        Spacing="4"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="&#xf111;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="6"
                                                            TextColor="{Binding StatusColor}"
                                                            VerticalOptions="Center"/>

                                                        <Label
                                                            Text="{Binding Status}"
                                                            FontSize="9"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding StatusColor}"
                                                            VerticalOptions="Center"/>

                                                    </HorizontalStackLayout>

                                                </Grid>

                                                <BoxView
                                                    HeightRequest="1"
                                                    Color="{DynamicResource BorderSoft}"
                                                    Margin="14,0"/>

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>



                        <!-- ═══════════════════════════════════════
                             DAMAGE REPORT SUMMARY
                             ═══════════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,24,20,0"
                            Spacing="10">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf071;"
                                    FontFamily="FontAwesome"
                                    FontSize="15"
                                    TextColor="{DynamicResource Red}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="Damage Report Summary"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>

                            </Grid>


                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- TOTAL -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf15c;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding TotalReports}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Total Reports"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- PENDING -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf017;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding PendingReports}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Pending"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>


                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- UNDER REPAIR -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf7d9;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding UnderRepairReports}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Under Repair"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- RESOLVED -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf058;"
                                            FontFamily="FontAwesome"
                                            FontSize="16"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding ResolvedReports}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Resolved"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>



                        <!-- ═══════════════════════════════════════
                             REPEATED DAMAGE INSIGHTS
                             ═══════════════════════════════════════ -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8"
                            Padding="20,24,20,10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf06a;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Repeated Damage Insights"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <Border
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="14"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="14">


                                <!-- TOOLS -->
                                <VerticalStackLayout
                                    Spacing="7">

                                    <HorizontalStackLayout
                                        Spacing="6">

                                        <Label
                                            Text="&#xf0ad;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="Tools involved in multiple damage reports"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                    </HorizontalStackLayout>

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding HighRiskTools}"
                                        Spacing="6">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                                                x:DataType="models:ToolRiskItem">

                                                <Label
                                                    Text="{Binding Label}"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Red}"/>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>


                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- WORKERS -->
                                <VerticalStackLayout
                                    Spacing="7">

                                    <HorizontalStackLayout
                                        Spacing="6">

                                        <Label
                                            Text="&#xf0c0;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="Workers involved in multiple damage reports"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                    </HorizontalStackLayout>

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding FrequentlyInvolvedWorkers}"
                                        Spacing="6">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                                                x:DataType="models:WorkerRiskItem">

                                                <Label
                                                    Text="{Binding Label}"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Amber}"/>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         FOOTER
                         ═══════════════════════════════════════ -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,30,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Project Analytics"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.ProjectAnalyticsView"
    x:DataType="vm:ProjectAnalyticsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- HEADER -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <Button
                            Grid.Column="0"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="17"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Project Analytics"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Performance and usage insights"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="{Binding ThemeIcon}"
                            FontFamily="FontAwesome"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                        <Button
                            Grid.Column="3"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>


                    <!-- INTRO -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            Text="Project Insights"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Monitor equipment activity, worker usage and project performance."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- PROJECT PICKER -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="8">

                        <Label
                            Text="Select Project"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Border
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource InputBg}"
                            HeightRequest="50">

                            <Grid ColumnDefinitions="Auto,*">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf07c;"
                                    FontFamily="FontAwesome"
                                    FontSize="15"
                                    TextColor="{DynamicResource Text3}"
                                    Margin="14,0,0,0"
                                    VerticalOptions="Center"/>

                                <Picker
                                    Grid.Column="1"
                                    ItemsSource="{Binding Projects}"
                                    SelectedItem="{Binding SelectedProject}"
                                    ItemDisplayBinding="{Binding ProjectName}"
                                    Title="Select a project..."
                                    TitleColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    FontSize="14"
                                    Margin="8,0"
                                    BackgroundColor="Transparent"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- LOADING -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,20"/>


                    <!-- EMPTY -->

                    <Border
                        IsVisible="{Binding IsIdle}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource BgCard}"
                        Padding="30"
                        Margin="20,20,20,0">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="&#xf080;"
                                FontFamily="FontAwesome"
                                FontSize="28"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No Project Selected"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Select a project to view its analytics."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ANALYTICS -->

                    <VerticalStackLayout
                        IsVisible="{Binding HasSelectedProject}"
                        Spacing="0">


                        <!-- PROJECT -->

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="16"
                            Margin="20,18,20,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="13">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf080;"
                                    FontFamily="FontAwesome"
                                    FontSize="20"
                                    TextColor="{DynamicResource Blue}"
                                    WidthRequest="34"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="Selected Project"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Text="{Binding SelectedProject.ProjectName}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <HorizontalStackLayout Spacing="6">

                                        <Label
                                            Text="&#xf3c5;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="{Binding SelectedProject.Location}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding SelectedProject.StartDateLabel}"/>
                                                <Span Text="  -  "/>
                                                <Span Text="{Binding SelectedProject.EndDateLabel}"/>
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- TOOL OVERVIEW TITLE -->

                        <Label
                            Text="Tool Overview"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            Margin="20,24,20,10"/>


                        <!-- TOOL ROW 1 -->

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8"
                            Margin="20,0">

                            <!-- TOTAL -->
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,12">

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalTools}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- AVAILABLE -->
                            <Border
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,12">

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="&#xf00c;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding AvailableTools}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Available"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- BORROWED -->
                            <Border
                                Grid.Column="2"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,12">

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="&#xf49e;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding BorrowedTools}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Borrowed"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>


                        <!-- TOOL ROW 2 -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8"
                            Margin="20,8,20,0">

                            <!-- DAMAGED -->
                            <Border
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf071;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Red}"
                                        WidthRequest="30"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1">

                                        <Label
                                            Text="{Binding DamagedTools}"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Red}"/>

                                        <Label
                                            Text="Damaged"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>


                            <!-- LOST -->
                            <Border
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf1f8;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Red}"
                                        WidthRequest="30"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1">

                                        <Label
                                            Text="{Binding LostTools}"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Red}"/>

                                        <Label
                                            Text="Lost"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </Grid>


                        <!-- TRANSACTION SUMMARY -->

                        <Label
                            Text="Transaction Summary"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            Margin="20,24,20,10"/>

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,14"
                            Margin="20,0">

                            <Grid ColumnDefinitions="*,*,*,*">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding TotalTransactions}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding TotalBorrows}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Borrows"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding TotalReturns}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Returns"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="3"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding TotalTransfers}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Transfers"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- WORKER PERFORMANCE -->

                        <Label
                            Text="Worker Performance"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            Margin="20,24,20,10"/>

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Margin="20,0">

                            <VerticalStackLayout Spacing="0">

                                <!-- MOST ACTIVE -->
                                <VerticalStackLayout
                                    IsVisible="{Binding HasMostActiveWorker}"
                                    Padding="16,14"
                                    Spacing="5">

                                    <HorizontalStackLayout Spacing="6">

                                        <Label
                                            Text="&#xf091;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="{DynamicResource Green}"/>

                                        <Label
                                            Text="Most Active Worker"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        Text="{Binding MostActiveWorker.WorkerName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Borrows: "/>
                                                <Span Text="{Binding MostActiveWorker.Borrows}"
                                                      FontAttributes="Bold"/>
                                                <Span Text="  ·  Transfers: "/>
                                                <Span Text="{Binding MostActiveWorker.TransfersReceived}"
                                                      FontAttributes="Bold"/>
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </VerticalStackLayout>

                                <BoxView
                                    IsVisible="{Binding HasMostActiveWorker}"
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding WorkerStats}"
                                    Spacing="0">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate x:DataType="models:WorkerStatItem">

                                            <VerticalStackLayout Spacing="0">

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="11"
                                                    Padding="14">

                                                    <Border
                                                        Grid.Column="0"
                                                        BackgroundColor="{DynamicResource Blue}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 18"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding WorkerInitials}"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            TextColor="White"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"/>

                                                    </Border>

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="5">

                                                        <Label
                                                            Text="{Binding WorkerName}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                        <HorizontalStackLayout Spacing="10">

                                                            <Label
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Blue}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Borrows "/>
                                                                        <Span Text="{Binding Borrows}"
                                                                              FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                            <Label
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Text2}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Transfers "/>
                                                                        <Span Text="{Binding TransfersReceived}"
                                                                              FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                            <Label
                                                                IsVisible="{Binding HasDamages}"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Red}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Reports "/>
                                                                        <Span Text="{Binding Damages}"
                                                                              FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                        </HorizontalStackLayout>

                                                    </VerticalStackLayout>

                                                </Grid>

                                                <BoxView
                                                    HeightRequest="1"
                                                    Color="{DynamicResource BorderSoft}"
                                                    Margin="14,0"/>

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>


                        <!-- TOOL USAGE -->

                        <Label
                            Text="Tool Usage"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            Margin="20,24,20,10"/>

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Margin="20,0">

                            <VerticalStackLayout Spacing="0">

                                <VerticalStackLayout
                                    IsVisible="{Binding HasMostUsedTool}"
                                    Padding="16,14"
                                    Spacing="4">

                                    <HorizontalStackLayout Spacing="6">

                                        <Label
                                            Text="&#xf091;"
                                            FontFamily="FontAwesome"
                                            FontSize="10"
                                            TextColor="{DynamicResource Blue}"/>

                                        <Label
                                            Text="Most Used Tool"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"/>

                                    </HorizontalStackLayout>

                                    <Label
                                        Text="{Binding MostUsedTool.ToolName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding MostUsedTool.ToolId}"/>
                                                <Span Text="  ·  "/>
                                                <Span Text="{Binding MostUsedTool.Usage,
                                                    StringFormat='{0} borrows'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </VerticalStackLayout>

                                <BoxView
                                    IsVisible="{Binding HasMostUsedTool}"
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding ToolStats}"
                                    Spacing="0">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate x:DataType="models:ToolStatItem">

                                            <VerticalStackLayout Spacing="0">

                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="10"
                                                    Padding="14">

                                                    <VerticalStackLayout
                                                        Grid.Column="0"
                                                        Spacing="3">

                                                        <Label
                                                            Text="{Binding ToolName}"
                                                            FontSize="13"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                        <Label
                                                            Text="{Binding ToolId}"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <HorizontalStackLayout Spacing="10">

                                                            <Label
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Blue}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Borrows "/>
                                                                        <Span Text="{Binding Usage}"
                                                                              FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                            <Label
                                                                IsVisible="{Binding HasDamages}"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Red}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Reports "/>
                                                                        <Span Text="{Binding Damages}"
                                                                              FontAttributes="Bold"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                        </HorizontalStackLayout>

                                                    </VerticalStackLayout>

                                                    <Border
                                                        Grid.Column="1"
                                                        BackgroundColor="{DynamicResource BgElevated}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="8,4"
                                                        VerticalOptions="Center">

                                                        <Label
                                                            Text="{Binding Status}"
                                                            FontSize="9"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding StatusColor}"/>

                                                    </Border>

                                                </Grid>

                                                <BoxView
                                                    HeightRequest="1"
                                                    Color="{DynamicResource BorderSoft}"
                                                    Margin="14,0"/>

                                            </VerticalStackLayout>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>


                        <!-- DAMAGE SUMMARY -->

                        <Label
                            Text="Damage Report Summary"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            Margin="20,24,20,10"/>

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="16"
                            Margin="20,0">

                            <Grid ColumnDefinitions="*,*,*">

                                <VerticalStackLayout Grid.Column="0">

                                    <Label
                                        Text="{Binding TotalReports}"
                                        FontSize="23"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1">

                                    <Label
                                        Text="{Binding PendingReports}"
                                        FontSize="23"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Pending"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2">

                                    <Label
                                        Text="{Binding ResolvedReports}"
                                        FontSize="23"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Resolved"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- RISK -->

                        <Label
                            Text="Risk Insights"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            Margin="20,24,20,10"/>

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="16"
                            Margin="20,0">

                            <VerticalStackLayout Spacing="14">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="9">

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf24e;"
                                        FontFamily="FontAwesome"
                                        FontSize="13"
                                        TextColor="{DynamicResource Text3}"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="1"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text2}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding DisputedReports}"
                                                      FontAttributes="Bold"/>
                                                <Span Text=" report(s) currently disputed"/>
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </Grid>


                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- HIGH RISK TOOLS -->

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Tools involved in multiple reports"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text3}"/>

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding HighRiskTools}"
                                        Spacing="6">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate x:DataType="models:ToolRiskItem">

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf071;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Red}"/>

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Label}"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource Red}"/>

                                                </Grid>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>


                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- WORKERS -->

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Workers involved in multiple reports"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text3}"/>

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding FrequentlyInvolvedWorkers}"
                                        Spacing="6">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate x:DataType="models:WorkerRiskItem">

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf007;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Amber}"/>

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Label}"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource Amber}"/>

                                                </Grid>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>


                    <!-- FOOTER -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,30,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"/>

                        <Label
                            Text="StockGuard · Project Analytics"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
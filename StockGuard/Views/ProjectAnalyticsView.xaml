<?xml version="1.0" encoding="utf-8" ?>
<!--
    Built from the web analytics page (/Analytics/Index).
    Web sections translated to MAUI:

    Web                          → MAUI
    ─────────────────────────────────────────────────────
    Project selector dropdown    → Picker bound to Projects
    "No project selected" card   → IsIdle empty state
    Project header banner        → Blue info card
    Tool Overview (4 stats)      → 2×2 Grid of stat cards
    Transaction Summary (4)      → 2×2 Grid of stat cards
    Worker Performance table     → Cards with most-active highlight
    Tool Usage table             → Cards with most-used highlight
    Damage Report Summary        → 3-col stat row

    ViewModel bindings expected (ProjectAnalyticsViewModel):
    - Projects                   ObservableCollection<Project>
    - SelectedProject            Project?
    - HasSelectedProject         bool
    - IsIdle                     bool  (!IsBusy && SelectedProject == null)
    - ProjectName/Location/etc   string
    - TotalTools/Available/Damaged/LostTools  int
    - TotalTransactions/Borrows/Returns/Transfers  int
    - WorkerStats                ObservableCollection<WorkerStatItem>
    - MostActiveWorker           WorkerStatItem?
    - HasMostActiveWorker        bool
    - ToolStats                  ObservableCollection<ToolStatItem>
    - MostUsedTool               ToolStatItem?
    - HasMostUsedTool            bool
    - TotalReports/Pending/Resolved  int
    - RefreshCommand / ToggleThemeCommand
    - ThemeIcon                  string
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             x:Class="StockGuard.Views.ProjectAnalyticsView"
             x:DataType="vm:ProjectAnalyticsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                    <!-- ── HEADER ──────────────────────────── -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="10"
                          Padding="20,52,20,16"
                          BackgroundColor="{DynamicResource BgSurface}">

                        <Button Grid.Column="0"
                                Text="☰"
                                Command="{Binding OpenFlyoutCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="18" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center" Spacing="1">
                            <Label Text="📊  Project Analytics"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>
                            <Label Text="Performance and usage insights"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="{Binding ThemeIcon}"
                                Command="{Binding ToggleThemeCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>

                        <Button Grid.Column="3"
                                Text="🔄"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>
                    </Grid>

                    <!-- ── PROJECT PICKER ──────────────────── -->
                    <!-- Matches the web's <select name="projectId"> -->
                    <Frame Padding="0" CornerRadius="12"
                           HasShadow="False"
                           BorderColor="{DynamicResource InputBorder}"
                           BackgroundColor="{DynamicResource InputBg}"
                           HeightRequest="50"
                           Margin="20,16,20,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Text="📁" FontSize="16"
                                   Margin="14,0,0,0"
                                   VerticalOptions="Center"/>
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding Projects}"
                                    SelectedItem="{Binding SelectedProject}"
                                    ItemDisplayBinding="{Binding ProjectName}"
                                    Title="Select a project..."
                                    TitleColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    FontSize="14"
                                    Margin="8,0"
                                    BackgroundColor="Transparent"/>
                        </Grid>
                    </Frame>

                    <!-- ── LOADING ─────────────────────────── -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,20"/>

                    <!-- ── IDLE STATE (no project selected) ── -->
                    <!-- Matches web: "Select a project to view analytics" -->
                    <VerticalStackLayout IsVisible="{Binding IsIdle}"
                                         Padding="40,40" Spacing="12"
                                         HorizontalOptions="Center">
                        <Label Text="📊" FontSize="64"
                               HorizontalOptions="Center"/>
                        <Label Text="No Project Selected"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               HorizontalOptions="Center"/>
                        <Label Text="Select a project above to view analytics"
                               FontSize="13"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- ══════════════════════════════════════
                         ANALYTICS CONTENT
                         All sections IsVisible="{Binding HasSelectedProject}"
                    ══════════════════════════════════════════ -->
                    <VerticalStackLayout IsVisible="{Binding HasSelectedProject}"
                                         Spacing="0">

                        <!-- ── PROJECT BANNER ──────────────── -->
                        <!-- Matches web's active-project-banner -->
                        <Frame BackgroundColor="#1d4ed8"
                               BorderColor="Transparent"
                               CornerRadius="16" Padding="20"
                               HasShadow="False"
                               Margin="20,16,20,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Label Grid.Column="0"
                                       Text="📊" FontSize="28"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Analytics Report"
                                           FontSize="11" TextColor="#93c5fd"/>
                                    <Label Text="{Binding SelectedProject.ProjectName}"
                                           FontSize="18" FontAttributes="Bold"
                                           TextColor="White"/>
                                    <Label FontSize="12" TextColor="#bfdbfe">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="📍 "/>
                                                <Span Text="{Binding SelectedProject.Location}"/>
                                                <Span Text="  ·  "/>
                                                <Span Text="{Binding SelectedProject.StartDateLabel}"/>
                                                <Span Text=" → "/>
                                                <Span Text="{Binding SelectedProject.EndDateLabel}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding SelectedProject.DurationLabel}"
                                           FontSize="11" TextColor="#93c5fd"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>

                        <!-- ── TOOL OVERVIEW ───────────────── -->
                        <Label Text="🔧  Tool Overview"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               Margin="20,20,20,10"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10" RowSpacing="10"
                              Padding="20,0">

                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="🔧" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Total Tools" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="✅" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding AvailableTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Available" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="⚠️" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding DamagedTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Damaged" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="❌" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding LostTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Red}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Lost" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- ── TRANSACTION SUMMARY ─────────── -->
                        <Label Text="📋  Transaction Summary"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               Margin="20,20,20,10"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10" RowSpacing="10"
                              Padding="20,0">

                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="📋" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTransactions}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Total" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="📦" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalBorrows}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Borrows" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="↩️" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalReturns}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Returns" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="14,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="🔄" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTransfers}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Transfers" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- ── WORKER PERFORMANCE ──────────── -->
                        <Label Text="👷  Worker Performance"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               Margin="20,20,20,10"/>

                        <Frame BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="16" Padding="0"
                               HasShadow="False" Margin="20,0">
                            <VerticalStackLayout Spacing="0">

                                <!-- Most active highlight -->
                                <Frame IsVisible="{Binding HasMostActiveWorker}"
                                       BackgroundColor="#0a2a1e"
                                       BorderColor="Transparent"
                                       CornerRadius="0" Padding="16,12"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="🏆  Most Active Worker"
                                               FontSize="11" TextColor="#10b981"/>
                                        <Label Text="{Binding MostActiveWorker.WorkerName}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource Text1}"/>
                                        <Label Text="{Binding MostActiveWorker.Borrows, StringFormat='{0} borrows'}"
                                               FontSize="12"
                                               TextColor="{DynamicResource Text3}"/>
                                    </VerticalStackLayout>
                                </Frame>

                                <BoxView IsVisible="{Binding HasMostActiveWorker}"
                                         HeightRequest="1"
                                         Color="{DynamicResource BorderSoft}"/>

                                <!-- Worker rows -->
                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding WorkerStats}"
                                    Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:WorkerStatItem">
                                            <VerticalStackLayout Spacing="0">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                      Padding="16,12" ColumnSpacing="12">

                                                    <Frame Grid.Column="0"
                                                           BackgroundColor="#1d4ed8"
                                                           CornerRadius="18"
                                                           WidthRequest="36" HeightRequest="36"
                                                           Padding="0" HasShadow="False"
                                                           BorderColor="Transparent"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding WorkerInitials}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Frame>

                                                    <Label Grid.Column="1"
                                                           Text="{Binding WorkerName}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{DynamicResource Text1}"
                                                           VerticalOptions="Center"/>

                                                    <!-- Borrows badge -->
                                                    <Frame Grid.Column="2"
                                                           BackgroundColor="{DynamicResource BlueSubtle}"
                                                           BorderColor="Transparent"
                                                           CornerRadius="8" Padding="8,4"
                                                           HasShadow="False"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding Borrows, StringFormat='📦 {0}'}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{DynamicResource Blue}"/>
                                                    </Frame>

                                                    <!-- Damages badge -->
                                                    <Frame Grid.Column="3"
                                                           BackgroundColor="{DynamicResource RedBg}"
                                                           BorderColor="Transparent"
                                                           CornerRadius="8" Padding="8,4"
                                                           HasShadow="False"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding HasDamages}">
                                                        <Label Text="{Binding Damages, StringFormat='⚠️ {0}'}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{DynamicResource Red}"/>
                                                    </Frame>
                                                </Grid>
                                                <BoxView HeightRequest="1"
                                                         Color="{DynamicResource BorderSoft}"
                                                         Margin="16,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>

                        <!-- ── TOOL USAGE ───────────────────── -->
                        <Label Text="🔧  Tool Usage"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               Margin="20,20,20,10"/>

                        <Frame BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="16" Padding="0"
                               HasShadow="False" Margin="20,0">
                            <VerticalStackLayout Spacing="0">

                                <!-- Most used highlight -->
                                <Frame IsVisible="{Binding HasMostUsedTool}"
                                       BackgroundColor="#0f1c35"
                                       BorderColor="Transparent"
                                       CornerRadius="0" Padding="16,12"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="🏆  Most Used Tool"
                                               FontSize="11"
                                               TextColor="{DynamicResource Blue}"/>
                                        <Label Text="{Binding MostUsedTool.ToolName}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource Text1}"/>
                                        <Label FontSize="12"
                                               TextColor="{DynamicResource Text3}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding MostUsedTool.ToolId}"/>
                                                    <Span Text="  ·  "/>
                                                    <Span Text="{Binding MostUsedTool.Usage, StringFormat='{0} times borrowed'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Frame>

                                <BoxView IsVisible="{Binding HasMostUsedTool}"
                                         HeightRequest="1"
                                         Color="{DynamicResource BorderSoft}"/>

                                <!-- Tool rows -->
                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding ToolStats}"
                                    Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ToolStatItem">
                                            <VerticalStackLayout Spacing="0">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                      Padding="16,12" ColumnSpacing="8">

                                                    <VerticalStackLayout Grid.Column="0"
                                                        Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding ToolName}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="{DynamicResource Text1}"/>
                                                        <Label Text="{Binding ToolId}"
                                                               FontSize="11"
                                                               TextColor="{DynamicResource Blue}"/>
                                                    </VerticalStackLayout>

                                                    <!-- Usage badge -->
                                                    <Frame Grid.Column="1"
                                                           BackgroundColor="{DynamicResource BlueSubtle}"
                                                           BorderColor="Transparent"
                                                           CornerRadius="8" Padding="8,4"
                                                           HasShadow="False"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding Usage, StringFormat='📦 {0}'}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{DynamicResource Blue}"/>
                                                    </Frame>

                                                    <!-- Damage badge -->
                                                    <Frame Grid.Column="2"
                                                           BackgroundColor="{DynamicResource RedBg}"
                                                           BorderColor="Transparent"
                                                           CornerRadius="8" Padding="8,4"
                                                           HasShadow="False"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding HasDamages}">
                                                        <Label Text="{Binding Damages, StringFormat='⚠️ {0}'}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{DynamicResource Red}"/>
                                                    </Frame>

                                                    <!-- Status badge -->
                                                    <Frame Grid.Column="3"
                                                           BackgroundColor="{DynamicResource BgElevated}"
                                                           BorderColor="Transparent"
                                                           CornerRadius="8" Padding="8,4"
                                                           HasShadow="False"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding Status}"
                                                               FontSize="10" FontAttributes="Bold"
                                                               TextColor="{Binding StatusColor}"/>
                                                    </Frame>
                                                </Grid>
                                                <BoxView HeightRequest="1"
                                                         Color="{DynamicResource BorderSoft}"
                                                         Margin="16,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>

                        <!-- ── DAMAGE REPORT SUMMARY ────────── -->
                        <Label Text="⚠️  Damage Report Summary"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               Margin="20,20,20,10"/>

                        <Frame BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="16" Padding="0"
                               HasShadow="False" Margin="20,0">
                            <Grid ColumnDefinitions="*,*,*" Padding="16">

                                <VerticalStackLayout Grid.Column="0"
                                    Spacing="4" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalReports}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Total" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                    Spacing="4" HorizontalOptions="Center">
                                    <Label Text="{Binding PendingReports}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Pending" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2"
                                    Spacing="4" HorizontalOptions="Center">
                                    <Label Text="{Binding ResolvedReports}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Resolved" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                            </Grid>
                        </Frame>
                        <!-- ── RISK INSIGHTS ─────────────────────────────── -->
                        <Label Text="🔍  Risk Insights"
       FontSize="15" FontAttributes="Bold"
       TextColor="{DynamicResource Text1}"
       Margin="20,20,20,10"/>

                        <Frame BackgroundColor="{DynamicResource BgCard}"
       BorderColor="{DynamicResource BorderColor}"
       CornerRadius="16" Padding="16"
       HasShadow="False" Margin="20,0">
                            <VerticalStackLayout Spacing="12">

                                <!-- Disputed count -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="⚖️" FontSize="14"/>
                                    <Label FontSize="13" TextColor="{DynamicResource Text2}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding DisputedReports}" FontAttributes="Bold"/>
                                                <Span Text=" report(s) currently disputed"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>

                                <!-- High-risk tools list -->
                                <Label Text="High-risk tools (2+ incidents):"
           FontSize="11" FontAttributes="Bold"
           TextColor="{DynamicResource Text3}"/>
                                <VerticalStackLayout
        BindableLayout.ItemsSource="{Binding HighRiskTools}"
        Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ToolRiskItem">
                                            <Label Text="{Binding Label}" FontSize="12"
                 TextColor="{DynamicResource Red}"/>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Frequently involved workers list -->
                                <Label Text="Workers frequently in reports (2+):"
           FontSize="11" FontAttributes="Bold"
           TextColor="{DynamicResource Text3}"/>
                                <VerticalStackLayout
        BindableLayout.ItemsSource="{Binding FrequentlyInvolvedWorkers}"
        Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:WorkerRiskItem">
                                            <Label Text="{Binding Label}" FontSize="12"
                 TextColor="{DynamicResource Amber}"/>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                    <!-- end HasSelectedProject section -->

                    <Label Text="© 2025 StockGuard" FontSize="10"
                           TextColor="{DynamicResource Text3}"
                           HorizontalOptions="Center"
                           Margin="0,20,0,0"/>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>

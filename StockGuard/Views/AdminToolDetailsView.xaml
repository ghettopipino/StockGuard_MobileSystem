<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.AdminToolDetailsView"
    x:DataType="vm:AdminToolDetailsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Spacing="0"
                Padding="0,0,0,40">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10"
                    Padding="20,52,20,16"
                    BackgroundColor="{DynamicResource BgSurface}">

                    <!-- BACK -->

                    <Button
                        Grid.Column="0"
                        Text="&#xf060;"
                        FontFamily="FontAwesome"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Text2}"
                        FontSize="16"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"/>


                    <!-- TITLE -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="1">

                        <Label
                            Text="Tool Details"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Project Engineer view"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- REFRESH -->

                    <Button
                        Grid.Column="2"
                        Text="&#xf2f1;"
                        FontFamily="FontAwesome"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Text2}"
                        FontSize="15"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"/>

                </Grid>


                <!-- ================================================= -->
                <!-- LOADING -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding IsLoading}"
                    Padding="40"
                    Spacing="14"
                    HorizontalOptions="Center">

                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Loading tool details..."
                        FontSize="12"
                        TextColor="{DynamicResource Text3}"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- NOT FOUND -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding ToolNotFound}"
                    BackgroundColor="{DynamicResource BgCard}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 14"
                    Padding="24"
                    Margin="20">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Label
                            Text="&#xf128;"
                            FontFamily="FontAwesome"
                            FontSize="26"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Tool Not Found"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="This QR code does not match equipment in the system."
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"/>

                        <Button
                            Text="Go Back"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"
                            Padding="20,0"
                            Margin="0,8,0,0"/>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- CONTENT -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding IsNotLoading}"
                    Padding="20,16"
                    Spacing="14">


                    <!-- ================================================= -->
                    <!-- TOOL CARD -->
                    <!-- ================================================= -->

                    <Border
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 16"
                        Padding="18">

                        <VerticalStackLayout Spacing="16">


                            <!-- TOOL HEADER -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="14">


                                <!-- TOOL ICON -->

                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    WidthRequest="58"
                                    HeightRequest="58"
                                    StrokeShape="RoundRectangle 14"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="24"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Border>


                                <!-- TOOL IDENTITY -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding ToolName}"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        LineBreakMode="TailTruncation"/>

                                    <Label
                                        Text="{Binding ToolIdDisplay}"
                                        FontSize="12"
                                        TextColor="{DynamicResource Text3}"/>


                                    <!-- STATUS -->

                                    <Border
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="9,4"
                                        HorizontalOptions="Start">

                                        <Label
                                            Text="{Binding StatusText}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text2}"/>

                                    </Border>

                                </VerticalStackLayout>

                            </Grid>


                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource BorderSoft}"/>


                            <!-- ================================================= -->
                            <!-- MAIN DETAILS -->
                            <!-- ================================================= -->

                            <Grid
                                ColumnDefinitions="100,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="11">


                                <!-- CATALOG -->

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Catalog"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding CatalogName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    LineBreakMode="TailTruncation"/>


                                <!-- CONDITION -->

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Condition"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding ConditionText}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>


                                <!-- WORKER -->

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Worker"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding AssignedWorkerName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    LineBreakMode="TailTruncation"/>


                                <!-- PROJECT -->

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Project"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding ProjectName}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"
                                    LineBreakMode="TailTruncation"/>


                                <!-- ASSIGNED BY -->

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="Assigned by"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding AssignedByName}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"
                                    LineBreakMode="TailTruncation"/>


                                <!-- BORROWED -->

                                <Label
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Text="Borrowed"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="{Binding BorrowDateDisplay}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================= -->
                    <!-- END-DAY CHECK-IN -->
                    <!-- ================================================= -->

                    <Border
                        IsVisible="{Binding HasCheckInInfo}"
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">


                            <!-- HEADER -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf017;"
                                    FontFamily="FontAwesome"
                                    FontSize="13"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="Latest End-Day Check-In"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>

                            </Grid>


                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource BorderSoft}"/>


                            <!-- DETAILS -->

                            <Grid
                                ColumnDefinitions="90,*"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="9">


                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Location"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding CheckInLocation}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>


                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Checked in"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding CheckInDateDisplay}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>


                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Verified by"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding CheckInVerifiedBy}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================= -->
                    <!-- STATUS NOTICES -->
                    <!-- ================================================= -->


                    <!-- RETURN PENDING -->

                    <Border
                        IsVisible="{Binding IsPendingReturn}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        Stroke="{DynamicResource Amber}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="9">

                            <Label
                                Grid.Column="0"
                                Text="&#xf017;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="Return is pending Project Engineer inspection."
                                FontSize="12"
                                TextColor="{DynamicResource Amber}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- DAMAGED -->

                    <Border
                        IsVisible="{Binding IsDamaged}"
                        BackgroundColor="{DynamicResource RedBg}"
                        Stroke="{DynamicResource Red}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="9">

                            <Label
                                Grid.Column="0"
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="This equipment is marked as damaged. Review Damage Reports for handling."
                                FontSize="12"
                                TextColor="{DynamicResource Red}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- UNDER REPAIR -->

                    <Border
                        IsVisible="{Binding IsUnderRepair}"
                        BackgroundColor="{DynamicResource BlueSubtle}"
                        Stroke="{DynamicResource Blue}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="9">

                            <Label
                                Grid.Column="0"
                                Text="&#xf7d9;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Blue}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="This equipment is currently under repair."
                                FontSize="12"
                                TextColor="{DynamicResource Blue}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- LOST -->

                    <Border
                        IsVisible="{Binding IsLost}"
                        BackgroundColor="{DynamicResource RedBg}"
                        Stroke="{DynamicResource Red}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="9">

                            <Label
                                Grid.Column="0"
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="This equipment has been marked as lost."
                                FontSize="12"
                                TextColor="{DynamicResource Red}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- AVAILABLE -->

                    <Border
                        IsVisible="{Binding IsAvailable}"
                        BackgroundColor="{DynamicResource GreenBg}"
                        Stroke="{DynamicResource Green}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="9">

                            <Label
                                Grid.Column="0"
                                Text="&#xf058;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Green}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="This equipment is currently available."
                                FontSize="12"
                                TextColor="{DynamicResource Green}"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- TRANSACTION HISTORY -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        Spacing="2"
                        Margin="0,8,0,0">

                        <Label
                            Text="Transaction History"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Audit trail for this equipment"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- NO HISTORY -->
                    <!-- ================================================= -->

                    <Border
                        IsVisible="{Binding NoTransactions}"
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        Padding="24">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="&#xf1da;"
                                FontFamily="FontAwesome"
                                FontSize="20"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No transactions yet"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Equipment activity will appear here."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================= -->
                    <!-- TRANSACTION CARDS -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Transactions}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:TransactionLog">

                                <Border
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">

                                    <VerticalStackLayout Spacing="10">


                                        <!-- HEADER -->

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="10">


                                            <!-- ACTION ICON -->

                                            <Border
                                                Grid.Column="0"
                                                BackgroundColor="Transparent"
                                                Stroke="Transparent"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeShape="RoundRectangle 9"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="&#xf1da;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="15"
                                                    TextColor="{DynamicResource Blue}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>

                                            </Border>


                                            <!-- ACTION -->

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="2"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Action}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"
                                                    LineBreakMode="TailTruncation"/>

                                                <Label
                                                    Text="{Binding FullDateLabel}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"/>

                                            </VerticalStackLayout>


                                            <!-- CONDITION -->

                                            <Border
                                                Grid.Column="2"
                                                BackgroundColor="{DynamicResource BgElevated}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Condition}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text2}"/>

                                            </Border>

                                        </Grid>


                                        <!-- DESCRIPTION -->

                                        <Label
                                            Text="{Binding Description}"
                                            FontSize="11"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource Text2}"/>


                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <!-- ACCOUNTABILITY -->

                                        <Grid
                                            ColumnDefinitions="75,*"
                                            RowDefinitions="Auto,Auto,Auto"
                                            ColumnSpacing="10"
                                            RowSpacing="6">


                                            <!-- WORKER -->

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Text="Worker"
                                                FontSize="10"
                                                TextColor="{DynamicResource Text3}"/>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="{Binding WorkerDisplay}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text2}"
                                                LineBreakMode="TailTruncation"/>


                                            <!-- PROJECT -->

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Text="Project"
                                                FontSize="10"
                                                TextColor="{DynamicResource Text3}"/>

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding ProjectDisplay}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text2}"
                                                LineBreakMode="TailTruncation"/>


                                            <!-- ACTION BY -->

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Text="Action by"
                                                FontSize="10"
                                                TextColor="{DynamicResource Text3}"/>

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="{Binding PerformedByDisplay}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"
                                                LineBreakMode="TailTruncation"/>

                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- FOOTER -->
                    <!-- ================================================= -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,18,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Equipment Audit"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<!--
    Admin-facing read-only tool detail page.
    Reached by scanning a QR code as a Project Engineer.

    Shows:
      ✅ Tool identity (name, ID, icon, status, condition, catalog)
      ✅ Current borrower info (visible only when borrowed)
      ✅ Full transaction history / audit trail for this tool

    No action buttons — this is intentionally read-only.
    Admins take action through the sidebar pages (Damage Reports,
    Pause Requests, Worker Management).

    Navigation: ← back → GoBackCommand (GoToAsync(".."))
    This is a registered detail route, NOT a FlyoutItem,
    so GoToAsync("..") correctly pops back to PEDashboardView.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             x:Class="StockGuard.Views.AdminToolDetailsView"
             x:DataType="vm:AdminToolDetailsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                <!-- ── HEADER ──────────────────────────────── -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="10"
                      Padding="20,52,20,16"
                      BackgroundColor="{DynamicResource BgSurface}">

                    <Button Grid.Column="0"
                            Text="←"
                            Command="{Binding GoBackCommand}"
                            Clicked="OnBackClicked"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="18" CornerRadius="8"
                            WidthRequest="40" HeightRequest="36"
                            Padding="0"/>

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="1">
                        <Label Text="Tool Details"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"/>
                        <Label Text="Admin view — read only"
                               FontSize="11"
                               TextColor="{DynamicResource Text3}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="{Binding ThemeIcon}"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16" CornerRadius="8"
                            WidthRequest="40" HeightRequest="36"
                            Padding="0"/>

                    <Button Grid.Column="3"
                            Text="🔄"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16" CornerRadius="8"
                            WidthRequest="40" HeightRequest="36"
                            Padding="0"/>
                </Grid>

                <!-- ── LOADING ─────────────────────────────── -->
                <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                     Padding="40" Spacing="16"
                                     HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="{DynamicResource Blue}"
                                       HorizontalOptions="Center"/>
                    <Label Text="Loading tool details..."
                           FontSize="13"
                           TextColor="{DynamicResource Text3}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- ── TOOL NOT FOUND ──────────────────────── -->
                <Frame IsVisible="{Binding ToolNotFound}"
                       BackgroundColor="{DynamicResource BgCard}"
                       BorderColor="{DynamicResource BorderColor}"
                       CornerRadius="14" Padding="24"
                       HasShadow="False" Margin="20,20">
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center">
                        <Label Text="❓" FontSize="48"
                               HorizontalOptions="Center"/>
                        <Label Text="Tool Not Found"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               HorizontalOptions="Center"/>
                        <Label Text="This QR code does not match any tool in the system."
                               FontSize="13"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="← Go Back"
                                Command="{Binding GoBackCommand}"
                                BackgroundColor="{DynamicResource Blue}"
                                TextColor="White"
                                CornerRadius="8" HeightRequest="44"
                                Margin="0,8,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ── TOOL IDENTITY CARD ──────────────────── -->
                <VerticalStackLayout IsVisible="{Binding IsNotLoading}"
                                     Padding="20,16" Spacing="14">

                    <Frame BackgroundColor="{DynamicResource BgCard}"
                           BorderColor="{DynamicResource BorderColor}"
                           CornerRadius="16" Padding="0"
                           HasShadow="False">
                        <VerticalStackLayout Padding="20" Spacing="16">

                            <!-- Icon + Name + Status -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16">
                                <Frame Grid.Column="0"
                                       BackgroundColor="{DynamicResource BlueSubtle}"
                                       CornerRadius="16"
                                       WidthRequest="64" HeightRequest="64"
                                       Padding="0" HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding ToolIcon}"
                                           FontSize="32"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1"
                                    VerticalOptions="Center" Spacing="6">
                                    <Label Text="{Binding ToolName}"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="{DynamicResource Text1}"/>
                                    <Label Text="{Binding ToolIdDisplay}"
                                           FontSize="13"
                                           TextColor="{DynamicResource Text3}"/>
                                    <Frame BackgroundColor="{DynamicResource BgElevated}"
                                           BorderColor="Transparent"
                                           CornerRadius="8" Padding="10,4"
                                           HasShadow="False"
                                           HorizontalOptions="Start">
                                        <Label TextColor="{DynamicResource Text1}"
                                               FontSize="12" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding StatusIcon}"/>
                                                    <Span Text=" "/>
                                                    <Span Text="{Binding StatusText}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Frame>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{DynamicResource BorderSoft}"/>

                            <!-- Info grid -->
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="14">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="📦 Catalog" FontSize="12"
                                       TextColor="{DynamicResource Text3}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CatalogName}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"
                                       VerticalOptions="Center"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="🔍 Condition" FontSize="12"
                                       TextColor="{DynamicResource Text3}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding ConditionText}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"
                                       VerticalOptions="Center"/>

                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="👷 Assigned To" FontSize="12"
                                       TextColor="{DynamicResource Text3}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding AssignedWorkerName}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"
                                       VerticalOptions="Center"/>

                                <Label Grid.Row="3" Grid.Column="0"
                                       Text="📅 Borrowed" FontSize="12"
                                       TextColor="{DynamicResource Text3}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Row="3" Grid.Column="1"
                                       Text="{Binding BorrowDateDisplay}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- ── STATUS BANNERS ──────────────────── -->
                    <!-- Damaged warning -->
                    <Frame IsVisible="{Binding IsDamaged}"
                           BackgroundColor="{DynamicResource RedBg}"
                           BorderColor="{DynamicResource Red}"
                           CornerRadius="12" Padding="16"
                           HasShadow="False">
                        <Label Text="⚠️  This tool is marked as damaged. Review the Damage Reports page to handle it."
                               FontSize="12"
                               TextColor="{DynamicResource Red}"
                               HorizontalTextAlignment="Center"/>
                    </Frame>

                    <!-- Available notice -->
                    <Frame IsVisible="{Binding IsAvailable}"
                           BackgroundColor="{DynamicResource GreenBg}"
                           BorderColor="{DynamicResource Green}"
                           CornerRadius="12" Padding="16"
                           HasShadow="False">
                        <Label Text="✅  This tool is currently available and not assigned to any worker."
                               FontSize="12"
                               TextColor="{DynamicResource Green}"
                               HorizontalTextAlignment="Center"/>
                    </Frame>

                    <!-- ── TRANSACTION HISTORY ─────────────── -->
                    <Label Text="📋  Transaction History"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"
                           Margin="0,6,0,0"/>

                    <Label Text="Full audit trail for this tool"
                           FontSize="12"
                           TextColor="{DynamicResource Text3}"/>

                    <!-- Loading indicator for history -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{DynamicResource Blue}"
                                       HorizontalOptions="Center"/>

                    <!-- No history empty state -->
                    <Frame IsVisible="{Binding NoTransactions}"
                           BackgroundColor="{DynamicResource BgCard}"
                           BorderColor="{DynamicResource BorderSoft}"
                           CornerRadius="14" Padding="24"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8"
                            HorizontalOptions="Center">
                            <Label Text="📋" FontSize="36"
                                   HorizontalOptions="Center"/>
                            <Label Text="No transactions yet"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text2}"
                                   HorizontalOptions="Center"/>
                            <Label Text="This tool has not been borrowed yet."
                                   FontSize="12"
                                   TextColor="{DynamicResource Text3}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Transaction cards -->
                    <Frame BackgroundColor="{DynamicResource BgCard}"
                           BorderColor="{DynamicResource BorderColor}"
                           CornerRadius="14" Padding="0"
                           HasShadow="False"
                           IsVisible="{Binding NoTransactions,
                               Converter={StaticResource InvertBoolConverter}}">
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Transactions}"
                            Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionLog">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              Padding="14,14"
                                              ColumnSpacing="12">

                                            <!-- Action icon -->
                                            <Frame Grid.Column="0"
                                                   BackgroundColor="{DynamicResource BgElevated}"
                                                   CornerRadius="10"
                                                   WidthRequest="44" HeightRequest="44"
                                                   Padding="0" HasShadow="False"
                                                   BorderColor="Transparent"
                                                   VerticalOptions="Center">
                                                <Label Text="{Binding ActionIcon}"
                                                       FontSize="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Frame>

                                            <!-- Details -->
                                            <VerticalStackLayout Grid.Column="1"
                                                Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Action}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource Text1}"/>
                                                <Label Text="{Binding WorkerName}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource Blue}"/>
                                                <Label Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource Text2}"
                                                       LineBreakMode="TailTruncation"/>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding Condition}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="·" FontSize="11"
                                                           TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="{Binding DateLabel}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource Blue}"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Action badge -->
                                            <Frame Grid.Column="2"
                                                   BackgroundColor="{DynamicResource BgElevated}"
                                                   BorderColor="Transparent"
                                                   CornerRadius="8" Padding="8,4"
                                                   HasShadow="False"
                                                   VerticalOptions="Start">
                                                <Label Text="{Binding Action}"
                                                       FontSize="10" FontAttributes="Bold"
                                                       TextColor="{DynamicResource Text2}"/>
                                            </Frame>
                                        </Grid>

                                        <BoxView HeightRequest="1"
                                                 Color="{DynamicResource BorderSoft}"
                                                 Margin="14,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

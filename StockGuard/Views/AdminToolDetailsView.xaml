<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.AdminToolDetailsView"
    x:DataType="vm:AdminToolDetailsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Spacing="0"
                Padding="0,0,0,40">

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10"
                    Padding="20,52,20,16"
                    BackgroundColor="{DynamicResource BgSurface}">

                    <Button
                        Grid.Column="0"
                        Text="←"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        TextColor="{DynamicResource Text2}"
                        FontSize="18"
                        CornerRadius="8"
                        WidthRequest="40"
                        HeightRequest="36"
                        Padding="0"/>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="1">

                        <Label
                            Text="Tool Details"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Project Engineer view"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="↻"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        TextColor="{DynamicResource Text2}"
                        FontSize="18"
                        CornerRadius="8"
                        WidthRequest="40"
                        HeightRequest="36"
                        Padding="0"/>

                </Grid>

                <!-- ================================================= -->
                <!-- LOADING -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding IsLoading}"
                    Padding="40"
                    Spacing="14"
                    HorizontalOptions="Center">

                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Loading tool details..."
                        FontSize="12"
                        TextColor="{DynamicResource Text3}"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- ================================================= -->
                <!-- NOT FOUND -->
                <!-- ================================================= -->

                <Frame
                    IsVisible="{Binding ToolNotFound}"
                    BackgroundColor="{DynamicResource BgCard}"
                    BorderColor="{DynamicResource BorderColor}"
                    CornerRadius="14"
                    Padding="24"
                    HasShadow="False"
                    Margin="20,20">

                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center">

                        <Label
                            Text="Tool not found"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="This QR code does not match equipment in the system."
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"
                            HorizontalTextAlignment="Center"/>

                        <Button
                            Text="Go Back"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            Margin="0,8,0,0"/>

                    </VerticalStackLayout>

                </Frame>

                <!-- ================================================= -->
                <!-- CONTENT -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding IsNotLoading}"
                    Padding="20,16"
                    Spacing="14">

                    <!-- ================================================= -->
                    <!-- TOOL CARD -->
                    <!-- ================================================= -->

                    <Frame
                        BackgroundColor="{DynamicResource BgCard}"
                        BorderColor="{DynamicResource BorderColor}"
                        CornerRadius="16"
                        Padding="0"
                        HasShadow="False">

                        <VerticalStackLayout
                            Padding="18"
                            Spacing="16">

                            <!-- Tool -->
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="14">

                                <Frame
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource BlueSubtle}"
                                    BorderColor="Transparent"
                                    CornerRadius="14"
                                    WidthRequest="58"
                                    HeightRequest="58"
                                    Padding="0"
                                    HasShadow="False">

                                    <Label
                                        Text="{Binding ToolIcon}"
                                        FontSize="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Frame>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding ToolName}"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        Text="{Binding ToolIdDisplay}"
                                        FontSize="12"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Frame
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        BorderColor="Transparent"
                                        CornerRadius="8"
                                        Padding="9,4"
                                        HasShadow="False"
                                        HorizontalOptions="Start">

                                        <HorizontalStackLayout
                                            Spacing="5">

                                            <Label
                                                Text="{Binding StatusIcon}"
                                                FontSize="11"/>

                                            <Label
                                                Text="{Binding StatusText}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text2}"/>

                                        </HorizontalStackLayout>

                                    </Frame>

                                </VerticalStackLayout>

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource BorderSoft}"/>

                            <!-- Main details -->
                            <Grid
                                ColumnDefinitions="100,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="9">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Catalog"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding CatalogName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Condition"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding ConditionText}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Worker"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding AssignedWorkerName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Project"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding ProjectName}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="Assigned by"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding AssignedByName}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>

                                <Label
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Text="Borrowed"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="{Binding BorrowDateDisplay}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Frame>

                    <!-- ================================================= -->
                    <!-- END DAY CHECK-IN -->
                    <!-- ================================================= -->

                    <Frame
                        IsVisible="{Binding HasCheckInInfo}"
                        BackgroundColor="{DynamicResource BgCard}"
                        BorderColor="{DynamicResource BorderColor}"
                        CornerRadius="14"
                        Padding="16"
                        HasShadow="False">

                        <VerticalStackLayout Spacing="9">

                            <Label
                                Text="Latest End-Day Check-In"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Grid
                                ColumnDefinitions="90,*"
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="7">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Location"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding CheckInLocation}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Checked in"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding CheckInDateDisplay}"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text2}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Verified by"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding CheckInVerifiedBy}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Frame>

                    <!-- ================================================= -->
                    <!-- STATUS NOTICES -->
                    <!-- ================================================= -->

                    <Frame
                        IsVisible="{Binding IsPendingReturn}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        BorderColor="{DynamicResource Amber}"
                        CornerRadius="12"
                        Padding="14"
                        HasShadow="False">

                        <Label
                            Text="Return is pending Project Engineer inspection."
                            FontSize="12"
                            TextColor="{DynamicResource Amber}"
                            HorizontalTextAlignment="Center"/>

                    </Frame>

                    <Frame
                        IsVisible="{Binding IsDamaged}"
                        BackgroundColor="{DynamicResource RedBg}"
                        BorderColor="{DynamicResource Red}"
                        CornerRadius="12"
                        Padding="14"
                        HasShadow="False">

                        <Label
                            Text="This equipment is marked as damaged. Review Damage Reports for handling."
                            FontSize="12"
                            TextColor="{DynamicResource Red}"
                            HorizontalTextAlignment="Center"/>

                    </Frame>

                    <Frame
                        IsVisible="{Binding IsUnderRepair}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        BorderColor="{DynamicResource Blue}"
                        CornerRadius="12"
                        Padding="14"
                        HasShadow="False">

                        <Label
                            Text="This equipment is currently under repair."
                            FontSize="12"
                            TextColor="{DynamicResource Blue}"
                            HorizontalTextAlignment="Center"/>

                    </Frame>

                    <Frame
                        IsVisible="{Binding IsLost}"
                        BackgroundColor="{DynamicResource RedBg}"
                        BorderColor="{DynamicResource Red}"
                        CornerRadius="12"
                        Padding="14"
                        HasShadow="False">

                        <Label
                            Text="This equipment has been marked as lost."
                            FontSize="12"
                            TextColor="{DynamicResource Red}"
                            HorizontalTextAlignment="Center"/>

                    </Frame>

                    <Frame
                        IsVisible="{Binding IsAvailable}"
                        BackgroundColor="{DynamicResource GreenBg}"
                        BorderColor="{DynamicResource Green}"
                        CornerRadius="12"
                        Padding="14"
                        HasShadow="False">

                        <Label
                            Text="This equipment is currently available."
                            FontSize="12"
                            TextColor="{DynamicResource Green}"
                            HorizontalTextAlignment="Center"/>

                    </Frame>

                    <!-- ================================================= -->
                    <!-- HISTORY TITLE -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        Spacing="2"
                        Margin="0,6,0,0">

                        <Label
                            Text="Transaction History"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Audit trail for this equipment"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>

                    <!-- ================================================= -->
                    <!-- NO HISTORY -->
                    <!-- ================================================= -->

                    <Frame
                        IsVisible="{Binding NoTransactions}"
                        BackgroundColor="{DynamicResource BgCard}"
                        BorderColor="{DynamicResource BorderSoft}"
                        CornerRadius="14"
                        Padding="24"
                        HasShadow="False">

                        <VerticalStackLayout
                            Spacing="7"
                            HorizontalOptions="Center">

                            <Label
                                Text="No transactions yet"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Equipment activity will appear here."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Frame>

                    <!-- ================================================= -->
                    <!-- TRANSACTIONS -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Transactions}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:TransactionLog">

                                <Frame
                                    BackgroundColor="{DynamicResource BgCard}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    CornerRadius="14"
                                    Padding="0"
                                    HasShadow="False">

                                    <VerticalStackLayout Spacing="0">

                                        <VerticalStackLayout
                                            Padding="14"
                                            Spacing="9">

                                            <!-- Header -->
                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="10">

                                                <Frame
                                                    Grid.Column="0"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    BorderColor="Transparent"
                                                    CornerRadius="9"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"
                                                    HasShadow="False">

                                                    <Label
                                                        Text="{Binding ActionIcon}"
                                                        FontSize="17"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>

                                                </Frame>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="2"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Action}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"/>

                                                    <Label
                                                        Text="{Binding FullDateLabel}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>

                                                <Frame
                                                    Grid.Column="2"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    BorderColor="Transparent"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    HasShadow="False"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Condition}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text2}"/>

                                                </Frame>

                                            </Grid>

                                            <!-- Description -->
                                            <Label
                                                Text="{Binding Description}"
                                                FontSize="11"
                                                LineBreakMode="WordWrap"
                                                TextColor="{DynamicResource Text2}"/>

                                            <!-- Accountability -->
                                            <Grid
                                                ColumnDefinitions="75,*"
                                                RowDefinitions="Auto,Auto,Auto"
                                                RowSpacing="5">

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Text="Worker"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Text="{Binding WorkerDisplay}"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text2}"/>

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Text="Project"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding ProjectDisplay}"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text2}"/>

                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Text="Action by"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Text="{Binding PerformedByDisplay}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </VerticalStackLayout>

                                </Frame>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
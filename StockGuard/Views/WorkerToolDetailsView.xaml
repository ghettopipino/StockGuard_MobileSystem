<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    x:Class="StockGuard.Views.WorkerToolDetailsView"
    x:DataType="vm:WorkerToolDetailsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Spacing="0"
                Padding="0,0,0,40">


                <!-- ================================================== -->
                <!-- HEADER -->
                <!-- ================================================== -->

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10"
                    Padding="20,52,20,16"
                    BackgroundColor="{DynamicResource BgSurface}">

                    <!-- BACK -->

                    <Button
                        Grid.Column="0"
                        Text="&#xf060;"
                        FontFamily="FontAwesome"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Text2}"
                        FontSize="16"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"/>


                    <!-- TITLE -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="1">

                        <Label
                            Text="Tool Details"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Equipment information"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- REFRESH -->

                    <Button
                        Grid.Column="2"
                        Text="&#xf2f1;"
                        FontFamily="FontAwesome"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Text2}"
                        FontSize="15"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"/>

                </Grid>


                <!-- ================================================== -->
                <!-- LOADING -->
                <!-- ================================================== -->

                <VerticalStackLayout
                    IsVisible="{Binding IsLoading}"
                    Padding="40"
                    Spacing="14"
                    HorizontalOptions="Center">

                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Loading tool details..."
                        FontSize="12"
                        TextColor="{DynamicResource Text3}"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>


                <!-- ================================================== -->
                <!-- TOOL NOT FOUND -->
                <!-- ================================================== -->

                <Border
                    IsVisible="{Binding ToolNotFound}"
                    BackgroundColor="{DynamicResource BgCard}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 14"
                    Padding="24"
                    Margin="20">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Label
                            Text="&#xf128;"
                            FontFamily="FontAwesome"
                            FontSize="28"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Tool Not Found"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="This QR code does not match any tool in the system."
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"/>

                        <Button
                            Text="Go Back"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"
                            Margin="0,8,0,0"
                            Padding="20,0"/>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================== -->
                <!-- MAIN CONTENT -->
                <!-- ================================================== -->

                <VerticalStackLayout
                    IsVisible="{Binding IsNotLoading}"
                    Padding="20,16"
                    Spacing="14">


                    <!-- ================================================== -->
                    <!-- TOOL IDENTITY -->
                    <!-- ================================================== -->

                    <Border
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">

                        <VerticalStackLayout Spacing="16">


                            <!-- TOOL HEADER -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="15">


                                <!-- ICON -->

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="62"
                                    HeightRequest="62"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="25"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Border>


                                <!-- IDENTITY -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="6">

                                    <Label
                                        Text="{Binding ToolName}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        LineBreakMode="TailTruncation"/>

                                    <Label
                                        Text="{Binding ToolIdDisplay}"
                                        FontSize="12"
                                        TextColor="{DynamicResource Text3}"/>


                                    <!-- STATUS -->

                                    <Border
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,4"
                                        HorizontalOptions="Start">

                                        <Label
                                            Text="{Binding StatusText}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{Binding StatusColor}"/>

                                    </Border>

                                </VerticalStackLayout>

                            </Grid>


                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource BorderSoft}"/>


                            <!-- ================================================== -->
                            <!-- ACCOUNTABILITY INFORMATION -->
                            <!-- ================================================== -->

                            <Grid
                                ColumnDefinitions="100,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="13">


                                <!-- WORKER -->

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Worker"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding AssignedWorkerName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation"/>


                                <!-- PROJECT -->

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Project"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding ProjectName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation"/>


                                <!-- ASSIGNED BY -->

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Assigned by"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding AssignedByName}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation"/>


                                <!-- BORROWED -->

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Borrowed"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding BorrowDateDisplay}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>


                                <!-- CONDITION -->

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="Condition"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding ConditionText}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================== -->
                    <!-- QR CODE -->
                    <!-- ================================================== -->

                    <Border
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">

                        <VerticalStackLayout Spacing="14">


                            <!-- TITLE -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf029;"
                                    FontFamily="FontAwesome"
                                    FontSize="14"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="QR Code"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    VerticalOptions="Center"/>

                            </Grid>


                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource BorderSoft}"/>


                            <!-- QR -->

                            <Border
                                BackgroundColor="White"
                                Stroke="#e2e8f0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16"
                                HorizontalOptions="Center">

                                <zxing:BarcodeGeneratorView
                                    WidthRequest="180"
                                    HeightRequest="180"
                                    Format="QrCode"
                                    Value="{Binding ToolIdDisplay}"
                                    ForegroundColor="Black"
                                    BackgroundColor="White"/>

                            </Border>


                            <!-- TOOL ID -->

                            <Border
                                BackgroundColor="{DynamicResource BlueSubtle}"
                                Stroke="{DynamicResource Blue}"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,8"
                                HorizontalOptions="Center">

                                <Label
                                    Text="{Binding ToolIdDisplay}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"
                                    CharacterSpacing="2"/>

                            </Border>


                            <Label
                                Text="Scan this QR code to open the equipment details."
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================== -->
                    <!-- AVAILABLE ACTIONS -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        Spacing="10"
                        Margin="0,2,0,0">


                        <!-- ============================================== -->
                        <!-- PRE-ASSIGNMENT -->
                        <!-- ============================================== -->

                        <Border
                            IsVisible="{Binding ShowConfirmReceipt}"
                            BackgroundColor="{DynamicResource BlueSubtle}"
                            Stroke="{DynamicResource Blue}"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="11">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf058;"
                                    FontFamily="FontAwesome"
                                    FontSize="17"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Start"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label
                                        Text="Pre-assigned to you"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"/>

                                    <Label
                                        Text="This tool has been assigned to you by the Project Engineer. Confirm receipt to start using it."
                                        FontSize="11"
                                        TextColor="{DynamicResource Text2}"
                                        LineBreakMode="WordWrap"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <Button
                            IsVisible="{Binding ShowConfirmReceipt}"
                            Text="Confirm Receipt"
                            Command="{Binding ConfirmReceiptCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>


                        <Button
                            IsVisible="{Binding ShowDeclineReceipt}"
                            Text="Decline Assignment"
                            Command="{Binding DeclineCommand}"
                            BackgroundColor="{DynamicResource RedBg}"
                            TextColor="{DynamicResource Red}"
                            BorderColor="{DynamicResource Red}"
                            BorderWidth="1"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>


                        <!-- ============================================== -->
                        <!-- AVAILABLE TOOL -->
                        <!-- ============================================== -->

                        <Button
                            IsVisible="{Binding ShowBorrow}"
                            Text="Borrow Tool"
                            Command="{Binding BorrowCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>


                        <!-- ============================================== -->
                        <!-- CURRENTLY BORROWED BY THIS WORKER -->
                        <!-- ============================================== -->

                        <Button
                            IsVisible="{Binding ShowEndDayCheckIn}"
                            Text="End Day Check-In"
                            Command="{Binding EndDayCheckInCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Blue}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>

                       


                        <!--<Button
                            IsVisible="{Binding ShowTransfer}"
                            Text="Transfer Tool"
                            Command="{Binding TransferCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Blue}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>-->


                        <Button
                            IsVisible="{Binding ShowReturn}"
                            Text="Return Tool"
                            Command="{Binding ReturnCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Blue}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>


                        <!-- ============================================== -->
                        <!-- REPORT MISSING -->
                        <!-- ============================================== -->

                        <Button
                             IsVisible="{Binding ShowReportMissing}"
                             Text="Report Missing"
                             Command="{Binding ReportMissingCommand}"
                             BackgroundColor="{DynamicResource BgElevated}"
                             TextColor="{DynamicResource Amber}"
                             BorderColor="{DynamicResource Amber}"
                             BorderWidth="1"
                             FontSize="13"
                             FontAttributes="Bold"
                             CornerRadius="10"
                             HeightRequest="48"/>




                        <!-- ============================================== -->
                        <!-- BORROWED BY ANOTHER WORKER -->
                        <!-- ============================================== -->

                        <Button
                            IsVisible="{Binding ShowRequestBorrow}"
                            Text="Request to Borrow"
                            Command="{Binding RequestBorrowCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Blue}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="48"/>


                        <!-- ============================================== -->
                        <!-- CHECK-IN PENDING -->
                        <!-- ============================================== -->

                        <Border
                            IsVisible="{Binding ShowPendingCheckIn}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            Stroke="{DynamicResource Amber}"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            Margin="0,4,0,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="11">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf017;"
                                    FontFamily="FontAwesome"
                                    FontSize="16"
                                    TextColor="{DynamicResource Amber}"
                                    VerticalOptions="Start"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label
                                        Text="End-day check-in pending"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"/>

                                    <Label
                                        Text="{Binding CheckInLocation,
                                            StringFormat='Stored at: {0}'}"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text2}"/>

                                    <Label
                                        Text="Waiting for Project Engineer verification."
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- ============================================== -->
                        <!-- RETURN PENDING -->
                        <!-- ============================================== -->

                        <Border
                            IsVisible="{Binding ShowPendingReturn}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            Stroke="{DynamicResource Amber}"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            Margin="0,4,0,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="11">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf017;"
                                    FontFamily="FontAwesome"
                                    FontSize="16"
                                    TextColor="{DynamicResource Amber}"
                                    VerticalOptions="Start"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label
                                        Text="Return pending verification"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"/>

                                    <Label
                                        Text="Please bring the tool to the Project Engineer. You remain responsible for it until the return is physically verified."
                                        FontSize="11"
                                        TextColor="{DynamicResource Text2}"
                                        LineBreakMode="WordWrap"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- ============================================== -->
                        <!-- MISSING REPORT PENDING -->
                        <!-- ============================================== -->

                        <Border
                            IsVisible="{Binding ShowMissingPending}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            Stroke="{DynamicResource Amber}"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            Margin="0,4,0,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="11">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf071;"
                                    FontFamily="FontAwesome"
                                    FontSize="16"
                                    TextColor="{DynamicResource Amber}"
                                    VerticalOptions="Start"/>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5">

                                    <Label
                                        Text="Missing report pending"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"/>

                                    <Label
                                        Text="Waiting for Project Engineer verification."
                                        FontSize="11"
                                        TextColor="{DynamicResource Text2}"/>

                                    <Label
                                        Text="You remain responsible for this equipment until the report is verified."
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"
                                        LineBreakMode="WordWrap"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- PROCESSING -->
                    <!-- ================================================== -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,6"/>


                    <!-- ================================================== -->
                    <!-- DAMAGED -->
                    <!-- ================================================== -->

                    <Border
                        BackgroundColor="{DynamicResource RedBg}"
                        Stroke="{DynamicResource Red}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        IsVisible="{Binding Tool.IsDamaged}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="This tool is marked as damaged and is currently unavailable for borrowing."
                                FontSize="11"
                                TextColor="{DynamicResource Red}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- ================================================== -->
                    <!-- UNDER REPAIR -->
                    <!-- ================================================== -->

                    <Border
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Amber}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        IsVisible="{Binding Tool.IsUnderRepair}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf7d9;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="This tool is currently under repair."
                                FontSize="11"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ============================================== -->
                    <!-- LOST -->
                    <!-- ============================================== -->

                    <Border
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource Text3}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        IsVisible="{Binding Tool.IsLost}">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="15"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="This equipment has been officially declared lost by the Project Engineer."
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- ================================================== -->
                    <!-- FOOTER -->
                    <!-- ================================================== -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,18,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Tool Details"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
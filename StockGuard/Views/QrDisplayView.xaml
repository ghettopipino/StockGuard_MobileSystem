<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             x:Class="StockGuard.Views.QrDisplayView"
             x:DataType="vm:QrDisplayViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

            <!-- ── HEADER ──────────────────────────────── -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10"
                  Padding="20,52,20,16"
                  BackgroundColor="{DynamicResource BgSurface}">

                <Button Grid.Column="0"
                        Text="←"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        TextColor="{DynamicResource Text2}"
                        FontSize="18" CornerRadius="8"
                        WidthRequest="40" HeightRequest="36"
                        Padding="0"/>

                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="1">
                    <Label Text="QR Code"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"/>
                    <Label Text="Show this to workers or print it"
                           FontSize="11"
                           TextColor="{DynamicResource Text3}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ── QR CODE CARD ────────────────────────── -->
            <Frame BackgroundColor="{DynamicResource BgCard}"
                   BorderColor="{DynamicResource BorderColor}"
                   CornerRadius="20"
                   Padding="30"
                   HasShadow="True"
                   Margin="30,24">

                <VerticalStackLayout Spacing="20"
                                     HorizontalOptions="Center">

                    <!-- Tool name -->
                    <VerticalStackLayout Spacing="4"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ToolName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding ToolId}"
                               FontSize="14"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- QR Code -->
                    <Frame BackgroundColor="White"
                           CornerRadius="16"
                           Padding="20"
                           HasShadow="False"
                           BorderColor="#e2e8f0"
                           HorizontalOptions="Center">
                        <zxing:BarcodeGeneratorView
                            x:Name="QrCode"
                            WidthRequest="220"
                            HeightRequest="220"
                            Format="QrCode"
                            Value="{Binding ToolId}"
                            ForegroundColor="Black"
                            BackgroundColor="White"/>
                    </Frame>

                    <!-- Tool ID label below QR -->
                    <Frame BackgroundColor="{DynamicResource BlueSubtle}"
                           BorderColor="{DynamicResource Blue}"
                           CornerRadius="10"
                           Padding="20,10"
                           HasShadow="False"
                           HorizontalOptions="Center">
                        <Label Text="{Binding ToolId}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Blue}"
                               HorizontalOptions="Center"
                               CharacterSpacing="3"/>
                    </Frame>

                    <!-- Tool info -->
                    <VerticalStackLayout Spacing="8">
                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource BorderSoft}"/>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="8">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Tool Name"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ToolName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Status"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Status}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="Catalog"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"/>
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding CatalogName}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>
                        </Grid>
                        <!-- Borrowed details -->
                        <VerticalStackLayout
                                IsVisible="{Binding IsBorrowed}"
                                Spacing="6"
                                Margin="0,8,0,0">

                            <Label
                                Text="{Binding CurrentBorrowerName, StringFormat='👷 Borrower: {0}'}"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Blue}"/>

                            <Label
                                Text="{Binding CurrentProjectName, StringFormat='📁 Project: {0}'}"
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"/>

                        </VerticalStackLayout>

                        <!-- On Hold details -->
                        <VerticalStackLayout
                                IsVisible="{Binding IsOnHold}"
                                Spacing="6"
                                Margin="0,8,0,0">

                            <Label
                                Text="{Binding HoldProjectName, StringFormat='📁 Project: {0}'}"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="{Binding HoldLocation, StringFormat='📍 Location: {0}'}"
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"/>

                            <Label
                                Text="{Binding LastBorrowerName, StringFormat='👤 Last borrower: {0}'}"
                                FontSize="11"
                                TextColor="{DynamicResource Blue}"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource BorderSoft}"/>
                    </VerticalStackLayout>

                    <!-- Instructions -->
                    <Frame BackgroundColor="{DynamicResource BlueSubtle}"
                           BorderColor="Transparent"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📋  How to use this QR code"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Blue}"/>
                            <Label Text="1. Screenshot this screen"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text2}"/>
                            <Label Text="2. Print the QR code"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text2}"/>
                            <Label Text="3. Attach the sticker to the physical tool"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text2}"/>
                            <Label Text="4. Workers scan it with the app"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text2}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Share button -->
                    <Button Text="📤  Share QR Code"
                            Command="{Binding ShareCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    x:Class="StockGuard.Views.QrDisplayView"
    x:DataType="vm:QrDisplayViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <ScrollView>

        <VerticalStackLayout
            Spacing="0"
            Padding="0,0,0,40">


            <!-- ================================================== -->
            <!-- HEADER -->
            <!-- ================================================== -->

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10"
                Padding="20,52,20,16"
                BackgroundColor="{DynamicResource BgSurface}">

                <!-- BACK -->

                <Button
                    Grid.Column="0"
                    Text="&#xf060;"
                    FontFamily="FontAwesome"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Text2}"
                    FontSize="16"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"/>


                <!-- TITLE -->

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="1">

                    <Label
                        Text="QR Code"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text1}"/>

                    <Label
                        Text="Equipment identification code"
                        FontSize="11"
                        TextColor="{DynamicResource Text3}"/>

                </VerticalStackLayout>

            </Grid>


            <!-- ================================================== -->
            <!-- CONTENT -->
            <!-- ================================================== -->

            <VerticalStackLayout
                Padding="20,20,20,0"
                Spacing="14">


                <!-- ================================================== -->
                <!-- QR CARD -->
                <!-- ================================================== -->

                <Border
                    BackgroundColor="{DynamicResource BgCard}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 16"
                    Padding="22">

                    <VerticalStackLayout
                        Spacing="18">


                        <!-- ================================================== -->
                        <!-- TOOL HEADER -->
                        <!-- ================================================== -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">


                            <!-- TOOL ICON -->

                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">

                                <Label
                                    Text="&#xf0ad;"
                                    FontFamily="FontAwesome"
                                    FontSize="21"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Border>


                            <!-- TOOL -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding ToolName}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    LineBreakMode="TailTruncation"/>

                                <Label
                                    Text="{Binding ToolId}"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                            </VerticalStackLayout>

                        </Grid>


                        <BoxView
                            HeightRequest="1"
                            Color="{DynamicResource BorderSoft}"/>


                        <!-- ================================================== -->
                        <!-- QR CODE -->
                        <!-- ================================================== -->

                        <VerticalStackLayout
                            Spacing="13"
                            HorizontalOptions="Center">


                            <!-- QR -->

                            <Border
                                BackgroundColor="White"
                                Stroke="#e2e8f0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="18"
                                HorizontalOptions="Center">

                                <zxing:BarcodeGeneratorView
                                    x:Name="QrCode"
                                    WidthRequest="220"
                                    HeightRequest="220"
                                    Format="QrCode"
                                    Value="{Binding ToolId}"
                                    ForegroundColor="Black"
                                    BackgroundColor="White"/>

                            </Border>


                            <!-- TOOL ID -->

                            <Border
                                BackgroundColor="{DynamicResource BlueSubtle}"
                                Stroke="{DynamicResource Blue}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="18,9"
                                HorizontalOptions="Center">

                                <Label
                                    Text="{Binding ToolId}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"
                                    CharacterSpacing="2"/>

                            </Border>


                            <HorizontalStackLayout
                                Spacing="6"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf029;"
                                    FontFamily="FontAwesome"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Text="Scan to open equipment details"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>


                        <BoxView
                            HeightRequest="1"
                            Color="{DynamicResource BorderSoft}"/>


                        <!-- ================================================== -->
                        <!-- TOOL INFORMATION -->
                        <!-- ================================================== -->

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="Equipment Information"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>


                            <Grid
                                ColumnDefinitions="110,*"
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="12">


                                <!-- NAME -->

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Tool Name"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding ToolName}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    LineBreakMode="TailTruncation"/>


                                <!-- STATUS -->

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Status"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Status}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>


                                <!-- CATALOG -->

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Catalog"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding CatalogName}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"
                                    LineBreakMode="TailTruncation"/>

                            </Grid>


                            <!-- ================================================== -->
                            <!-- BORROWED DETAILS -->
                            <!-- ================================================== -->

                            <VerticalStackLayout
                                IsVisible="{Binding IsBorrowed}"
                                Spacing="12">

                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <Grid
                                    ColumnDefinitions="110,*"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="12"
                                    RowSpacing="12">


                                    <!-- BORROWER -->

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Borrower"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding CurrentBorrowerName}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        LineBreakMode="TailTruncation"/>


                                    <!-- PROJECT -->

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="Project"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding CurrentProjectName}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        LineBreakMode="TailTruncation"/>

                                </Grid>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================== -->
                <!-- INSTRUCTIONS -->
                <!-- ================================================== -->

                <Border
                    BackgroundColor="{DynamicResource BlueSubtle}"
                    Stroke="{DynamicResource BorderSoft}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">

                    <VerticalStackLayout Spacing="12">


                        <!-- TITLE -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="9">

                            <Label
                                Grid.Column="0"
                                Text="&#xf05a;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Blue}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Using this QR code"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Blue}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <!-- STEP 1 -->

                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="1"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Blue}"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Save or screenshot this QR code."
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"/>

                        </Grid>


                        <!-- STEP 2 -->

                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="2"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Blue}"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Print the QR code as an equipment label."
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"/>

                        </Grid>


                        <!-- STEP 3 -->

                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="3"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Blue}"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Attach the label securely to the physical tool."
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"/>

                        </Grid>


                        <!-- STEP 4 -->

                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="4"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Blue}"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Workers can scan the label using StockGuard."
                                FontSize="11"
                                TextColor="{DynamicResource Text2}"/>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================== -->
                <!-- SHARE -->
                <!-- ================================================== -->

                <Button
                    Text="Share QR Code"
                    Command="{Binding ShareCommand}"
                    BackgroundColor="{DynamicResource Blue}"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"/>


                <!-- ================================================== -->
                <!-- FOOTER -->
                <!-- ================================================== -->

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="6"
                    Margin="0,14,0,0">

                    <Label
                        Text="&#xf3ed;"
                        FontFamily="FontAwesome"
                        FontSize="9"
                        TextColor="{DynamicResource Text3}"
                        VerticalOptions="Center"/>

                    <Label
                        Text="StockGuard · Equipment QR"
                        FontSize="10"
                        TextColor="{DynamicResource Text3}"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
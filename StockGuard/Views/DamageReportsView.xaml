<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.DamageReportsView"
    x:DataType="vm:DamageReportsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- ═══════════════════════════════════════
                         HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <!-- MENU -->

                        <Button
                            Grid.Column="0"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>


                        <!-- TITLE -->

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Damage &amp; Lost Reports"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Review equipment damage and missing incidents"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>


                        <!-- REFRESH -->

                        <Button
                            Grid.Column="2"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="14"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>


                    <!-- ═══════════════════════════════════════
                         PAGE INTRO
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            Text="Equipment Incidents"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Damage and lost equipment are recorded as separate incidents."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"
                            LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         OVERVIEW
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,22,20,0"
                        Spacing="10">

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Report Overview"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesome"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Label
                                    Text="Incident tracking"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                        </Grid>


                        <!-- STATS -->

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8">


                            <!-- TOTAL -->

                            <Border
                                Grid.Column="0"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="8,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf15c;"
                                        FontFamily="FontAwesome"
                                        FontSize="16"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalReports}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- PENDING -->

                            <Border
                                Grid.Column="1"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="8,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf017;"
                                        FontFamily="FontAwesome"
                                        FontSize="16"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding PendingReports}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Pending"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- RESOLVED -->

                            <Border
                                Grid.Column="2"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="8,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf058;"
                                        FontFamily="FontAwesome"
                                        FontSize="16"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding ResolvedReports}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Resolved"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         FILTERS
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,0,14"
                        Spacing="8">

                        <Label
                            Text="Filter Reports"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">

                            <HorizontalStackLayout
                                Spacing="8"
                                Padding="0,0,20,0">

                                <Button
                                    Text="All"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="All"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Text2}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    FontSize="11"
                                    CornerRadius="18"
                                    HeightRequest="36"
                                    Padding="16,0"/>

                                <Button
                                    Text="Damage"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Damage"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Red}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    FontSize="11"
                                    CornerRadius="18"
                                    HeightRequest="36"
                                    Padding="16,0"/>

                                <Button
                                    Text="Missing / Lost"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Lost"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Amber}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    FontSize="11"
                                    CornerRadius="18"
                                    HeightRequest="36"
                                    Padding="16,0"/>

                            </HorizontalStackLayout>

                        </ScrollView>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         LOADING
                         ═══════════════════════════════════════ -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,12"/>


                    <!-- ═══════════════════════════════════════
                         EMPTY STATE
                         ═══════════════════════════════════════ -->

                    <Border
                        IsVisible="{Binding NoReports}"
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        Padding="28"
                        Margin="20,0">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="&#xf058;"
                                FontFamily="FontAwesome"
                                FontSize="24"
                                TextColor="{DynamicResource Green}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No reports"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No matching damage or missing equipment reports were found."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ═══════════════════════════════════════
                         DAMAGE REPORTS
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        IsVisible="{Binding ShowDamageSection}"
                        Padding="20,4,20,0"
                        Spacing="10">

                        <!-- SECTION TITLE -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Damage Reports"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <!-- DAMAGE LIST -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding DamageReports}"
                            IsVisible="{Binding HasDamageReports}"
                            Spacing="12">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:DamageReportResult">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="0">

                                        <VerticalStackLayout
                                            Spacing="0">


                                            <!-- TOOL HEADER -->

                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="11"
                                                Padding="14">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf071;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="17"
                                                    TextColor="{DynamicResource Red}"
                                                    WidthRequest="32"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    VerticalOptions="Center"/>


                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Report.ToolName}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"
                                                        LineBreakMode="TailTruncation"/>

                                                    <Label
                                                        Text="{Binding Report.ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>


                                                <Border
                                                    Grid.Column="2"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="8,4"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Report.Status}"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text2}"/>

                                                </Border>

                                            </Grid>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- BODY -->

                                            <VerticalStackLayout
                                                Padding="14,12"
                                                Spacing="13">


                                                <!-- ACCOUNTABILITY -->

                                                <VerticalStackLayout
                                                    Spacing="8">

                                                    <Label
                                                        Text="Accountability"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text3}"/>


                                                    <!-- WORKER -->

                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="9">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf007;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="10"
                                                            WidthRequest="18"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <VerticalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="1">

                                                            <Label
                                                                Text="Worker"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Text="{Binding Report.WorkerName}"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text1}"/>

                                                        </VerticalStackLayout>

                                                    </Grid>


                                                    <!-- PROJECT -->

                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="9">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf1ad;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="10"
                                                            WidthRequest="18"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <VerticalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="1">

                                                            <Label
                                                                Text="Project"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Text="{Binding Report.ProjectName}"
                                                                FontSize="11"
                                                                TextColor="{DynamicResource Text2}"/>

                                                        </VerticalStackLayout>

                                                    </Grid>


                                                    <!-- PE -->

                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="9">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf2bd;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="10"
                                                            WidthRequest="18"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <VerticalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="1">

                                                            <Label
                                                                Text="Project Engineer"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Text="{Binding Report.ProjectEngineerName}"
                                                                FontSize="11"
                                                                TextColor="{DynamicResource Text2}"/>

                                                        </VerticalStackLayout>

                                                    </Grid>

                                                </VerticalStackLayout>


                                                <!-- DAMAGE DETAILS -->

                                                <Border
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12">

                                                    <VerticalStackLayout
                                                        Spacing="8">

                                                        <Grid
                                                            ColumnDefinitions="*,Auto">

                                                            <HorizontalStackLayout
                                                                Grid.Column="0"
                                                                Spacing="6">

                                                                <Label
                                                                    Text="&#xf071;"
                                                                    FontFamily="FontAwesome"
                                                                    FontSize="9"
                                                                    TextColor="{DynamicResource Red}"
                                                                    VerticalOptions="Center"/>

                                                                <Label
                                                                    Text="Damage Details"
                                                                    FontSize="10"
                                                                    FontAttributes="Bold"
                                                                    TextColor="{DynamicResource Text2}"
                                                                    VerticalOptions="Center"/>

                                                            </HorizontalStackLayout>


                                                            <Label
                                                                Grid.Column="1"
                                                                Text="{Binding Report.Severity}"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Red}"
                                                                VerticalOptions="Center"/>

                                                        </Grid>


                                                        <BoxView
                                                            HeightRequest="1"
                                                            Color="{DynamicResource BorderSoft}"/>


                                                        <Label
                                                            Text="{Binding Report.Description}"
                                                            FontSize="11"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </VerticalStackLayout>

                                                </Border>


                                                <!-- REPORT DATE -->

                                                <HorizontalStackLayout
                                                    Spacing="6">

                                                    <Label
                                                        Text="&#xf073;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding Report.ReportDate,
                                                            StringFormat='Reported {0:MMM d, yyyy h:mm tt}'}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>


                                                <!-- REVIEW INFORMATION -->

                                                <Border
                                                    IsVisible="{Binding Report.ReviewedDate}"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="{DynamicResource BorderSoft}"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12">

                                                    <VerticalStackLayout
                                                        Spacing="8">

                                                        <HorizontalStackLayout
                                                            Spacing="6">

                                                            <Label
                                                                Text="&#xf058;"
                                                                FontFamily="FontAwesome"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Green}"
                                                                VerticalOptions="Center"/>

                                                            <Label
                                                                Text="Review Information"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text2}"
                                                                VerticalOptions="Center"/>

                                                        </HorizontalStackLayout>


                                                        <Grid
                                                            ColumnDefinitions="Auto,*"
                                                            RowDefinitions="Auto,Auto"
                                                            ColumnSpacing="10"
                                                            RowSpacing="5">

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Text="Reviewed by"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Text="{Binding Report.ReviewedByName}"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text2}"/>


                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Text="Reviewed"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Text="{Binding Report.ReviewedDate,
                                                                    StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Text2}"/>

                                                        </Grid>


                                                        <BoxView
                                                            HeightRequest="1"
                                                            Color="{DynamicResource BorderSoft}"/>


                                                        <Label
                                                            Text="Resolution"
                                                            FontSize="9"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding Report.ResolutionNotes}"
                                                            FontSize="10"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </VerticalStackLayout>

                                                </Border>

                                            </VerticalStackLayout>


                                            <!-- FOOTER -->

                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- ACTIVE DAMAGE REPORT -->

                                            <Button
                                                IsVisible="{Binding Report.CanBeHandled}"
                                                Text="Handle Damage Report"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DamageReportsViewModel}},
                                                                  Path=HandleDamageReportCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Blue}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="46"/>


                                            <!-- COMPLETED DAMAGE REPORT -->

                                            <Grid
                                                IsVisible="{Binding Report.IsFinal}"
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="9"
                                                Padding="16,12">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf058;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="14"
                                                    TextColor="{DynamicResource Green}"
                                                    VerticalOptions="Center"/>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="1"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="Damage report completed"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text2}"/>

                                                    <Label
                                                        Text="This record is read-only."
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         MISSING / LOST REPORTS
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        IsVisible="{Binding ShowLostSection}"
                        Padding="20,24,20,0"
                        Spacing="10">

                        <!-- SECTION TITLE -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf002;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Missing &amp; Lost Reports"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <!-- LOST LIST -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding LostReports}"
                            IsVisible="{Binding HasLostReports}"
                            Spacing="12">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:LostReportResult">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="0">

                                        <VerticalStackLayout
                                            Spacing="0">


                                            <!-- TOOL HEADER -->

                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="11"
                                                Padding="14">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf002;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="17"
                                                    TextColor="{DynamicResource Amber}"
                                                    WidthRequest="32"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    VerticalOptions="Center"/>


                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Report.ToolName}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"
                                                        LineBreakMode="TailTruncation"/>

                                                    <Label
                                                        Text="{Binding Report.ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>


                                                <Border
                                                    Grid.Column="2"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="8,4"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Report.StatusDisplay}"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Amber}"/>

                                                </Border>

                                            </Grid>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- BODY -->

                                            <VerticalStackLayout
                                                Padding="14,12"
                                                Spacing="13">


                                                <!-- ACCOUNTABILITY -->

                                                <VerticalStackLayout
                                                    Spacing="8">

                                                    <Label
                                                        Text="Accountability"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text3}"/>


                                                    <!-- WORKER -->

                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="9">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf007;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="10"
                                                            WidthRequest="18"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <VerticalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="1">

                                                            <Label
                                                                Text="Responsible Worker"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Text="{Binding Report.WorkerName}"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text1}"/>

                                                        </VerticalStackLayout>

                                                    </Grid>


                                                    <!-- PROJECT -->

                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="9">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf1ad;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="10"
                                                            WidthRequest="18"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <VerticalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="1">

                                                            <Label
                                                                Text="Project"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Text="{Binding Report.ProjectName}"
                                                                FontSize="11"
                                                                TextColor="{DynamicResource Text2}"/>

                                                        </VerticalStackLayout>

                                                    </Grid>

                                                </VerticalStackLayout>


                                                <!-- MISSING DETAILS -->

                                                <Border
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12">

                                                    <VerticalStackLayout
                                                        Spacing="8">

                                                        <HorizontalStackLayout
                                                            Spacing="6">

                                                            <Label
                                                                Text="&#xf05a;"
                                                                FontFamily="FontAwesome"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Amber}"
                                                                VerticalOptions="Center"/>

                                                            <Label
                                                                Text="Missing Report"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text2}"
                                                                VerticalOptions="Center"/>

                                                        </HorizontalStackLayout>


                                                        <BoxView
                                                            HeightRequest="1"
                                                            Color="{DynamicResource BorderSoft}"/>


                                                        <Label
                                                            Text="{Binding Report.MissingDescription}"
                                                            FontSize="11"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </VerticalStackLayout>

                                                </Border>


                                                <!-- REPORT DATE -->

                                                <HorizontalStackLayout
                                                    Spacing="6">

                                                    <Label
                                                        Text="&#xf073;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding Report.ReportDate,
                                                            StringFormat='Reported {0:MMM d, yyyy h:mm tt}'}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>


                                                <!-- PE VERIFICATION -->

                                                <Border
                                                    IsVisible="{Binding Report.VerifiedDate}"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="{DynamicResource BorderSoft}"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12">

                                                    <VerticalStackLayout
                                                        Spacing="8">

                                                        <HorizontalStackLayout
                                                            Spacing="6">

                                                            <Label
                                                                Text="&#xf058;"
                                                                FontFamily="FontAwesome"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Blue}"
                                                                VerticalOptions="Center"/>

                                                            <Label
                                                                Text="Project Engineer Verification"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text2}"
                                                                VerticalOptions="Center"/>

                                                        </HorizontalStackLayout>


                                                        <Grid
                                                            ColumnDefinitions="Auto,*"
                                                            RowDefinitions="Auto,Auto"
                                                            ColumnSpacing="10"
                                                            RowSpacing="5">

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Text="Verified by"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Text="{Binding Report.VerifiedByName}"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{DynamicResource Text2}"/>


                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Text="Verified"
                                                                FontSize="9"
                                                                TextColor="{DynamicResource Text3}"/>

                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Text="{Binding Report.VerifiedDate,
                                                                    StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                                                FontSize="10"
                                                                TextColor="{DynamicResource Text2}"/>

                                                        </Grid>


                                                        <BoxView
                                                            HeightRequest="1"
                                                            Color="{DynamicResource BorderSoft}"/>


                                                        <Label
                                                            Text="Notes"
                                                            FontSize="9"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding Report.ResolutionNotes}"
                                                            FontSize="10"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </VerticalStackLayout>

                                                </Border>

                                            </VerticalStackLayout>


                                            <!-- FOOTER -->

                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- PENDING / LOST ACTION -->

                                            <Button
                                                IsVisible="{Binding Report.CanBeHandled}"
                                                Text="Handle Missing / Lost Report"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DamageReportsViewModel}},
                                                                  Path=HandleLostReportCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Blue}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="46"/>


                                            <!-- RESOLVED -->

                                            <Grid
                                                IsVisible="{Binding Report.IsResolved}"
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="9"
                                                Padding="16,12">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf058;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="14"
                                                    TextColor="{DynamicResource Green}"
                                                    VerticalOptions="Center"/>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="1"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="Incident resolved"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text2}"/>

                                                    <Label
                                                        Text="This record is read-only."
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         FOOTER
                         ═══════════════════════════════════════ -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,28,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Damage &amp; Lost Reports"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
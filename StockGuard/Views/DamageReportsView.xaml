<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.DamageReportsView"
    x:DataType="vm:DamageReportsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">

                    <!-- ================================================= -->
                    <!-- HEADER -->
                    <!-- ================================================= -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <Button
                            Grid.Column="0"
                            Text="☰"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="18"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Damage Reports"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Review and manage damaged equipment"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="↻"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="18"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- STATS -->
                    <!-- ================================================= -->

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="10"
                        Padding="20,14">

                        <!-- TOTAL -->
                        <Frame
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False">

                            <VerticalStackLayout
                                Padding="0,14"
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="{Binding TotalReports}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Total"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Frame>


                        <!-- PENDING -->
                        <Frame
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False">

                            <VerticalStackLayout
                                Padding="0,14"
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="{Binding PendingReports}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Amber}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Pending"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Frame>


                        <!-- RESOLVED -->
                        <Frame
                            Grid.Column="2"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False">

                            <VerticalStackLayout
                                Padding="0,14"
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="{Binding ResolvedReports}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Green}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Resolved"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Frame>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- FILTERS -->
                    <!-- ================================================= -->

                    <ScrollView
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="20,0,20,14">

                        <HorizontalStackLayout Spacing="8">

                            <Button
                                Text="All"
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="All"
                                BackgroundColor="{DynamicResource BgCard}"
                                TextColor="{DynamicResource Text2}"
                                BorderColor="{DynamicResource BorderColor}"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="38"
                                Padding="16,0"/>

                            <Button
                                Text="Pending"
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="Pending"
                                BackgroundColor="{DynamicResource BgCard}"
                                TextColor="{DynamicResource Amber}"
                                BorderColor="{DynamicResource BorderColor}"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="38"
                                Padding="16,0"/>

                            <Button
                                Text="Under Repair"
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="UnderRepair"
                                BackgroundColor="{DynamicResource BgCard}"
                                TextColor="{DynamicResource Blue}"
                                BorderColor="{DynamicResource BorderColor}"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="38"
                                Padding="16,0"/>

                            <Button
                                Text="Resolved"
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="Resolved"
                                BackgroundColor="{DynamicResource BgCard}"
                                TextColor="{DynamicResource Green}"
                                BorderColor="{DynamicResource BorderColor}"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="38"
                                Padding="16,0"/>

                            <Button
                                Text="Lost"
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="Lost"
                                BackgroundColor="{DynamicResource BgCard}"
                                TextColor="{DynamicResource Red}"
                                BorderColor="{DynamicResource BorderColor}"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="38"
                                Padding="16,0"/>

                        </HorizontalStackLayout>

                    </ScrollView>


                    <!-- ================================================= -->
                    <!-- LOADING -->
                    <!-- ================================================= -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,10"/>


                    <!-- ================================================= -->
                    <!-- EMPTY STATE -->
                    <!-- ================================================= -->

                    <Frame
                        IsVisible="{Binding NoReports}"
                        BackgroundColor="{DynamicResource BgCard}"
                        BorderColor="{DynamicResource BorderSoft}"
                        CornerRadius="14"
                        Padding="28"
                        HasShadow="False"
                        Margin="20,0">

                        <VerticalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">

                            <Label
                                Text="No damage reports"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No equipment damage has been reported."
                                FontSize="12"
                                TextColor="{DynamicResource Text3}"
                                HorizontalTextAlignment="Center"
                                HorizontalOptions="Center"/>

                        </VerticalStackLayout>

                    </Frame>


                    <!-- ================================================= -->
                    <!-- REPORT LIST -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Reports}"
                        IsVisible="{Binding HasReports}"
                        Padding="20,0"
                        Spacing="12">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:DamageReportResult">

                                <Frame
                                    BackgroundColor="{DynamicResource BgCard}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    CornerRadius="14"
                                    Padding="0"
                                    HasShadow="False">

                                    <VerticalStackLayout Spacing="0">


                                        <!-- ================================= -->
                                        <!-- MAIN CARD CONTENT -->
                                        <!-- ================================= -->

                                        <VerticalStackLayout
                                            Padding="16"
                                            Spacing="12">


                                            <!-- TOOL + STATUS -->
                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="10">

                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="3">

                                                    <Label
                                                        Text="{Binding Report.ToolName}"
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"/>

                                                    <Label
                                                        Text="{Binding Report.ToolId}"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>


                                                <!-- STATUS -->
                                                <Frame
                                                    Grid.Column="1"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    BorderColor="Transparent"
                                                    CornerRadius="8"
                                                    Padding="9,5"
                                                    HasShadow="False"
                                                    VerticalOptions="Start">

                                                    <Label
                                                        Text="{Binding Report.Status}"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text2}"/>

                                                </Frame>

                                            </Grid>


                                            <!-- ================================= -->
                                            <!-- ACCOUNTABILITY -->
                                            <!-- ================================= -->

                                            <Grid
                                                ColumnDefinitions="100,*"
                                                RowDefinitions="Auto,Auto,Auto"
                                                RowSpacing="7">

                                                <!-- WORKER -->
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Text="Worker: "
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Text="{Binding Report.WorkerName}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>


                                                <!-- PROJECT -->
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Text="Project: "
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding Report.ProjectName}"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource Text2}"/>


                                                <!-- PROJECT ENGINEER -->
                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Text="Project Engineer: "
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Text="{Binding Report.ProjectEngineerName}"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource Text2}"/>

                                            </Grid>


                                            <!-- ================================= -->
                                            <!-- DAMAGE INFORMATION -->
                                            <!-- ================================= -->

                                            <Frame
                                                BackgroundColor="{DynamicResource BgElevated}"
                                                BorderColor="Transparent"
                                                CornerRadius="10"
                                                Padding="12"
                                                HasShadow="False">

                                                <VerticalStackLayout Spacing="7">

                                                    <Grid
                                                        ColumnDefinitions="80,*">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="Severity"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding Report.Severity}"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Red}"/>

                                                    </Grid>


                                                    <BoxView
                                                        HeightRequest="1"
                                                        Color="{DynamicResource BorderSoft}"
                                                        Margin="0,2"/>


                                                    <Label
                                                        Text="Description"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text3}"/>

                                                    <Label
                                                        Text="{Binding Report.Description}"
                                                        FontSize="12"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="{DynamicResource Text2}"/>

                                                </VerticalStackLayout>

                                            </Frame>


                                            <!-- ================================= -->
                                            <!-- REPORT DATE -->
                                            <!-- ================================= -->

                                            <Label
                                                Text="{Binding Report.ReportDate,
                                                    StringFormat='Reported: {0:MMM d, yyyy h:mm tt}'}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}"/>


                                            <!-- ================================= -->
                                            <!-- REVIEW INFORMATION -->
                                            <!-- Only appears after report handled -->
                                            <!-- ================================= -->

                                            <Frame
                                                IsVisible="{Binding Report.ReviewedDate}"
                                                BackgroundColor="{DynamicResource BgElevated}"
                                                BorderColor="{DynamicResource BorderSoft}"
                                                CornerRadius="10"
                                                Padding="12"
                                                HasShadow="False">

                                                <VerticalStackLayout Spacing="7">

                                                    <Label
                                                        Text="Review"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text3}"/>


                                                    <Grid
                                                        ColumnDefinitions="90,*"
                                                        RowDefinitions="Auto,Auto"
                                                        RowSpacing="6">

                                                        <!-- REVIEWER -->
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Text="Reviewed by"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Text="{Binding Report.ReviewedByName}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text2}"/>


                                                        <!-- REVIEW DATE -->
                                                        <Label
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Text="Reviewed"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Text="{Binding Report.ReviewedDate,
                                                                StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </Grid>


                                                    <BoxView
                                                        HeightRequest="1"
                                                        Color="{DynamicResource BorderSoft}"
                                                        Margin="0,2"/>


                                                    <Label
                                                        Text="Resolution"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text3}"/>

                                                    <Label
                                                        Text="{Binding Report.ResolutionNotes}"
                                                        FontSize="11"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="{DynamicResource Text2}"/>

                                                </VerticalStackLayout>

                                            </Frame>

                                        </VerticalStackLayout>


                                        <!-- ================================= -->
                                        <!-- CARD FOOTER -->
                                        <!-- ================================= -->

                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <!-- ================================= -->
                                        <!-- ACTIVE REPORT -->
                                        <!-- Pending / UnderRepair -->
                                        <!-- ================================= -->

                                        <Button
                                            IsVisible="{Binding Report.CanBeHandled}"
                                            Text="Handle Report"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DamageReportsViewModel}},
                                                              Path=HandleReportCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource Blue}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            HeightRequest="46"/>


                                        <!-- ================================= -->
                                        <!-- FINAL REPORT -->
                                        <!-- Resolved / Lost -->
                                        <!-- ================================= -->

                                        <Grid
                                            IsVisible="{Binding Report.IsFinal}"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="9"
                                            Padding="16,12">

                                            <Label
                                                Grid.Column="0"
                                                Text="✓"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Green}"
                                                VerticalOptions="Center"/>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="1"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="Report completed"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text2}"/>

                                                <Label
                                                    Text="This record is read-only."
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"/>

                                            </VerticalStackLayout>

                                        </Grid>

                                    </VerticalStackLayout>

                                </Frame>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- FOOTER -->
                    <!-- ================================================= -->

                    <Label
                        Text="© 2025 StockGuard"
                        FontSize="10"
                        TextColor="{DynamicResource Text3}"
                        HorizontalOptions="Center"
                        Margin="0,20,0,0"/>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
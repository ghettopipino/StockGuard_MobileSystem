<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             x:Class="StockGuard.Views.DamageReportsView"
             x:DataType="vm:DamageReportsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                    <!-- ── HEADER ──────────────────────────── -->
                    <!-- ☰ replaces ← — DamageReportsView is a FlyoutItem root page -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="10"
                          Padding="20,52,20,16"
                          BackgroundColor="{DynamicResource BgSurface}">

                        <Button Grid.Column="0"
                                Text="☰"
                                Command="{Binding OpenFlyoutCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="18" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center" Spacing="1">
                            <Label Text="Damage Reports"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>
                            <Label Text="Review and resolve tool damage"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="{Binding ThemeIcon}"
                                Command="{Binding ToggleThemeCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>

                        <Button Grid.Column="3"
                                Text="🔄"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>
                    </Grid>

                    <!-- ── STATS ROW ───────────────────────── -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10" Padding="20,14">

                        <Frame Grid.Column="0"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="14" Padding="0" HasShadow="False">
                            <VerticalStackLayout Padding="10,14" Spacing="4"
                                HorizontalOptions="Center">
                                <Label Text="📋" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding TotalReports}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="{DynamicResource Blue}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Total" FontSize="10"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="14" Padding="0" HasShadow="False">
                            <VerticalStackLayout Padding="10,14" Spacing="4"
                                HorizontalOptions="Center">
                                <Label Text="⏳" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding PendingReports}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="{DynamicResource Amber}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Pending" FontSize="10"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="2"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="14" Padding="0" HasShadow="False">
                            <VerticalStackLayout Padding="10,14" Spacing="4"
                                HorizontalOptions="Center">
                                <Label Text="✅" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding ResolvedReports}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="{DynamicResource Green}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Resolved" FontSize="10"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- ── FILTER CHIPS ────────────────────── -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                Padding="20,0,20,14">
                        <HorizontalStackLayout Spacing="8">

                            <Frame Padding="14,7" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                                </Frame.GestureRecognizers>
                                <Label Text="All" FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"/>
                            </Frame>

                            <Frame Padding="14,7" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Pending"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Pending" FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource Amber}"/>
                            </Frame>

                            <Frame Padding="14,7" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="UnderRepair"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Under Repair" FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource Blue}"/>
                            </Frame>

                            <Frame Padding="14,7" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Resolved"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Resolved" FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource Green}"/>
                            </Frame>

                            <Frame Padding="14,7" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Lost"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Lost" FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource Red}"/>
                            </Frame>

                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- ── LOADING ─────────────────────────── -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,20"/>

                    <!-- ── EMPTY STATE ─────────────────────── -->
                    <Frame IsVisible="{Binding NoReports}"
                           BackgroundColor="{DynamicResource BgCard}"
                           BorderColor="{DynamicResource BorderSoft}"
                           CornerRadius="14" Padding="32"
                           HasShadow="False" Margin="20,0">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="✅" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="No damage reports"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text2}"
                                   HorizontalOptions="Center"/>
                            <Label Text="All tools are in good condition"
                                   FontSize="13"
                                   TextColor="{DynamicResource Text3}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- ── REPORTS LIST ────────────────────── -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Reports}"
                        Padding="20,0" Spacing="12"
                        IsVisible="{Binding HasReports}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:EnrichedDamageReportItem">
                                <Frame BackgroundColor="{DynamicResource BgCard}"
         BorderColor="{DynamicResource BorderColor}"
         CornerRadius="16" Padding="0" HasShadow="False">
                                    <VerticalStackLayout Spacing="0">

                                        <!-- ── INSIGHT BANNER (only when there is one) ────── -->
                                        <Frame IsVisible="{Binding HasInsight}"
             BackgroundColor="{DynamicResource AmberBg}"
             BorderColor="Transparent"
             CornerRadius="0" Padding="14,8"
             HasShadow="False">
                                            <Label Text="{Binding InsightMessage}"
               FontSize="12" FontAttributes="Bold"
               TextColor="{DynamicResource Amber}"/>
                                        </Frame>

                                        <!-- ── TOP ROW ─────────────────────────────────────── -->
                                        <Grid ColumnDefinitions="Auto,*,Auto"
            Padding="16,14,16,12" ColumnSpacing="12">

                                            <Frame Grid.Column="0"
               BackgroundColor="{DynamicResource RedBg}"
               CornerRadius="12" WidthRequest="48" HeightRequest="48"
               Padding="0" HasShadow="False" BorderColor="Transparent"
               VerticalOptions="Center">
                                                <Label Text="⚠️" FontSize="22"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"/>
                                            </Frame>

                                            <VerticalStackLayout Grid.Column="1"
            Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding ToolName}"
                 FontSize="15" FontAttributes="Bold"
                 TextColor="{DynamicResource Text1}"/>
                                                <Label Text="{Binding ToolId}"
                 FontSize="12" TextColor="{DynamicResource Text3}"/>

                                                <!-- Reporter -->
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="📋" FontSize="11"/>
                                                    <Label Text="Reported by:" FontSize="11"
                   TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="{Binding WorkerName}" FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Text2}"/>
                                                </HorizontalStackLayout>

                                                <!-- Last handler (new) -->
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="🤝" FontSize="11"/>
                                                    <Label Text="Last handler:" FontSize="11"
                   TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="{Binding LastHandlerName}" FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Amber}"/>
                                                </HorizontalStackLayout>

                                                <!-- Primary custodian (new) -->
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="👷" FontSize="11"/>
                                                    <Label Text="Custodian:" FontSize="11"
                   TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="{Binding PrimaryCustodian}" FontSize="11"
                   TextColor="{DynamicResource Text2}"/>
                                                </HorizontalStackLayout>

                                                <Label Text="{Binding DateLabel}" FontSize="11"
                 TextColor="{DynamicResource Text3}"/>
                                            </VerticalStackLayout>

                                            <!-- Status + severity + confidence badges -->
                                            <VerticalStackLayout Grid.Column="2"
            VerticalOptions="Start" Spacing="5">
                                                <Frame BackgroundColor="{DynamicResource BgElevated}"
                 BorderColor="Transparent"
                 CornerRadius="8" Padding="8,4" HasShadow="False">
                                                    <Label FontSize="11" FontAttributes="Bold"
                   TextColor="{Binding StatusColor}"
                   HorizontalOptions="Center">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding StatusIcon}"/>
                                                                <Span Text=" "/>
                                                                <Span Text="{Binding Status}"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Frame>
                                                <Frame BackgroundColor="{DynamicResource BgElevated}"
                 BorderColor="Transparent"
                 CornerRadius="8" Padding="8,4" HasShadow="False">
                                                    <Label Text="{Binding Severity}" FontSize="10"
                   FontAttributes="Bold"
                   TextColor="{Binding SeverityColor}"
                   HorizontalOptions="Center"/>
                                                </Frame>
                                                <!-- Confidence badge (new) -->
                                                <Frame BackgroundColor="{DynamicResource BgElevated}"
                 BorderColor="Transparent"
                 CornerRadius="8" Padding="8,4" HasShadow="False">
                                                    <Label FontSize="10" FontAttributes="Bold"
                   TextColor="{Binding ConfidenceColor}"
                   HorizontalOptions="Center">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding ConfidenceIcon}"/>
                                                                <Span Text=" "/>
                                                                <Span Text="{Binding ConfidenceLevel}"/>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Frame>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- ── DESCRIPTION ─────────────────────────────────── -->
                                        <Frame BackgroundColor="{DynamicResource BgElevated}"
             BorderColor="Transparent"
             CornerRadius="0" Padding="16,10"
             HasShadow="False" Margin="16,0">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Description" FontSize="10"
                 FontAttributes="Bold"
                 TextColor="{DynamicResource Text3}"/>
                                                <Label Text="{Binding Description}" FontSize="12"
                 TextColor="{DynamicResource Text2}"/>
                                            </VerticalStackLayout>
                                        </Frame>

                                        <!-- ── CUSTODY TIMELINE (new) ──────────────────────── -->
                                        <Frame BackgroundColor="{DynamicResource BgElevated}"
             BorderColor="Transparent"
             CornerRadius="0" Padding="16,10"
             HasShadow="False" Margin="16,4">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="Custody Timeline" FontSize="10"
                 FontAttributes="Bold"
                 TextColor="{DynamicResource Text3}"/>
                                                <VerticalStackLayout
              BindableLayout.ItemsSource="{Binding CustodyTimeline}"
              Spacing="4">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:CustodyEntry">
                                                            <HorizontalStackLayout Spacing="8">
                                                                <Label Text="{Binding ActionIcon}" FontSize="11"/>
                                                                <Label Text="{Binding WorkerName}" FontSize="11"
                         FontAttributes="Bold"
                         TextColor="{DynamicResource Text2}"/>
                                                                <Label Text="{Binding Action}" FontSize="11"
                         TextColor="{DynamicResource Text3}"/>
                                                                <Label Text="{Binding DateLabel}" FontSize="10"
                         TextColor="{DynamicResource Text3}"/>
                                                            </HorizontalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Frame>

                                        <BoxView HeightRequest="1"
               Color="{DynamicResource BorderSoft}" Margin="0,8"/>

                                        <!-- ── ACTION BUTTONS ──────────────────────────────── -->
                                        <Grid ColumnDefinitions="*,*" Padding="16,0,16,14"
            ColumnSpacing="8" IsVisible="{Binding IsPending}">

                                            <Button Grid.Column="0"
                Text="🔧  Handle Report"
                CommandParameter="{Binding .}"
                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DamageReportsViewModel}}, Path=HandleReportCommand}"
                BackgroundColor="{DynamicResource Blue}"
                TextColor="White" FontSize="13" FontAttributes="Bold"
                CornerRadius="10" HeightRequest="48"/>

                                            <Button Grid.Column="1"
                Text="⚖️  Dispute"
                CommandParameter="{Binding .}"
                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DamageReportsViewModel}}, Path=DisputeReportCommand}"
                BackgroundColor="{DynamicResource AmberBg}"
                TextColor="{DynamicResource Amber}"
                FontSize="13" FontAttributes="Bold"
                CornerRadius="10" HeightRequest="48"/>
                                        </Grid>

                                        <!-- Add statement button (visible when disputed) -->
                                        <Button IsVisible="{Binding IsDisputed}"
              Text="📝  Add My Statement"
              CommandParameter="{Binding .}"
              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DamageReportsViewModel}}, Path=AddNoteCommand}"
              BackgroundColor="{DynamicResource BgElevated}"
              TextColor="{DynamicResource Text2}"
              FontSize="12" CornerRadius="0" HeightRequest="42"
              Margin="16,0,16,14"/>

                                        <Label IsVisible="{Binding IsPending, Converter={StaticResource InvertBoolConverter}}"
             Text="{Binding StatusIcon, StringFormat='{0}  Already handled'}"
             FontSize="12" TextColor="{Binding StatusColor}"
             HorizontalOptions="Center" Margin="0,0,0,14"/>

                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="© 2025 StockGuard" FontSize="10"
                           TextColor="{DynamicResource Text3}"
                           HorizontalOptions="Center"
                           Margin="0,20,0,0"/>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>

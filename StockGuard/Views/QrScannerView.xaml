<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
             x:Class="StockGuard.Views.QrScannerView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <Grid>

        <!-- ── Live Camera QR Reader ── -->
        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            BarcodesDetected="OnBarcodesDetected"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>

        <!-- ── Dark overlay top ── -->
        <BoxView BackgroundColor="#99000000"
                 VerticalOptions="Start"
                 HeightRequest="180"
                 InputTransparent="True"/>

        <!-- ── Dark overlay bottom ── -->
        <BoxView BackgroundColor="#99000000"
                 VerticalOptions="End"
                 HeightRequest="220"
                 InputTransparent="True"/>

        <!-- ── Scanner frame box ── -->
        <Grid WidthRequest="240" HeightRequest="240"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              InputTransparent="True">

            <BoxView BackgroundColor="#22ffffff"
                     CornerRadius="12"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"/>

            <!-- Top-left corner -->
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="36" HeightRequest="4"
                     HorizontalOptions="Start" VerticalOptions="Start"/>
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="4" HeightRequest="36"
                     HorizontalOptions="Start" VerticalOptions="Start"/>

            <!-- Top-right corner -->
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="36" HeightRequest="4"
                     HorizontalOptions="End" VerticalOptions="Start"/>
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="4" HeightRequest="36"
                     HorizontalOptions="End" VerticalOptions="Start"/>

            <!-- Bottom-left corner -->
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="36" HeightRequest="4"
                     HorizontalOptions="Start" VerticalOptions="End"/>
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="4" HeightRequest="36"
                     HorizontalOptions="Start" VerticalOptions="End"/>

            <!-- Bottom-right corner -->
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="36" HeightRequest="4"
                     HorizontalOptions="End" VerticalOptions="End"/>
            <BoxView BackgroundColor="#3b82f6"
                     WidthRequest="4" HeightRequest="36"
                     HorizontalOptions="End" VerticalOptions="End"/>

        </Grid>

        <!-- ── Top header bar ── -->
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              VerticalOptions="Start"
              Padding="20,52,20,16"
              BackgroundColor="#CC000000">

            <Button Grid.Column="0"
                    Text="✕"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#33ffffff"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    WidthRequest="40"
                    HeightRequest="36"
                    Padding="0"/>

            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="2">
                <Label Text="Scan Tool QR Code"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="Point camera at the tool's QR label"
                       FontSize="11"
                       TextColor="#94a3b8"/>
            </VerticalStackLayout>

        </Grid>

        <!-- ── Bottom instruction bar ── -->
        <VerticalStackLayout VerticalOptions="End"
                             Padding="24,20"
                             BackgroundColor="#CC000000"
                             Spacing="6">

            <Label Text="📷  Align the QR code inside the frame"
                   FontSize="13"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <Label Text="The scanner detects automatically — no button needed"
                   FontSize="11"
                   TextColor="#94a3b8"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    x:Class="StockGuard.Views.QrScannerView"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Black">

    <Grid>

        <!-- ====================================================== -->
        <!-- CAMERA -->
        <!-- ====================================================== -->

        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            BarcodesDetected="OnBarcodesDetected"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>


        <!-- ====================================================== -->
        <!-- TOP OVERLAY -->
        <!-- ====================================================== -->

        <BoxView
            BackgroundColor="#B3000000"
            VerticalOptions="Start"
            HeightRequest="180"
            InputTransparent="True"/>


        <!-- ====================================================== -->
        <!-- BOTTOM OVERLAY -->
        <!-- ====================================================== -->

        <BoxView
            BackgroundColor="#B3000000"
            VerticalOptions="End"
            HeightRequest="230"
            InputTransparent="True"/>


        <!-- ====================================================== -->
        <!-- SCANNER FRAME -->
        <!-- ====================================================== -->

        <Grid
            WidthRequest="250"
            HeightRequest="250"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            InputTransparent="True">

            <!-- LIGHT TRANSPARENT SCAN AREA -->
            <Border
                BackgroundColor="#16FFFFFF"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 16"/>


            <!-- TOP LEFT -->
            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="40"
                HeightRequest="4"
                HorizontalOptions="Start"
                VerticalOptions="Start"/>

            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="4"
                HeightRequest="40"
                HorizontalOptions="Start"
                VerticalOptions="Start"/>


            <!-- TOP RIGHT -->
            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="40"
                HeightRequest="4"
                HorizontalOptions="End"
                VerticalOptions="Start"/>

            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="4"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="Start"/>


            <!-- BOTTOM LEFT -->
            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="40"
                HeightRequest="4"
                HorizontalOptions="Start"
                VerticalOptions="End"/>

            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="4"
                HeightRequest="40"
                HorizontalOptions="Start"
                VerticalOptions="End"/>


            <!-- BOTTOM RIGHT -->
            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="40"
                HeightRequest="4"
                HorizontalOptions="End"
                VerticalOptions="End"/>

            <BoxView
                BackgroundColor="#3b82f6"
                WidthRequest="4"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="End"/>

        </Grid>


        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <Grid
            ColumnDefinitions="Auto,*"
            ColumnSpacing="12"
            VerticalOptions="Start"
            Padding="20,52,20,16"
            BackgroundColor="#CC000000">

            <!-- CLOSE -->
            <Button
                Grid.Column="0"
                Text="&#xf00d;"
                FontFamily="FontAwesome"
                Clicked="OnCloseClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="16"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"/>

            <!-- TITLE -->
            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="2">

                <Label
                    Text="Scan Tool QR Code"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Point the camera at the equipment QR label"
                    FontSize="11"
                    TextColor="#94a3b8"
                    LineBreakMode="TailTruncation"/>

            </VerticalStackLayout>

        </Grid>


        <!-- ====================================================== -->
        <!-- CENTER HELPER -->
        <!-- ====================================================== -->

        <Border
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Margin="0,310,0,0"
            BackgroundColor="#B3000000"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 12"
            Padding="12,7"
            InputTransparent="True">

            <HorizontalStackLayout
                Spacing="7"
                HorizontalOptions="Center">

                <Label
                    Text="&#xf029;"
                    FontFamily="FontAwesome"
                    FontSize="11"
                    TextColor="#60a5fa"
                    VerticalOptions="Center"/>

                <Label
                    Text="Keep the QR code inside the frame"
                    FontSize="11"
                    TextColor="White"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

        </Border>


        <!-- ====================================================== -->
        <!-- BOTTOM INSTRUCTIONS -->
        <!-- ====================================================== -->

        <VerticalStackLayout
            VerticalOptions="End"
            Padding="24,20,24,30"
            BackgroundColor="#CC000000"
            Spacing="8">

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="8">

                <Label
                    Text="&#xf030;"
                    FontFamily="FontAwesome"
                    FontSize="13"
                    TextColor="#60a5fa"
                    VerticalOptions="Center"/>

                <Label
                    Text="Align the QR code inside the frame"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <Label
                Text="Scanning starts automatically. No button is required."
                FontSize="11"
                TextColor="#94a3b8"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
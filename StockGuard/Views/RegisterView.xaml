<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    x:Class="StockGuard.Views.RegisterView"
    x:DataType="vm:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,52,20,40"
            Spacing="0">


            <!-- HEADER -->

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="&#xf060;"
                    FontFamily="FontAwesome"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Text2}"
                    FontSize="16"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"/>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="Create Account"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text1}"/>

                    <Label
                        Text="Register your StockGuard account"
                        FontSize="11"
                        TextColor="{DynamicResource Text3}"/>

                </VerticalStackLayout>

            </Grid>


            <!-- INTRO -->

            <VerticalStackLayout
                Margin="0,24,0,0"
                Spacing="4">

                <Label
                    Text="Account Information"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource Text1}"/>

                <Label
                    Text="Enter your details below to continue."
                    FontSize="11"
                    TextColor="{DynamicResource Text3}"/>

            </VerticalStackLayout>


            <!-- ERROR -->

            <Border
                IsVisible="{Binding HasError}"
                BackgroundColor="{DynamicResource RedBg}"
                Stroke="{DynamicResource Red}"
                StrokeShape="RoundRectangle 10"
                Padding="12"
                Margin="0,14,0,0">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">

                    <Label
                        Grid.Column="0"
                        Text="&#xf071;"
                        FontFamily="FontAwesome"
                        FontSize="12"
                        TextColor="{DynamicResource Red}"
                        VerticalOptions="Start"/>

                    <Label
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        FontSize="11"
                        TextColor="{DynamicResource Red}"
                        LineBreakMode="WordWrap"/>

                </Grid>

            </Border>


            <!-- FORM -->

            <VerticalStackLayout
                Spacing="14"
                Margin="0,18,0,0">


                <!-- FULL NAME -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Full Name"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">

                        <Entry
                            Text="{Binding FullName}"
                            Placeholder="Enter your full name"
                            PlaceholderColor="{DynamicResource Text3}"
                            TextColor="{DynamicResource Text1}"
                            BackgroundColor="Transparent"
                            FontSize="12"
                            HeightRequest="46"/>

                    </Border>

                </VerticalStackLayout>


                <!-- EMAIL -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Email"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">

                        <Entry
                            Text="{Binding Email}"
                            Placeholder="you@example.com"
                            Keyboard="Email"
                            PlaceholderColor="{DynamicResource Text3}"
                            TextColor="{DynamicResource Text1}"
                            BackgroundColor="Transparent"
                            FontSize="12"
                            HeightRequest="46"/>

                    </Border>

                </VerticalStackLayout>


                <!-- PHONE -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Phone Number"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">

                        <Entry
                            Text="{Binding PhoneNumber}"
                            Placeholder="09XX XXX XXXX"
                            Keyboard="Telephone"
                            PlaceholderColor="{DynamicResource Text3}"
                            TextColor="{DynamicResource Text1}"
                            BackgroundColor="Transparent"
                            FontSize="12"
                            HeightRequest="46"/>

                    </Border>

                </VerticalStackLayout>


                <!-- ADDRESS -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Address"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">

                        <Entry
                            Text="{Binding Address}"
                            Placeholder="Street, Barangay, City"
                            PlaceholderColor="{DynamicResource Text3}"
                            TextColor="{DynamicResource Text1}"
                            BackgroundColor="Transparent"
                            FontSize="12"
                            HeightRequest="46"/>

                    </Border>

                </VerticalStackLayout>


                <!-- ROLE -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Register As"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="8,0">

                        <Picker
                            ItemsSource="{Binding RoleOptions}"
                            SelectedItem="{Binding SelectedRole}"
                            TextColor="{DynamicResource Text1}"
                            TitleColor="{DynamicResource Text3}"
                            BackgroundColor="Transparent"
                            FontSize="12"
                            HeightRequest="46"/>

                    </Border>

                </VerticalStackLayout>


                <!-- PASSWORD -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Password"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="6">

                            <Entry
                                Grid.Column="0"
                                Text="{Binding Password}"
                                Placeholder="Minimum 6 characters"
                                IsPassword="{Binding ShowPassword,
                                    Converter={StaticResource InvertBoolConverter}}"
                                PlaceholderColor="{DynamicResource Text3}"
                                TextColor="{DynamicResource Text1}"
                                BackgroundColor="Transparent"
                                FontSize="12"
                                HeightRequest="46"/>

                            <Button
                                Grid.Column="1"
                                Text="&#xf06e;"
                                FontFamily="FontAwesome"
                                Command="{Binding TogglePasswordCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Text3}"
                                FontSize="13"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- CONFIRM PASSWORD -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Confirm Password"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text2}"/>

                    <Border
                        BackgroundColor="{DynamicResource InputBg}"
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,0">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="6">

                            <Entry
                                Grid.Column="0"
                                Text="{Binding ConfirmPassword}"
                                Placeholder="Re-enter your password"
                                IsPassword="{Binding ShowConfirmPassword,
                                    Converter={StaticResource InvertBoolConverter}}"
                                PlaceholderColor="{DynamicResource Text3}"
                                TextColor="{DynamicResource Text1}"
                                BackgroundColor="Transparent"
                                FontSize="12"
                                HeightRequest="46"/>

                            <Button
                                Grid.Column="1"
                                Text="&#xf06e;"
                                FontFamily="FontAwesome"
                                Command="{Binding ToggleConfirmCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Text3}"
                                FontSize="13"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>


            <!-- APPROVAL NOTICE -->

            <Border
                BackgroundColor="{DynamicResource BlueSubtle}"
                Stroke="{DynamicResource BorderSoft}"
                StrokeShape="RoundRectangle 12"
                Padding="13"
                Margin="0,18,0,0">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="9">

                    <Label
                        Grid.Column="0"
                        Text="&#xf3ed;"
                        FontFamily="FontAwesome"
                        FontSize="12"
                        TextColor="{DynamicResource Blue}"
                        VerticalOptions="Start"/>

                    <Label
                        Grid.Column="1"
                        Text="New accounts require approval from the Project Engineer before login."
                        FontSize="10"
                        TextColor="{DynamicResource Text2}"
                        LineBreakMode="WordWrap"/>

                </Grid>

            </Border>


            <!-- REGISTER -->

            <Button
                Text="Create Account"
                Command="{Binding RegisterCommand}"
                BackgroundColor="{DynamicResource Blue}"
                TextColor="White"
                FontSize="13"
                FontAttributes="Bold"
                HeightRequest="48"
                CornerRadius="10"
                Margin="0,18,0,0"/>


            <!-- LOADING -->

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{DynamicResource Blue}"
                HorizontalOptions="Center"
                Margin="0,12,0,0"/>


            <!-- LOGIN LINK -->

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4"
                Margin="0,18,0,0">

                <Label
                    Text="Already have an account?"
                    FontSize="11"
                    TextColor="{DynamicResource Text2}"
                    VerticalOptions="Center"/>

                <Button
                    Text="Sign In"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Blue}"
                    FontAttributes="Bold"
                    FontSize="11"
                    Padding="4,0"
                    HeightRequest="32"/>

            </HorizontalStackLayout>


            <!-- FOOTER -->

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="6"
                Margin="0,24,0,0">

                <Label
                    Text="&#xf3ed;"
                    FontFamily="FontAwesome"
                    FontSize="9"
                    TextColor="{DynamicResource Text3}"
                    VerticalOptions="Center"/>

                <Label
                    Text="StockGuard · Registration"
                    FontSize="10"
                    TextColor="{DynamicResource Text3}"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
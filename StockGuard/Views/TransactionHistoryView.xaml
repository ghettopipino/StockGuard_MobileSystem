<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             xmlns:converters="clr-namespace:StockGuard.Converters"
             x:Class="StockGuard.Views.TransactionHistoryView"
             x:DataType="vm:TransactionHistoryViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <ContentPage.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
    </ContentPage.Resources>

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <CollectionView
                x:Name="TransactionsCollection"
                ItemsSource="{Binding Transactions}"
                ItemSizingStrategy="MeasureFirstItem">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                </CollectionView.ItemsLayout>

                <!-- ══════════════════════════════════════════════
                     HEADER
                     ══════════════════════════════════════════════ -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,4">

                        <!-- ── PAGE HEADER ──────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="10"
                              Padding="20,52,20,16"
                              BackgroundColor="{DynamicResource BgSurface}">

                            <Button Grid.Column="0"
                                    Text="←"
                                    Command="{Binding GoBackCommand}"
                                    IsVisible="{Binding IsWorkerMode}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="18" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>

                            <Button Grid.Column="0"
                                    Text="☰"
                                    Command="{Binding OpenFlyoutCommand}"
                                    IsVisible="{Binding IsAdminMode}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="18" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding PageTitle}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"/>
                                <Label Text="{Binding PageSubtitle}"
                                       FontSize="11"
                                       TextColor="{DynamicResource Text3}"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="{Binding ThemeIcon}"
                                    Command="{Binding ToggleThemeCommand}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="16" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>

                            <Button Grid.Column="3"
                                    Text="🔄"
                                    Command="{Binding RefreshCommand}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="16" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>
                        </Grid>

                        <!-- ── STATS ROW ────────────────────────────── -->
                        <!--
                            Now 5 columns: Total | Borrowed | Returned | Transferred | Damaged
                            ColumnSpacing reduced to 6 to keep cards from clipping on narrow screens.
                        -->
                        <Grid ColumnDefinitions="*,*,*,*,*"
                              ColumnSpacing="6" Padding="20,14">

                            <Frame Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="6,12" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="{Binding TotalCount}"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Total" FontSize="9"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="6,12" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="{Binding BorrowCount}"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Borrowed" FontSize="9"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Column="2"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="6,12" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="{Binding ReturnCount}"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Returned" FontSize="9"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- NEW: Transferred stat card -->
                            <Frame Grid.Column="3"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="6,12" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="{Binding TransferCount}"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Transferred" FontSize="9"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Column="4"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="6,12" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="{Binding DamageCount}"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="{DynamicResource Red}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Damaged" FontSize="9"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- ── FILTER CHIPS ──────────────────────────── -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never"
                                    Padding="20,0,20,14">
                            <HorizontalStackLayout Spacing="8">

                                <Border Padding="14,7"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="All"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="All" FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource Text2}"/>
                                </Border>

                                <Border Padding="14,7"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="Borrowed"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Borrowed" FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"/>
                                </Border>

                                <Border Padding="14,7"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="Returned"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Returned" FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"/>
                                </Border>

                                <Border Padding="14,7"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="Transferred"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Transferred" FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"/>
                                </Border>

                                <Border Padding="14,7"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="Damaged"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Damaged" FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource Red}"/>
                                </Border>

                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- ── LOADING INDICATOR ────────────────────── -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            HorizontalOptions="Center"
                            Margin="0,20"/>

                        <!-- ── EMPTY STATE ───────────────────────────── -->
                        <Frame IsVisible="{Binding NoTransactions}"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderSoft}"
                               CornerRadius="14" Padding="32"
                               HasShadow="False" Margin="20,0">
                            <VerticalStackLayout Spacing="10"
                                HorizontalOptions="Center">
                                <Label Text="📋" FontSize="48"
                                       HorizontalOptions="Center"/>
                                <Label Text="No transactions yet"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Your borrow and return history will appear here"
                                       FontSize="13"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <BoxView IsVisible="{Binding HasTransactions}"
                                 HeightRequest="1"
                                 Margin="20,0"
                                 Color="{DynamicResource BorderColor}"/>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- ══════════════════════════════════════════════
                     ITEM TEMPLATE
                     ══════════════════════════════════════════════ -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionLog">

                        <VerticalStackLayout Spacing="0"
                                             BackgroundColor="{DynamicResource BgCard}"
                                             Margin="20,0">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="14" ColumnSpacing="12">

                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="Transparent"
                                        WidthRequest="44" HeightRequest="44"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding ActionIcon}"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                    Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding ToolName}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{DynamicResource Text1}"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="{DynamicResource Text2}"
                                           LineBreakMode="TailTruncation"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding ToolId}"
                                               FontSize="11"
                                               TextColor="{DynamicResource Text3}"/>
                                        <Label Text="·" FontSize="11"
                                               TextColor="{DynamicResource Text3}"/>
                                        <Label Text="{Binding WorkerName}"
                                               FontSize="11"
                                               TextColor="{DynamicResource Text3}"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding DateLabel}"
                                           FontSize="11"
                                           TextColor="{DynamicResource Blue}"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Action}"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{DynamicResource BorderSoft}"
                                     Margin="14,0"/>

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- ══════════════════════════════════════════════
                     FOOTER
                     ══════════════════════════════════════════════ -->
                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="0" Padding="20,12,20,40">

                        <Label Text="{Binding PaginationLabel}"
                               IsVisible="{Binding HasTransactions}"
                               FontSize="12"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10"/>

                        <Frame IsVisible="{Binding HasMoreItems}"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="12" Padding="0"
                               HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto"
                                  Padding="16,14">

                                <Label Grid.Column="0"
                                       Text="Load More"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource Blue}"
                                       VerticalOptions="Center"/>

                                <ActivityIndicator
                                    Grid.Column="1"
                                    IsRunning="{Binding IsLoadingMore}"
                                    IsVisible="{Binding IsLoadingMore}"
                                    Color="{DynamicResource Blue}"
                                    WidthRequest="20" HeightRequest="20"
                                    VerticalOptions="Center"/>

                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding
                                        Source={x:Reference TransactionsCollection},
                                        Path=BindingContext.LoadMoreCommand}"/>
                            </Frame.GestureRecognizers>
                        </Frame>

                        <Label Text="© 2025 StockGuard"
                               FontSize="10"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               Margin="0,16,0,0"/>

                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.TransactionHistoryView"
    x:DataType="vm:TransactionHistoryViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <CollectionView
                x:Name="TransactionsCollection"
                ItemsSource="{Binding Transactions}"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10"/>
                </CollectionView.ItemsLayout>


                <!-- ═══════════════════════════════════════
                     HEADER
                     ═══════════════════════════════════════ -->

                <CollectionView.Header>

                    <VerticalStackLayout
                        Spacing="0"
                        Padding="0,0,0,10">


                        <!-- PAGE HEADER -->

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10"
                            Padding="20,52,20,16"
                            BackgroundColor="{DynamicResource BgSurface}">


                            <!-- WORKER BACK -->

                            <Button
                                Grid.Column="0"
                                Text="&#xf060;"
                                FontFamily="FontAwesome"
                                Command="{Binding GoBackCommand}"
                                IsVisible="{Binding IsWorkerMode}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="14"
                                CornerRadius="10"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"/>


                            <!-- PE FLYOUT -->

                            <Button
                                Grid.Column="0"
                                Text="&#xf0c9;"
                                FontFamily="FontAwesome"
                                Command="{Binding OpenFlyoutCommand}"
                                IsVisible="{Binding IsAdminMode}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16"
                                CornerRadius="10"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"/>


                            <!-- TITLE -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="1">

                                <Label
                                    Text="{Binding PageTitle}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="{Binding PageSubtitle}"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    LineBreakMode="TailTruncation"/>

                            </VerticalStackLayout>


                            <!-- REFRESH -->

                            <Button
                                Grid.Column="2"
                                Text="&#xf2f1;"
                                FontFamily="FontAwesome"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="14"
                                CornerRadius="10"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"/>

                        </Grid>


                        <!-- ═══════════════════════════════════════
                             PAGE INTRO
                             ═══════════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,20,20,0"
                            Spacing="4">

                            <Label
                                Text="Activity History"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Review equipment movement and accountability records."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>


                        <!-- ═══════════════════════════════════════
                             ACTIVITY OVERVIEW
                             ═══════════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,22,20,0"
                            Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Grid.Column="0"
                                    Text="Activity Overview"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf1da;"
                                        FontFamily="FontAwesome"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Text="Transaction log"
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}"/>

                                </HorizontalStackLayout>

                            </Grid>


                            <!-- FIRST ROW -->

                            <Grid
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="8">


                                <!-- TOTAL -->

                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="8,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf03a;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding TotalCount}"
                                            FontSize="21"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Total"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- BORROWED -->

                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="8,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf466;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding BorrowCount}"
                                            FontSize="21"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Borrowed"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- RETURNED -->

                                <Border
                                    Grid.Column="2"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="8,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf2f6;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding ReturnCount}"
                                            FontSize="21"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Returned"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>


                            <!-- SECOND ROW -->

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">


                                <!-- CHECK-IN -->

                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">

                                        <Label
                                            Grid.Column="0"
                                            Text="&#xf2f5;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Blue}"
                                            WidthRequest="30"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            VerticalOptions="Center"/>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding CheckInCount}"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Blue}"/>

                                            <Label
                                                Text="Check-In"
                                                FontSize="9"
                                                TextColor="{DynamicResource Text3}"/>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>


                                <!-- DAMAGE -->

                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">

                                        <Label
                                            Grid.Column="0"
                                            Text="&#xf071;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Red}"
                                            WidthRequest="30"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            VerticalOptions="Center"/>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding DamageCount}"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Red}"/>

                                            <Label
                                                Text="Damage"
                                                FontSize="9"
                                                TextColor="{DynamicResource Text3}"/>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>


                        <!-- ═══════════════════════════════════════
                             FILTERS
                             ═══════════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,20,0,14"
                            Spacing="8">

                            <Label
                                Text="Filter Activity"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"/>

                            <ScrollView
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">

                                <HorizontalStackLayout
                                    Spacing="8"
                                    Padding="0,0,20,0">

                                    <Button
                                        Text="All"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="All"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        TextColor="{DynamicResource Text2}"
                                        BorderColor="{DynamicResource BorderColor}"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        FontSize="11"
                                        HeightRequest="36"
                                        Padding="16,0"/>

                                    <Button
                                        Text="Borrowed"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Borrowed"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        TextColor="{DynamicResource Amber}"
                                        BorderColor="{DynamicResource BorderColor}"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        FontSize="11"
                                        HeightRequest="36"
                                        Padding="16,0"/>

                                    <Button
                                        Text="Returned"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Returned"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        TextColor="{DynamicResource Green}"
                                        BorderColor="{DynamicResource BorderColor}"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        FontSize="11"
                                        HeightRequest="36"
                                        Padding="16,0"/>

                                    <Button
                                        Text="Check-In"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Check-In"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        TextColor="{DynamicResource Blue}"
                                        BorderColor="{DynamicResource BorderColor}"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        FontSize="11"
                                        HeightRequest="36"
                                        Padding="16,0"/>

                                    <Button
                                        Text="Damage"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Damage"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        TextColor="{DynamicResource Red}"
                                        BorderColor="{DynamicResource BorderColor}"
                                        BorderWidth="1"
                                        CornerRadius="18"
                                        FontSize="11"
                                        HeightRequest="36"
                                        Padding="16,0"/>

                                </HorizontalStackLayout>

                            </ScrollView>

                        </VerticalStackLayout>


                        <!-- LOADING -->

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            HorizontalOptions="Center"
                            Margin="0,14"/>


                        <!-- EMPTY STATE -->

                        <Border
                            IsVisible="{Binding NoTransactions}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="28"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf1da;"
                                    FontFamily="FontAwesome"
                                    FontSize="25"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No transactions"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Equipment activity will appear here."
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                </CollectionView.Header>


                <!-- ═══════════════════════════════════════
                     TRANSACTION CARDS
                     ═══════════════════════════════════════ -->

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:TransactionLog">

                        <Border
                            Margin="20,0"
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="0">

                            <VerticalStackLayout
                                Spacing="0">


                                <!-- MAIN INFORMATION -->

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="11"
                                    Padding="14">

                                    <!-- ICON -->

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        TextColor="{DynamicResource Blue}"
                                        WidthRequest="34"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"/>


                                    <!-- TOOL -->

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ToolName}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text1}"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Text="{Binding ToolId}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                    </VerticalStackLayout>


                                    <!-- ACTION -->

                                    <Border
                                        Grid.Column="2"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        Padding="8,4"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Action}"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"/>

                                    </Border>

                                </Grid>


                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource BorderSoft}"/>


                                <!-- DETAILS -->

                                <VerticalStackLayout
                                    Padding="14,11"
                                    Spacing="10">

                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="11"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource Text2}"/>


                                    <!-- ACCOUNTABILITY -->

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        RowDefinitions="Auto,Auto,Auto"
                                        ColumnSpacing="10"
                                        RowSpacing="6">


                                        <!-- WORKER -->

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="&#xf007;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            WidthRequest="16"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding WorkerDisplay}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text2}"/>


                                        <!-- PROJECT -->

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="&#xf1ad;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            WidthRequest="16"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding ProjectDisplay}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text2}"/>


                                        <!-- PERFORMED BY -->

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Text="&#xf2bd;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            WidthRequest="16"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{Binding PerformedByDisplay}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text1}"/>

                                    </Grid>


                                    <!-- DATE / CONDITION -->

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">

                                        <HorizontalStackLayout
                                            Grid.Column="0"
                                            Spacing="5">

                                            <Label
                                                Text="&#xf073;"
                                                FontFamily="FontAwesome"
                                                FontSize="8"
                                                TextColor="{DynamicResource Text3}"
                                                VerticalOptions="Center"/>

                                            <Label
                                                Text="{Binding FullDateLabel}"
                                                FontSize="9"
                                                TextColor="{DynamicResource Text3}"
                                                VerticalOptions="Center"/>

                                        </HorizontalStackLayout>


                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="5">

                                            <Label
                                                Text="&#xf05a;"
                                                FontFamily="FontAwesome"
                                                FontSize="8"
                                                TextColor="{DynamicResource Text3}"
                                                VerticalOptions="Center"/>

                                            <Label
                                                Text="{Binding Condition}"
                                                FontSize="9"
                                                TextColor="{DynamicResource Text3}"
                                                VerticalOptions="Center"/>

                                        </HorizontalStackLayout>

                                    </Grid>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>


                <!-- ═══════════════════════════════════════
                     FOOTER / PAGINATION
                     ═══════════════════════════════════════ -->

                <CollectionView.Footer>

                    <VerticalStackLayout
                        Spacing="10"
                        Padding="20,14,20,40">


                        <Label
                            Text="{Binding PaginationLabel}"
                            IsVisible="{Binding HasTransactions}"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"/>


                        <!-- LOAD MORE -->

                        <Border
                            IsVisible="{Binding HasMoreItems}"
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            Padding="0">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                Padding="16,13">

                                <HorizontalStackLayout
                                    Grid.Column="0"
                                    Spacing="7">

                                    <Label
                                        Text="&#xf078;"
                                        FontFamily="FontAwesome"
                                        FontSize="10"
                                        TextColor="{DynamicResource Blue}"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Text="Load More"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        VerticalOptions="Center"/>

                                </HorizontalStackLayout>


                                <ActivityIndicator
                                    Grid.Column="1"
                                    IsRunning="{Binding IsLoadingMore}"
                                    IsVisible="{Binding IsLoadingMore}"
                                    Color="{DynamicResource Blue}"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center"/>

                            </Grid>


                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding
                                        Source={x:Reference TransactionsCollection},
                                        Path=BindingContext.LoadMoreCommand}"/>

                            </Border.GestureRecognizers>

                        </Border>


                        <!-- FOOTER -->

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="6"
                            Margin="0,14,0,0">

                            <Label
                                Text="&#xf3ed;"
                                FontFamily="FontAwesome"
                                FontSize="9"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="StockGuard · Transaction History"
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </CollectionView.Footer>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.TransactionHistoryView"
    x:DataType="vm:TransactionHistoryViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <CollectionView
                x:Name="TransactionsCollection"
                ItemsSource="{Binding Transactions}"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.ItemsLayout>

                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10"/>

                </CollectionView.ItemsLayout>


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <CollectionView.Header>

                    <VerticalStackLayout
                        Spacing="0"
                        Padding="0,0,0,10">


                        <!-- PAGE HEADER -->

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10"
                            Padding="20,52,20,16"
                            BackgroundColor="{DynamicResource BgSurface}">


                            <!-- WORKER BACK -->

                            <Button
                                Grid.Column="0"
                                Text="←"
                                Command="{Binding GoBackCommand}"
                                IsVisible="{Binding IsWorkerMode}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="18"
                                CornerRadius="8"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"/>


                            <!-- PE FLYOUT -->

                            <Button
                                Grid.Column="0"
                                Text="☰"
                                Command="{Binding OpenFlyoutCommand}"
                                IsVisible="{Binding IsAdminMode}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="18"
                                CornerRadius="8"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"/>


                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="1">

                                <Label
                                    Text="{Binding PageTitle}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="{Binding PageSubtitle}"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    LineBreakMode="TailTruncation"/>

                            </VerticalStackLayout>


                            <Button
                                Grid.Column="2"
                                Text="↻"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="18"
                                CornerRadius="8"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- STATS -->
                        <!-- ================================================= -->

                        <Grid
                            ColumnDefinitions="*,*,*,*,*"
                            ColumnSpacing="6"
                            Padding="20,14">


                            <!-- TOTAL -->

                            <Frame
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="12"
                                Padding="0"
                                HasShadow="False">

                                <VerticalStackLayout
                                    Padding="0,12"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding TotalCount}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Total"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Frame>


                            <!-- BORROWED -->

                            <Frame
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="12"
                                Padding="0"
                                HasShadow="False">

                                <VerticalStackLayout
                                    Padding="0,12"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding BorrowCount}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Borrowed"
                                        FontSize="8"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Frame>


                            <!-- RETURNED -->

                            <Frame
                                Grid.Column="2"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="12"
                                Padding="0"
                                HasShadow="False">

                                <VerticalStackLayout
                                    Padding="0,12"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding ReturnCount}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Returned"
                                        FontSize="8"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Frame>


                            <!-- CHECK-IN -->

                            <Frame
                                Grid.Column="3"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="12"
                                Padding="0"
                                HasShadow="False">

                                <VerticalStackLayout
                                    Padding="0,12"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding CheckInCount}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Check-In"
                                        FontSize="8"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Frame>


                            <!-- DAMAGE -->

                            <Frame
                                Grid.Column="4"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="12"
                                Padding="0"
                                HasShadow="False">

                                <VerticalStackLayout
                                    Padding="0,12"
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding DamageCount}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Red}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Damage"
                                        FontSize="8"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Frame>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- FILTERS -->
                        <!-- ================================================= -->

                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Padding="20,0,20,14">

                            <HorizontalStackLayout Spacing="8">


                                <Button
                                    Text="All"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="All"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Text2}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="18"
                                    FontSize="12"
                                    HeightRequest="38"
                                    Padding="16,0"/>


                                <Button
                                    Text="Borrowed"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Borrowed"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Amber}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="18"
                                    FontSize="12"
                                    HeightRequest="38"
                                    Padding="16,0"/>


                                <Button
                                    Text="Returned"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Returned"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Green}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="18"
                                    FontSize="12"
                                    HeightRequest="38"
                                    Padding="16,0"/>


                                <Button
                                    Text="Check-In"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Check-In"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Blue}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="18"
                                    FontSize="12"
                                    HeightRequest="38"
                                    Padding="16,0"/>


                                <Button
                                    Text="Damage"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Damage"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    TextColor="{DynamicResource Red}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="18"
                                    FontSize="12"
                                    HeightRequest="38"
                                    Padding="16,0"/>

                            </HorizontalStackLayout>

                        </ScrollView>


                        <!-- LOADING -->

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            HorizontalOptions="Center"
                            Margin="0,15"/>


                        <!-- EMPTY -->

                        <Frame
                            IsVisible="{Binding NoTransactions}"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderSoft}"
                            CornerRadius="14"
                            Padding="28"
                            HasShadow="False"
                            Margin="20,0">

                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">

                                <Label
                                    Text="No transactions"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Equipment activity will appear here."
                                    FontSize="12"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Frame>

                    </VerticalStackLayout>

                </CollectionView.Header>


                <!-- ================================================= -->
                <!-- TRANSACTION CARD -->
                <!-- ================================================= -->

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:TransactionLog">

                        <Frame
                            Margin="20,0"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False">

                            <VerticalStackLayout Spacing="0">


                                <!-- MAIN -->

                                <VerticalStackLayout
                                    Padding="14,10"
                                    Spacing="10">


                                    <!-- TOOL / ACTION -->

                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="10">

                                        <Frame
                                            Grid.Column="0"
                                            BackgroundColor="{DynamicResource BgElevated}"
                                            BorderColor="Transparent"
                                            CornerRadius="10"
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            Padding="0"
                                            HasShadow="False">

                                            <Label
                                                Text="{Binding ActionIcon}"
                                                FontSize="18"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"/>

                                        </Frame>


                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding ToolName}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"/>

                                            <Label
                                                Text="{Binding ToolId}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}"/>

                                        </VerticalStackLayout>


                                        <Frame
                                            Grid.Column="2"
                                            BackgroundColor="{DynamicResource BgElevated}"
                                            BorderColor="Transparent"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            HasShadow="False"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Action}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Blue}"/>

                                        </Frame>

                                    </Grid>


                                    <!-- DESCRIPTION -->

                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource Text2}"/>


                                    <!-- ACCOUNTABILITY -->

                                    <Grid
                                        ColumnDefinitions="75,*"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="5">


                                        <!-- WORKER -->

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="Worker: "
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding WorkerDisplay}"
                                            FontSize="11"
                                            TextColor="{DynamicResource Text2}"/>


                                        <!-- PROJECT -->

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="Project:"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding ProjectDisplay}"
                                            FontSize="11"
                                            TextColor="{DynamicResource Text2}"/>


                                        <!-- ACTION BY -->

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Text="Action by:"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{Binding PerformedByDisplay}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text1}"/>

                                    </Grid>


                                    <!-- DATE / CONDITION -->

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding FullDateLabel}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Condition}"
                                            FontSize="10"
                                            TextColor="{DynamicResource Text3}"/>

                                    </Grid>

                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <CollectionView.Footer>

                    <VerticalStackLayout
                        Spacing="0"
                        Padding="20,12,20,40">


                        <Label
                            Text="{Binding PaginationLabel}"
                            IsVisible="{Binding HasTransactions}"
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            Margin="0,0,0,10"/>


                        <Frame
                            IsVisible="{Binding HasMoreItems}"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="12"
                            Padding="0"
                            HasShadow="False">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                Padding="16,14">

                                <Label
                                    Grid.Column="0"
                                    Text="Load More"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"/>

                                <ActivityIndicator
                                    Grid.Column="1"
                                    IsRunning="{Binding IsLoadingMore}"
                                    IsVisible="{Binding IsLoadingMore}"
                                    Color="{DynamicResource Blue}"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center"/>

                            </Grid>


                            <Frame.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding
                                        Source={x:Reference TransactionsCollection},
                                        Path=BindingContext.LoadMoreCommand}"/>

                            </Frame.GestureRecognizers>

                        </Frame>


                        <Label
                            Text="© 2025 StockGuard"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            Margin="0,16,0,0"/>

                    </VerticalStackLayout>

                </CollectionView.Footer>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
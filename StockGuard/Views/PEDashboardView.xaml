<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             xmlns:services="clr-namespace:StockGuard.Services"
             x:Class="StockGuard.Views.PEDashboardView"
             x:DataType="vm:PEDashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <!--
        PERFORMANCE CHANGES FROM ORIGINAL:
        ─────────────────────────────────────────────────────────────────────
        BEFORE: ScrollView → VerticalStackLayout → BindableLayout (×2)
          • Every tool card and every worker card is inflated on load.
          • BindableLayout has NO virtualization — all items rendered upfront.
          • With 50 workers + 40 borrowed tools → 90+ cards inflated immediately.

        AFTER: Single RefreshView → CollectionView (Header + ItemTemplate + Footer)
          • CollectionView virtualizes — only visible rows are inflated.
          • The two section lists (borrowed tools, worker activity) each use their
            own separate CollectionView nested inside the main CollectionView's
            Header. This avoids nested-scroll conflicts while still virtualizing
            the page-level scroll.
          • Each section has its own "Load More" button in-line, not a global footer.
        ─────────────────────────────────────────────────────────────────────

        STRUCTURE:
          RefreshView
          └─ CollectionView (main scroll, virtualizes section rows)
               ├─ Header
               │    ├─ Page header (greeting, stats)
               │    ├─ "Currently Borrowed Tools" section
               │    │    ├─ CollectionView for RecentTools (10/page)
               │    │    └─ Load More Borrowed / pagination label
               │    └─ "Worker Activity" section
               │         ├─ CollectionView for WorkerActivities (10/page)
               │         └─ Load More Workers / pagination label
               ├─ ItemTemplate  (empty — all content is in the Header)
               └─ Footer (copyright)

        NOTE: The two inner CollectionViews are NOT scroll-enabled
        (VerticalScrollBarVisibility="Never" + no fixed HeightRequest).
        The outer CollectionView owns all scrolling.
    -->

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <!--
                Outer CollectionView — owns the page scroll.
                ItemsSource is bound to an empty/unused list; all real content
                lives in the Header. This gives us the virtualized scroll
                container without requiring a custom layout.
            -->
            <CollectionView
                x:Name="DashboardCollection"
                ItemsSource="{Binding RecentTools}"
                ItemSizingStrategy="MeasureFirstItem">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                </CollectionView.ItemsLayout>

                <!-- ══════════════════════════════════════════════════
                     HEADER — page chrome + both section lists
                     ══════════════════════════════════════════════════ -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,110">

                        <!-- ── PAGE HEADER ──────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="10"
                              Padding="20,52,20,16"
                              BackgroundColor="{DynamicResource BgSurface}">

                            <!-- Col 0: ☰ Hamburger with notification dot -->
                            <Grid Grid.Column="0"
                                  WidthRequest="40" HeightRequest="36">
                                <Button Text="☰"
                                        Command="{Binding OpenFlyoutCommand}"
                                        BackgroundColor="{DynamicResource BgElevated}"
                                        TextColor="{DynamicResource Text2}"
                                        FontSize="18" CornerRadius="8"
                                        WidthRequest="40" HeightRequest="36"
                                        Padding="0"/>
                                <Ellipse Fill="#ef4444"
                                         WidthRequest="8" HeightRequest="8"
                                         HorizontalOptions="End"
                                         VerticalOptions="Start"
                                         Margin="0,3,3,0"
                                         IsVisible="{Binding Source={x:Static services:NotificationState.Instance},
                                                     Path=HasAny}"/>
                            </Grid>

                            <!-- Col 1: Name + role -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding EngineerName}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="Project Engineer"
                                       FontSize="11"
                                       TextColor="{DynamicResource Text3}"/>
                            </VerticalStackLayout>

                            <!-- Col 2: Avatar -->
                            <Frame Grid.Column="2"
                                   BackgroundColor="#1d4ed8"
                                   CornerRadius="22"
                                   WidthRequest="44" HeightRequest="44"
                                   Padding="0" HasShadow="False"
                                   BorderColor="Transparent">
                                <Label Text="{Binding EngineerInitials}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Col 3: Theme toggle -->
                            <Button Grid.Column="3"
                                    Text="{Binding ThemeIcon}"
                                    Command="{Binding ToggleThemeCommand}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="16" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>
                        </Grid>

                        <!-- ── GREETING ────────────────────────────── -->
                        <VerticalStackLayout Padding="20,18,20,0" Spacing="3">
                            <Label FontSize="22" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding GreetingText}"/>
                                        <Span Text=", "/>
                                        <Span Text="Engineer"
                                              TextColor="{DynamicResource Blue}"
                                              FontAttributes="Bold"/>
                                        <Span Text=" 👷‍♂️"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding TodayDate}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Text3}"/>
                        </VerticalStackLayout>

                        <!-- ── LOADING INDICATOR ─────────────────────── -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            HorizontalOptions="Center"
                            Margin="0,20,0,0"/>

                        <!-- ── STATS GRID ──────────────────────────── -->
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10"
                              Padding="20,14">

                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="0,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="🔧" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Total Tools" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="0,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="✅" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding AvailableTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Available" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="0,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="📦" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding BorrowedTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Borrowed" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0" HasShadow="False">
                                <VerticalStackLayout Padding="0,16" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="⚠️" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding DamagedTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Red}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Damaged" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- ══════════════════════════════════════════════════
                             SECTION: CURRENTLY BORROWED TOOLS
                             Uses a nested CollectionView (non-scrolling) so
                             only the visible cards in this section are inflated.
                             The outer CollectionView drives the actual scroll.
                             ══════════════════════════════════════════════════ -->
                        <VerticalStackLayout Padding="20,4,20,0" Spacing="10">

                            <Label Text="Currently Borrowed Tools"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>

                            <!-- Empty state for borrowed tools -->
                            <Frame IsVisible="{Binding NoBorrowedTools}"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderSoft}"
                                   CornerRadius="14" Padding="20"
                                   HasShadow="False">
                                <Label Text="📦  No tools currently borrowed"
                                       FontSize="13"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </Frame>

                            <!--
                                Inner CollectionView for borrowed tools.
                                VerticalScrollBarVisibility="Never" is required —
                                this list must NOT scroll on its own. The outer
                                CollectionView (DashboardCollection) handles all
                                scrolling for the page.
                            -->
                            <CollectionView
                                x:Name="BorrowedToolsCollection"
                                ItemsSource="{Binding RecentTools}"
                                VerticalScrollBarVisibility="Never"
                                ItemSizingStrategy="MeasureFirstItem">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical"
                                                       ItemSpacing="8"/>
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Tool">
                                        <Frame BackgroundColor="{DynamicResource BgCard}"
                                               BorderColor="{DynamicResource BorderColor}"
                                               CornerRadius="14" Padding="0"
                                               HasShadow="False">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Padding="14" ColumnSpacing="12">

                                                <Frame Grid.Column="0"
                                                       BackgroundColor="{DynamicResource BlueSubtle}"
                                                       CornerRadius="12"
                                                       WidthRequest="48" HeightRequest="48"
                                                       Padding="0" HasShadow="False"
                                                       BorderColor="Transparent"
                                                       VerticalOptions="Center">
                                                    <Label Text="{Binding ToolIcon}"
                                                           FontSize="22"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Frame>

                                                <VerticalStackLayout Grid.Column="1"
                                                    Spacing="3" VerticalOptions="Center">
                                                    <Label Text="{Binding ToolName}"
                                                           FontSize="14" FontAttributes="Bold"
                                                           TextColor="{DynamicResource Text1}"/>
                                                    <Label Text="{Binding ToolId}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="{Binding AssignedWorkerName}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource Blue}"/>
                                                </VerticalStackLayout>

                                                <Frame Grid.Column="2"
                                                       BackgroundColor="{DynamicResource BlueSubtle}"
                                                       BorderColor="Transparent"
                                                       CornerRadius="8" Padding="8,4"
                                                       HasShadow="False"
                                                       VerticalOptions="Center">
                                                    <Label Text="{Binding Status}"
                                                           FontSize="11" FontAttributes="Bold"
                                                           TextColor="{DynamicResource Blue}"/>
                                                </Frame>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Borrowed tools pagination -->
                            <Label Text="{Binding BorrowedToolsLabel}"
                                   IsVisible="{Binding HasMoreBorrowedTools}"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"
                                   HorizontalOptions="Center"/>

                            <Frame IsVisible="{Binding HasMoreBorrowedTools}"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0"
                                   HasShadow="False">
                                <Button Text="Load more borrowed tools…"
                                        Command="{Binding LoadMoreBorrowedCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Blue}"
                                        FontSize="13" FontAttributes="Bold"
                                        HeightRequest="46"/>
                            </Frame>

                        </VerticalStackLayout>

                        <!-- ══════════════════════════════════════════════════
                             SECTION: WORKER ACTIVITY
                             ══════════════════════════════════════════════════ -->
                        <VerticalStackLayout Padding="20,20,20,0" Spacing="10">

                            <Label Text="Worker Activity"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>

                            <!-- Empty state for workers -->
                            <Frame IsVisible="{Binding NoWorkerActivity}"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderSoft}"
                                   CornerRadius="14" Padding="20"
                                   HasShadow="False">
                                <Label Text="👷  No worker activity yet"
                                       FontSize="13"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </Frame>

                            <!--
                                Inner CollectionView for worker activity rows.
                                Same non-scrolling pattern as the borrowed tools list.
                            -->
                            <Frame BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0"
                                   HasShadow="False"
                                   IsVisible="{Binding NoWorkerActivity,
                                       Converter={StaticResource InvertBoolConverter}}">

                                <CollectionView
                                    x:Name="WorkerActivityCollection"
                                    ItemsSource="{Binding WorkerActivities}"
                                    VerticalScrollBarVisibility="Never"
                                    ItemSizingStrategy="MeasureFirstItem">

                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical"
                                                           ItemSpacing="0"/>
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:WorkerActivityItem">
                                            <VerticalStackLayout Spacing="0">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      Padding="16,13" ColumnSpacing="12">

                                                    <Frame Grid.Column="0"
                                                           BackgroundColor="#1d4ed8"
                                                           CornerRadius="18"
                                                           WidthRequest="36" HeightRequest="36"
                                                           Padding="0" HasShadow="False"
                                                           BorderColor="Transparent"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding WorkerInitials}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Frame>

                                                    <VerticalStackLayout Grid.Column="1"
                                                        Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding WorkerName}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="{DynamicResource Text1}"/>
                                                        <Label Text="{Binding ToolsLabel}"
                                                               FontSize="11"
                                                               TextColor="{DynamicResource Text3}"/>
                                                    </VerticalStackLayout>

                                                    <Frame Grid.Column="2"
                                                           BackgroundColor="{DynamicResource BgElevated}"
                                                           BorderColor="Transparent"
                                                           CornerRadius="8" Padding="8,4"
                                                           HasShadow="False"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding Status}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{Binding StatusColor}"/>
                                                    </Frame>
                                                </Grid>
                                                <BoxView HeightRequest="1"
                                                         Color="{DynamicResource BorderSoft}"
                                                         Margin="16,0"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Frame>

                            <!-- Worker activity pagination -->
                            <Label Text="{Binding WorkerActivityLabel}"
                                   IsVisible="{Binding HasMoreWorkers}"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"
                                   HorizontalOptions="Center"/>

                            <Frame IsVisible="{Binding HasMoreWorkers}"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="12" Padding="0"
                                   HasShadow="False">
                                <Button Text="Load more workers…"
                                        Command="{Binding LoadMoreWorkersCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Blue}"
                                        FontSize="13" FontAttributes="Bold"
                                        HeightRequest="46"/>
                            </Frame>

                        </VerticalStackLayout>

                        <Label Text="© 2025 StockGuard — Equipment Management Platform"
                               FontSize="10"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0"/>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!--
                    ItemTemplate is intentionally empty.
                    RecentTools is bound to the outer CollectionView's ItemsSource
                    only so the Header updates when the collection changes.
                    All actual rendering happens inside the Header via the inner
                    BorrowedToolsCollection and WorkerActivityCollection.
                -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <BoxView HeightRequest="0"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- ── FLOATING QR SCAN BUTTON ──────────────────────────────────── -->
        <!--
            Sits outside the RefreshView on the Grid so it always floats
            above the scroll content regardless of scroll position.
        -->
 
        
        <Grid VerticalOptions="End"
              HorizontalOptions="Center"
              Margin="0,0,0,24"
              RowDefinitions="Auto,Auto"
              RowSpacing="5">
            <Frame Grid.Row="0"
                   WidthRequest="62" HeightRequest="62"
                   CornerRadius="31"
                   BackgroundColor="{DynamicResource Blue}"
                   HasShadow="True"
                   BorderColor="Transparent"
                   Padding="0"
                   HorizontalOptions="Center">
                <Button Text="📷"
                        Command="{Binding ScanQrCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="26" Padding="0"
                        WidthRequest="62" HeightRequest="62"/>
            </Frame>
            <Label Grid.Row="1"
                   Text="Scan QR"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="{DynamicResource Text2}"
                   HorizontalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>

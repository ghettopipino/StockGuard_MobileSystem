<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    xmlns:services="clr-namespace:StockGuard.Services"
    x:Class="StockGuard.Views.PEDashboardView"
    x:DataType="vm:PEDashboardViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <!-- ═══════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════ -->

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,115">


                    <!-- ═══════════════════════════════════════
                         HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">


                        <!-- MENU -->
                        <Grid
                            Grid.Column="0"
                            WidthRequest="40"
                            HeightRequest="40">

                            <Button
                                Text="&#xf0c9;"
                                FontFamily="FontAwesome"
                                Command="{Binding OpenFlyoutCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16"
                                CornerRadius="10"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"/>

                            <!-- NOTIFICATION DOT -->
                            <Ellipse
                                Fill="#ef4444"
                                WidthRequest="8"
                                HeightRequest="8"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,3,3,0"
                                IsVisible="{Binding Source={x:Static services:NotificationState.Instance},
                                                    Path=HasAny}"/>

                        </Grid>


                        <!-- USER INFORMATION -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding EngineerName}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                LineBreakMode="TailTruncation"/>

                            <Label
                                Text="Project Engineer"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>


                        <!-- USER AVATAR -->
                        <Frame
                            Grid.Column="2"
                            BackgroundColor="{DynamicResource Blue}"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            HasShadow="False"
                            BorderColor="Transparent">

                            <Label
                                Text="{Binding EngineerInitials}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Frame>


                        <!-- THEME -->
                        <Button
                            Grid.Column="3"
                            Text="&#xf186;"
                            FontFamily="FontAwesome"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>



                    <!-- ═══════════════════════════════════════
                         GREETING
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}">

                            <Label.FormattedText>

                                <FormattedString>

                                    <Span
                                        Text="{Binding GreetingText}"/>

                                    <Span Text=", "/>

                                    <Span
                                        Text="Engineer"
                                        TextColor="{DynamicResource Blue}"
                                        FontAttributes="Bold"/>

                                </FormattedString>

                            </Label.FormattedText>

                        </Label>

                        <Label
                            Text="{Binding TodayDate}"
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         LOADING
                         ═══════════════════════════════════════ -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,16,0,0"/>



                    <!-- ═══════════════════════════════════════
                         INVENTORY OVERVIEW
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="10">


                        <!-- SECTION HEADER -->
                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Inventory Overview"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Text="&#xf201;"
                                    FontFamily="FontAwesome"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Text="Live inventory"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                            </HorizontalStackLayout>

                        </Grid>


                        <!-- STATS GRID -->
                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">


                            <!-- ═══════════════════════════════
                                 TOTAL TOOLS
                                 ═══════════════════════════════ -->

                            <Frame
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="14"
                                Padding="14"
                                HasShadow="False">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Total Tools"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>


                                    <!-- ICON -->
                                    <Frame
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="10"
                                        Padding="0"
                                        HasShadow="False"
                                        BorderColor="Transparent"
                                        BackgroundColor="{DynamicResource BlueSubtle}">

                                        <Label
                                            Text="&#xf0ad;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Frame>


                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding TotalTools}"
                                        FontSize="25"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        Margin="0,4,0,0"/>

                                </Grid>

                            </Frame>



                            <!-- ═══════════════════════════════
                                 AVAILABLE
                                 ═══════════════════════════════ -->

                            <Frame
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="14"
                                Padding="14"
                                HasShadow="False">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Available"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>


                                    <Frame
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="10"
                                        Padding="0"
                                        HasShadow="False"
                                        BorderColor="Transparent"
                                        BackgroundColor="{DynamicResource GreenSubtle}">

                                        <Label
                                            Text="&#xf058;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Frame>


                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding AvailableTools}"
                                        FontSize="25"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        Margin="0,4,0,0"/>

                                </Grid>

                            </Frame>



                            <!-- ═══════════════════════════════
                                 BORROWED
                                 ═══════════════════════════════ -->

                            <Frame
                                Grid.Row="1"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="14"
                                Padding="14"
                                HasShadow="False">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Borrowed"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>


                                    <Frame
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="10"
                                        Padding="0"
                                        HasShadow="False"
                                        BorderColor="Transparent"
                                        BackgroundColor="{DynamicResource AmberSubtle}">

                                        <Label
                                            Text="&#xf466;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Frame>


                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding BorrowedTools}"
                                        FontSize="25"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        Margin="0,4,0,0"/>

                                </Grid>

                            </Frame>



                            <!-- ═══════════════════════════════
                                 DAMAGED
                                 ═══════════════════════════════ -->

                            <Frame
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource BgCard}"
                                BorderColor="{DynamicResource BorderColor}"
                                CornerRadius="14"
                                Padding="14"
                                HasShadow="False">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="Damaged"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"/>


                                    <Frame
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="10"
                                        Padding="0"
                                        HasShadow="False"
                                        BorderColor="Transparent"
                                        BackgroundColor="{DynamicResource RedSubtle}">

                                        <Label
                                            Text="&#xf071;"
                                            FontFamily="FontAwesome"
                                            FontSize="15"
                                            TextColor="{DynamicResource Red}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Frame>


                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding DamagedTools}"
                                        FontSize="25"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Red}"
                                        Margin="0,4,0,0"/>

                                </Grid>

                            </Frame>

                        </Grid>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         CURRENTLY BORROWED
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,24,20,0"
                        Spacing="10">


                        <!-- SECTION HEADER -->
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8">

                            <Frame
                                Grid.Column="0"
                                WidthRequest="30"
                                HeightRequest="30"
                                CornerRadius="8"
                                Padding="0"
                                HasShadow="False"
                                BorderColor="Transparent"
                                BackgroundColor="{DynamicResource AmberSubtle}">

                                <Label
                                    Text="&#xf466;"
                                    FontFamily="FontAwesome"
                                    FontSize="12"
                                    TextColor="{DynamicResource Amber}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Frame>

                            <Label
                                Grid.Column="1"
                                Text="Currently Borrowed"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="2"
                                Text="{Binding BorrowedToolsLabel}"
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                        </Grid>



                        <!-- EMPTY STATE -->
                        <Frame
                            IsVisible="{Binding NoBorrowedTools}"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderSoft}"
                            CornerRadius="14"
                            Padding="20"
                            HasShadow="False">

                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center">

                                <Frame
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Padding="0"
                                    HasShadow="False"
                                    BorderColor="Transparent"
                                    BackgroundColor="{DynamicResource BgElevated}">

                                    <Label
                                        Text="&#xf466;"
                                        FontFamily="FontAwesome"
                                        FontSize="16"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Frame>

                                <Label
                                    Text="No borrowed equipment"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Equipment assigned to workers will appear here."
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Frame>



                        <!-- BORROWED TOOLS -->
                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding RecentTools}"
                            Spacing="8">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:Tool">

                                    <Frame
                                        BackgroundColor="{DynamicResource BgCard}"
                                        BorderColor="{DynamicResource BorderColor}"
                                        CornerRadius="14"
                                        Padding="0"
                                        HasShadow="False">

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12"
                                            Padding="14">


                                            <!-- TOOL ICON -->
                                            <Frame
                                                Grid.Column="0"
                                                BackgroundColor="{DynamicResource BlueSubtle}"
                                                BorderColor="Transparent"
                                                CornerRadius="10"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                Padding="0"
                                                HasShadow="False"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="&#xf0ad;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="15"
                                                    TextColor="{DynamicResource Blue}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>

                                            </Frame>


                                            <!-- INFORMATION -->
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding ToolName}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"
                                                    LineBreakMode="TailTruncation"/>

                                                <HorizontalStackLayout
                                                    Spacing="5">

                                                    <Label
                                                        Text="&#xf02a;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </HorizontalStackLayout>


                                                <HorizontalStackLayout
                                                    Spacing="5">

                                                    <Label
                                                        Text="&#xf007;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Blue}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding AssignedWorkerName}"
                                                        FontSize="11"
                                                        TextColor="{DynamicResource Blue}"
                                                        LineBreakMode="TailTruncation"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>


                                            <!-- STATUS -->
                                            <Frame
                                                Grid.Column="2"
                                                BackgroundColor="{DynamicResource AmberSubtle}"
                                                BorderColor="Transparent"
                                                CornerRadius="8"
                                                Padding="8,4"
                                                HasShadow="False"
                                                VerticalOptions="Center">

                                                <HorizontalStackLayout
                                                    Spacing="4">

                                                    <Label
                                                        Text="&#xf466;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="8"
                                                        TextColor="{DynamicResource Amber}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding Status}"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Amber}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>

                                            </Frame>

                                        </Grid>

                                    </Frame>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>



                        <!-- LOAD MORE -->
                        <Button
                            Text="Load More"
                            Command="{Binding LoadMoreBorrowedCommand}"
                            IsVisible="{Binding HasMoreBorrowedTools}"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{DynamicResource Blue}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44"/>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         WORKER ACTIVITY
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,24,20,0"
                        Spacing="10">


                        <!-- SECTION HEADER -->
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8">

                            <Frame
                                Grid.Column="0"
                                WidthRequest="30"
                                HeightRequest="30"
                                CornerRadius="8"
                                Padding="0"
                                HasShadow="False"
                                BorderColor="Transparent"
                                BackgroundColor="{DynamicResource BlueSubtle}">

                                <Label
                                    Text="&#xf0c0;"
                                    FontFamily="FontAwesome"
                                    FontSize="12"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Frame>

                            <Label
                                Grid.Column="1"
                                Text="Worker Activity"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="2"
                                Text="{Binding WorkerActivityLabel}"
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                        </Grid>



                        <!-- EMPTY STATE -->
                        <Frame
                            IsVisible="{Binding NoWorkerActivity}"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderSoft}"
                            CornerRadius="14"
                            Padding="20"
                            HasShadow="False">

                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="8">

                                <Frame
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    Padding="0"
                                    HasShadow="False"
                                    BorderColor="Transparent"
                                    BackgroundColor="{DynamicResource BgElevated}">

                                    <Label
                                        Text="&#xf0c0;"
                                        FontFamily="FontAwesome"
                                        FontSize="15"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Frame>

                                <Label
                                    Text="No worker activity yet"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Frame>



                        <!-- WORKER LIST -->
                        <Frame
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False"
                            IsVisible="{Binding NoWorkerActivity,
                                Converter={StaticResource InvertBoolConverter}}">

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding WorkerActivities}"
                                Spacing="0">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="models:WorkerActivityItem">

                                        <VerticalStackLayout
                                            Spacing="0">

                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="12"
                                                Padding="14,12">


                                                <!-- AVATAR -->
                                                <Frame
                                                    Grid.Column="0"
                                                    BackgroundColor="{DynamicResource Blue}"
                                                    CornerRadius="18"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    HasShadow="False"
                                                    BorderColor="Transparent"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding WorkerInitials}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>

                                                </Frame>


                                                <!-- WORKER -->
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding WorkerName}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"
                                                        LineBreakMode="TailTruncation"/>

                                                    <HorizontalStackLayout
                                                        Spacing="5">

                                                        <Label
                                                            Text="&#xf0ad;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <Label
                                                            Text="{Binding ToolsLabel}"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"/>

                                                    </HorizontalStackLayout>

                                                </VerticalStackLayout>


                                                <!-- STATUS -->
                                                <Frame
                                                    Grid.Column="2"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    BorderColor="Transparent"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    HasShadow="False"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Status}"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding StatusColor}"/>

                                                </Frame>

                                            </Grid>


                                            <!-- DIVIDER -->
                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"
                                                Margin="14,0"/>

                                        </VerticalStackLayout>

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </Frame>



                        <!-- LOAD MORE -->
                        <Button
                            Text="Load More"
                            Command="{Binding LoadMoreWorkersCommand}"
                            IsVisible="{Binding HasMoreWorkers}"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{DynamicResource Blue}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44"/>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         FOOTER
                         ═══════════════════════════════════════ -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,28,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Equipment Management"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>



        <!-- ═══════════════════════════════════════════════════
             FLOATING QR SCANNER
             ═══════════════════════════════════════════════════ -->

        <Grid
            VerticalOptions="End"
            HorizontalOptions="Center"
            Margin="0,0,0,24"
            RowDefinitions="Auto,Auto"
            RowSpacing="5">


            <!-- QR BUTTON -->
            <Frame
                Grid.Row="0"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{DynamicResource Blue}"
                HasShadow="True"
                BorderColor="Transparent"
                Padding="0"
                HorizontalOptions="Center">

                <Button
                    Text="&#xf029;"
                    FontFamily="FontAwesome"
                    Command="{Binding ScanQrCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="21"
                    Padding="0"
                    WidthRequest="60"
                    HeightRequest="60"/>

            </Frame>


            <Label
                Grid.Row="1"
                Text="Scan QR"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="{DynamicResource Text2}"
                HorizontalOptions="Center"/>

        </Grid>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    x:Class="StockGuard.Views.ResetPasswordView"
    x:DataType="vm:ResetPasswordViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,55,24,40"
            Spacing="0"
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center">


            <!-- ================================================== -->
            <!-- BRAND -->
            <!-- ================================================== -->

            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Center">

                <Label
                    Text="&#xf3ed;"
                    FontFamily="FontAwesome"
                    FontSize="34"
                    TextColor="{DynamicResource Blue}"
                    HorizontalOptions="Center"/>

                <Label
                    Text="StockGuard"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource Text1}"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Equipment monitoring and accountability"
                    FontSize="11"
                    TextColor="{DynamicResource Text3}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>


            <!-- ================================================== -->
            <!-- RESET PASSWORD CARD -->
            <!-- ================================================== -->

            <Border
                BackgroundColor="{DynamicResource BgCard}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 16"
                Padding="20"
                Margin="0,28,0,0">

                <VerticalStackLayout Spacing="16">


                    <!-- TITLE -->

                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Reset Password"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Enter the verification code sent to your email and create a new password."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"
                            LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>


                    <!-- ERROR -->

                    <Border
                        IsVisible="{Binding HasError}"
                        BackgroundColor="{DynamicResource RedBg}"
                        Stroke="{DynamicResource Red}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf071;"
                                FontFamily="FontAwesome"
                                FontSize="11"
                                TextColor="{DynamicResource Red}"
                                VerticalOptions="Start"/>

                            <Label
                                Grid.Column="1"
                                Text="{Binding ErrorMessage}"
                                FontSize="11"
                                TextColor="{DynamicResource Red}"
                                LineBreakMode="WordWrap"/>

                        </Grid>

                    </Border>


                    <!-- VERIFICATION CODE -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Verification Code"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Border
                            BackgroundColor="{DynamicResource InputBg}"
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesome"
                                    FontSize="11"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding VerificationCode}"
                                    Placeholder="Enter 6-digit code"
                                    Keyboard="Numeric"
                                    MaxLength="6"
                                    PlaceholderColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    BackgroundColor="Transparent"
                                    FontSize="12"
                                    HeightRequest="46"/>

                            </Grid>

                        </Border>

                        <Label
                            Text="The verification code expires in 10 minutes."
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- NEW PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="New Password"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Border
                            BackgroundColor="{DynamicResource InputBg}"
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf023;"
                                    FontFamily="FontAwesome"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding NewPassword}"
                                    Placeholder="Enter new password"
                                    IsPassword="True"
                                    PlaceholderColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    BackgroundColor="Transparent"
                                    FontSize="12"
                                    HeightRequest="46"/>

                            </Grid>

                        </Border>

                        <Label
                            Text="Use at least 6 characters."
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- CONFIRM PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Confirm Password"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Border
                            BackgroundColor="{DynamicResource InputBg}"
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf023;"
                                    FontFamily="FontAwesome"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding ConfirmPassword}"
                                    Placeholder="Re-enter new password"
                                    IsPassword="True"
                                    PlaceholderColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    BackgroundColor="Transparent"
                                    FontSize="12"
                                    HeightRequest="46"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- RESET PASSWORD -->

                    <Button
                        Text="Reset Password"
                        Command="{Binding ResetPasswordCommand}"
                        BackgroundColor="{DynamicResource Blue}"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="10"/>


                    <!-- LOADING -->

                    <HorizontalStackLayout
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center"
                        Spacing="8">

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            WidthRequest="18"
                            HeightRequest="18"/>

                        <Label
                            Text="Updating password..."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>


                    <!-- BACK -->

                    <Button
                        Text="Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Blue}"
                        FontSize="11"
                        FontAttributes="Bold"
                        Padding="0"
                        HeightRequest="32"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>


            <!-- ================================================== -->
            <!-- FOOTER -->
            <!-- ================================================== -->

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="6"
                Margin="0,26,0,0">

                <Label
                    Text="&#xf3ed;"
                    FontFamily="FontAwesome"
                    FontSize="9"
                    TextColor="{DynamicResource Text3}"
                    VerticalOptions="Center"/>

                <Label
                    Text="StockGuard · Secure Equipment Access"
                    FontSize="10"
                    TextColor="{DynamicResource Text3}"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
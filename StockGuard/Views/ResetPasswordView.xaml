<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="StockGuard.Views.ResetPasswordView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout
            Padding="28"
            Spacing="20"
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!-- BACK BUTTON -->

            <Button
                Text="← Back"
                Command="{Binding GoBackCommand}"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource Text2}"
                FontSize="13"
                Padding="0"
                HorizontalOptions="Start"/>


            <!-- HEADER -->

            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Reset Password"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource Text1}"/>

                <Label
                    Text="Enter the verification code sent to your email, then create your new password."
                    FontSize="13"
                    TextColor="{DynamicResource Text2}"/>

            </VerticalStackLayout>


            <!-- ERROR -->

            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Stroke="#EF4444"
                StrokeThickness="1"
                BackgroundColor="#15EF4444">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF4444"
                    FontSize="12"/>

            </Border>


            <!-- FORM -->

            <Border
                Padding="20"
                Stroke="{DynamicResource Border}"
                StrokeThickness="1"
                BackgroundColor="{DynamicResource CardBg}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">


                    <!-- VERIFICATION CODE -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Verification Code"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Entry
                            Text="{Binding VerificationCode}"
                            Placeholder="Enter 6-digit code"
                            Keyboard="Numeric"
                            MaxLength="6"/>

                    </VerticalStackLayout>


                    <!-- NEW PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="New Password"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Entry
                            Text="{Binding NewPassword}"
                            Placeholder="Enter new password"
                            IsPassword="True"/>

                    </VerticalStackLayout>


                    <!-- CONFIRM PASSWORD -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Confirm Password"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Entry
                            Text="{Binding ConfirmPassword}"
                            Placeholder="Confirm new password"
                            IsPassword="True"/>

                    </VerticalStackLayout>


                    <!-- RESET BUTTON -->

                    <Button
                        Text="Reset Password"
                        Command="{Binding ResetPasswordCommand}"
                        BackgroundColor="{DynamicResource Blue}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="10"/>

                    <!-- LOADING -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
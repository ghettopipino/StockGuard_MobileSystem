<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.WorkerDashboardView"
    x:DataType="vm:WorkerDashboardViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Padding="20,52,20,40"
                    Spacing="16">

                    <!-- ================================================== -->
                    <!-- HEADER                                             -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                Text="{Binding GreetingText}"
                                FontSize="13"
                                TextColor="{DynamicResource Text3}"/>

                            <Label
                                Text="{Binding WorkerName}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Logout"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Red}"
                            FontSize="13"/>

                    </Grid>

                    <!-- ================================================== -->
                    <!-- ACTIVE PROJECT                                     -->
                    <!-- ================================================== -->

                    <Label
                        Text="No Active Project"
                        IsVisible="{Binding NoActiveProject}"
                        FontSize="13"
                        TextColor="{DynamicResource Text3}"/>

                    <Border
                        IsVisible="{Binding HasActiveProject}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource BgCard}"
                        Padding="14">

                        <VerticalStackLayout
                            Spacing="6">

                            <Label
                                Text="{Binding ActiveProjectName}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="{Binding ActiveProjectLocation}"
                                FontSize="12"
                                TextColor="{DynamicResource Text3}"/>

                            <Label
                                Text="{Binding ActiveProjectDuration,
                                    StringFormat='Started {0}'}"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                            <Label
                                Text="{Binding DeploymentStatusText}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{Binding DeploymentStatusColor}"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- ================================================== -->
                    <!-- TOOL COUNT                                         -->
                    <!-- ================================================== -->

                    <Label
                        FontSize="13"
                        TextColor="{DynamicResource Text2}">

                        <Label.FormattedText>

                            <FormattedString>

                                <Span
                                    Text="{Binding AssignedCount}"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Blue}"/>

                                <Span
                                    Text=" tools"/>

                            </FormattedString>

                        </Label.FormattedText>

                    </Label>

                    <!-- ================================================== -->
                    <!-- PENDING ASSIGNMENTS                                -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        Spacing="10"
                        IsVisible="{Binding HasPendingAssignments}">

                        <Label
                            Text="Pending Assignments"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding PendingAssignments}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:PendingAssignmentItem">

                                    <Border
                                        Stroke="{DynamicResource Amber}"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Padding="14">

                                        <VerticalStackLayout
                                            Spacing="8">

                                            <Label
                                                Text="{Binding ToolName}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"/>

                                            <Label
                                                Text="{Binding ToolId}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}"/>

                                            <Label
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}">

                                                <Label.Text>

                                                    <MultiBinding
                                                        StringFormat="Assigned by {0} · {1}">

                                                        <Binding
                                                            Path="AssignedByName"/>

                                                        <Binding
                                                            Path="ProjectName"/>

                                                    </MultiBinding>

                                                </Label.Text>

                                            </Label>

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="10">

                                                <Button
                                                    Grid.Column="0"
                                                    Text="Decline"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}},
                                                                      Path=DeclineAssignmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Red}"
                                                    BorderColor="{DynamicResource Red}"
                                                    BorderWidth="1"
                                                    FontAttributes="Bold"
                                                    HeightRequest="40"/>

                                                <Button
                                                    Grid.Column="1"
                                                    Text="Accept"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}},
                                                                      Path=AcceptAssignmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{DynamicResource Blue}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    HeightRequest="40"/>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ================================================== -->
                    <!-- WORKER REQUESTS                                    -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        IsVisible="{Binding HasWorkerRequests}"
                        Spacing="10">

                        <!-- TITLE + COUNT -->

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Worker Requests"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource Red}"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,3"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding WorkerRequestCount}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Border>

                        </Grid>

                        <!-- REQUEST CARD -->

                        <Border
                            Stroke="{DynamicResource Blue}"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="14">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding OpenWorkerRequestsCommand}"/>

                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="5">

                                    <Label
                                        Text="Equipment Requests"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        Text="{Binding WorkerRequestMessage}"
                                        FontSize="12"
                                        TextColor="{DynamicResource Text3}"
                                        LineBreakMode="WordWrap"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Spacing="2">

                                    <Label
                                        Text="View"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="End"/>

                                    <Label
                                        Text="›"
                                        FontSize="20"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="End"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                    <!-- ================================================== -->
                    <!-- MY TOOLS                                           -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="My Tools"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding AssignedCount,
                                StringFormat='{0} tool(s)'}"
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </Grid>

                    <Label
                        Text="No tools assigned yet"
                        IsVisible="{Binding HasNoTools}"
                        FontSize="13"
                        TextColor="{DynamicResource Text3}"/>

                    <!-- ================================================== -->
                    <!-- TOOL CARDS                                         -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding AssignedTools}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:ToolAssignmentItem">

                                <Border
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="14">

                                    <Border.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}},
                                                              Path=ViewToolCommand}"
                                            CommandParameter="{Binding .}"/>

                                    </Border.GestureRecognizers>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="3">

                                            <Label
                                                Text="{Binding ToolName}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"/>

                                            <Label
                                                Text="{Binding ToolId}"
                                                FontSize="12"
                                                TextColor="{DynamicResource Text3}"/>

                                            <Label
                                                Text="{Binding BorrowDuration}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Blue}"/>

                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            VerticalOptions="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <!-- ================================================== -->
                    <!-- TOOL PAGINATION                                    -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        IsVisible="{Binding ShowToolsPager}">

                        <Button
                            Grid.Column="0"
                            Text="‹ Prev"
                            Command="{Binding ToolsPrevCommand}"
                            IsEnabled="{Binding CanGoToolsPrev}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="12"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding ToolsPageLabel}"
                            FontSize="12"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                        <Button
                            Grid.Column="2"
                            Text="Next ›"
                            Command="{Binding ToolsNextCommand}"
                            IsEnabled="{Binding CanGoToolsNext}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="12"/>

                    </Grid>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

        <!-- ====================================================== -->
        <!-- FLOATING QR BUTTON                                     -->
        <!-- ====================================================== -->

        <Grid
            VerticalOptions="End"
            HorizontalOptions="Center"
            Margin="0,0,0,30"
            InputTransparent="False">

            <Frame
                BackgroundColor="{DynamicResource Blue}"
                CornerRadius="30"
                WidthRequest="60"
                HeightRequest="60"
                Padding="0"
                HasShadow="True"
                BorderColor="Transparent"
                InputTransparent="False">

                <Label
                    Text="📷"
                    FontSize="26"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    InputTransparent="True"/>

                <Frame.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding ScanQrCommand}"/>

                </Frame.GestureRecognizers>

            </Frame>

        </Grid>

    </Grid>

</ContentPage>
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Transfer"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Transferred" FontSize="11" FontAttributes="Bold"

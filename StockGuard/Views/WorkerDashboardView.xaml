<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.WorkerDashboardView"
    x:DataType="vm:WorkerDashboardViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <!-- ====================================================== -->
        <!-- MAIN CONTENT                                           -->
        <!-- ====================================================== -->

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Padding="20,52,20,110"
                    Spacing="0">


                    <!-- ================================================== -->
                    <!-- HEADER                                             -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding GreetingText}"
                                FontSize="12"
                                TextColor="{DynamicResource Text3}"/>

                            <Label
                                Text="{Binding WorkerName}"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>


                        <!-- LOGOUT -->

                        <Button
                            Grid.Column="1"
                            Text="Logout"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Red}"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="40"
                            Padding="12,0"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- ACTIVE PROJECT                                     -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        Margin="0,24,0,10">

                        <Label
                            Grid.Column="0"
                            Text="Active Project"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding AssignedCount,
                                StringFormat='{0} tool(s)'}"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- NO PROJECT -->

                    <Border
                        IsVisible="{Binding NoActiveProject}"
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        Padding="20">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12">

                            <Label
                                Grid.Column="0"
                                Text="&#xf1ad;"
                                FontFamily="FontAwesome"
                                FontSize="20"
                                TextColor="{DynamicResource Text3}"
                                WidthRequest="34"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    Text="No Active Project"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"/>

                                <Label
                                    Text="You are not currently assigned to an active project."
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    LineBreakMode="WordWrap"/>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- ACTIVE PROJECT CARD -->

                    <Border
                        IsVisible="{Binding HasActiveProject}"
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">


                            <!-- PROJECT HEADER -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf1ad;"
                                    FontFamily="FontAwesome"
                                    FontSize="20"
                                    TextColor="{DynamicResource Blue}"
                                    WidthRequest="36"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"/>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding ActiveProjectName}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        LineBreakMode="TailTruncation"/>


                                    <!-- LOCATION -->

                                    <HorizontalStackLayout Spacing="6">

                                        <Label
                                            Text="&#xf3c5;"
                                            FontFamily="FontAwesome"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"/>

                                        <Label
                                            Text="{Binding ActiveProjectLocation}"
                                            FontSize="11"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation"/>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Grid>


                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource BorderSoft}"/>


                            <!-- PROJECT DETAILS -->

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4">

                                    <Label
                                        Text="Project Duration"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Text="{Binding ActiveProjectDuration,
                                            StringFormat='Started {0}'}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text2}"/>

                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="Status"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="End"/>

                                    <Label
                                        Text="{Binding DeploymentStatusText}"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{Binding DeploymentStatusColor}"
                                        HorizontalOptions="End"/>

                                </VerticalStackLayout>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================== -->
                    <!-- TOOL SUMMARY                                       -->
                    <!-- ================================================== -->

                    <Border
                        BackgroundColor="{DynamicResource BlueSubtle}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14"
                        Margin="0,10,0,0">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="11">

                            <Label
                                Grid.Column="0"
                                Text="&#xf0ad;"
                                FontFamily="FontAwesome"
                                FontSize="17"
                                TextColor="{DynamicResource Blue}"
                                WidthRequest="30"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">

                                <Label
                                    Text="Equipment in Your Custody"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    FontSize="15"
                                    TextColor="{DynamicResource Text1}">

                                    <Label.FormattedText>

                                        <FormattedString>

                                            <Span
                                                Text="{Binding AssignedCount}"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Blue}"/>

                                            <Span Text=" tool(s) assigned"/>

                                        </FormattedString>

                                    </Label.FormattedText>

                                </Label>

                            </VerticalStackLayout>

                        </Grid>

                    </Border>


                    <!-- ================================================== -->
                    <!-- PENDING ASSIGNMENTS                                -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        IsVisible="{Binding HasPendingAssignments}"
                        Spacing="10"
                        Margin="0,24,0,0">


                        <!-- SECTION TITLE -->

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Pending Assignments"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Action required"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Amber}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <!-- ASSIGNMENT LIST -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding PendingAssignments}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:PendingAssignmentItem">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource Amber}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="16">

                                        <VerticalStackLayout Spacing="12">


                                            <!-- TOOL -->

                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="11">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf0ad;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="17"
                                                    TextColor="{DynamicResource Amber}"
                                                    WidthRequest="32"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    VerticalOptions="Center"/>


                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3">

                                                    <Label
                                                        Text="{Binding ToolName}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"/>

                                                    <Label
                                                        Text="{Binding ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>

                                            </Grid>


                                            <!-- ASSIGNMENT DETAILS -->

                                            <HorizontalStackLayout Spacing="6">

                                                <Label
                                                    Text="&#xf007;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="9"
                                                    TextColor="{DynamicResource Text3}"
                                                    VerticalOptions="Center"/>

                                                <Label
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"
                                                    LineBreakMode="TailTruncation">

                                                    <Label.Text>

                                                        <MultiBinding
                                                            StringFormat="Assigned by {0} · {1}">

                                                            <Binding
                                                                Path="AssignedByName"/>

                                                            <Binding
                                                                Path="ProjectName"/>

                                                        </MultiBinding>

                                                    </Label.Text>

                                                </Label>

                                            </HorizontalStackLayout>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- ACTIONS -->

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="10">

                                                <Button
                                                    Grid.Column="0"
                                                    Text="Decline"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}},
                                                                      Path=DeclineAssignmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{DynamicResource RedBg}"
                                                    TextColor="{DynamicResource Red}"
                                                    BorderColor="{DynamicResource Red}"
                                                    BorderWidth="1"
                                                    CornerRadius="10"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HeightRequest="42"/>


                                                <Button
                                                    Grid.Column="1"
                                                    Text="Accept"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}},
                                                                      Path=AcceptAssignmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{DynamicResource Blue}"
                                                    TextColor="White"
                                                    CornerRadius="10"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HeightRequest="42"/>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- WORKER REQUESTS                                    -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        IsVisible="{Binding HasWorkerRequests}"
                        Spacing="10"
                        Margin="0,24,0,0">


                        <!-- TITLE -->

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Worker Requests"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>


                            <!-- REQUEST COUNT -->

                            <Border
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource RedBg}"
                                Stroke="{DynamicResource Red}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 9"
                                Padding="8,3"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding WorkerRequestCount}"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Red}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Border>

                        </Grid>


                        <!-- REQUEST CARD -->

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Padding="16">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding OpenWorkerRequestsCommand}"/>

                            </Border.GestureRecognizers>


                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">


                                <!-- ICON -->

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf0e0;"
                                    FontFamily="FontAwesome"
                                    FontSize="18"
                                    TextColor="{DynamicResource Blue}"
                                    WidthRequest="32"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    VerticalOptions="Center"/>


                                <!-- DETAILS -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="Equipment Requests"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"/>

                                    <Label
                                        Text="{Binding WorkerRequestMessage}"
                                        FontSize="11"
                                        TextColor="{DynamicResource Text3}"
                                        LineBreakMode="WordWrap"/>

                                </VerticalStackLayout>


                                <!-- ARROW -->

                                <Label
                                    Grid.Column="2"
                                    Text="&#xf054;"
                                    FontFamily="FontAwesome"
                                    FontSize="12"
                                    TextColor="{DynamicResource Blue}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- MY TOOLS                                           -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        Margin="0,24,0,10">

                        <Label
                            Grid.Column="0"
                            Text="My Tools"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding AssignedCount,
                                StringFormat='{0} tool(s)'}"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- NO TOOLS -->

                    <Border
                        IsVisible="{Binding HasNoTools}"
                        BackgroundColor="{DynamicResource BgCard}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        Padding="24">

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="7">

                            <Label
                                Text="&#xf0ad;"
                                FontFamily="FontAwesome"
                                FontSize="22"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No tools assigned"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Equipment assigned to you will appear here."
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- ================================================== -->
                    <!-- TOOL CARDS                                         -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding AssignedTools}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:ToolAssignmentItem">

                                <Border
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="15">

                                    <Border.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}},
                                                              Path=ViewToolCommand}"
                                            CommandParameter="{Binding .}"/>

                                    </Border.GestureRecognizers>


                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="11">


                                        <!-- TOOL ICON -->

                                        <Label
                                            Grid.Column="0"
                                            Text="&#xf0ad;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Blue}"
                                            WidthRequest="32"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            VerticalOptions="Center"/>


                                        <!-- TOOL INFORMATION -->

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding ToolName}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"
                                                LineBreakMode="TailTruncation"/>

                                            <Label
                                                Text="{Binding ToolId}"
                                                FontSize="10"
                                                TextColor="{DynamicResource Text3}"/>


                                            <HorizontalStackLayout Spacing="5">

                                                <Label
                                                    Text="&#xf017;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="8"
                                                    TextColor="{DynamicResource Blue}"
                                                    VerticalOptions="Center"/>

                                                <Label
                                                    Text="{Binding BorrowDuration}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Blue}"
                                                    VerticalOptions="Center"/>

                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>


                                        <!-- STATUS + ARROW -->

                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Spacing="6"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Status}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Blue}"
                                                HorizontalOptions="End"/>

                                            <Label
                                                Text="&#xf054;"
                                                FontFamily="FontAwesome"
                                                FontSize="9"
                                                TextColor="{DynamicResource Text3}"
                                                HorizontalOptions="End"/>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- TOOL PAGINATION                                    -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="8"
                        IsVisible="{Binding ShowToolsPager}"
                        Margin="0,14,0,0">


                        <!-- PREVIOUS -->

                        <Button
                            Grid.Column="0"
                            Text="&#xf053;"
                            FontFamily="FontAwesome"
                            Command="{Binding ToolsPrevCommand}"
                            IsEnabled="{Binding CanGoToolsPrev}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="12"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>


                        <!-- PAGE -->

                        <Label
                            Grid.Column="1"
                            Text="{Binding ToolsPageLabel}"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>


                        <!-- NEXT -->

                        <Button
                            Grid.Column="2"
                            Text="&#xf054;"
                            FontFamily="FontAwesome"
                            Command="{Binding ToolsNextCommand}"
                            IsEnabled="{Binding CanGoToolsNext}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="12"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- FOOTER                                             -->
                    <!-- ================================================== -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,30,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Worker Dashboard"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>


                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>


        <!-- ====================================================== -->
        <!-- FLOATING QR SCANNER BUTTON                             -->
        <!-- ====================================================== -->

        <Border
    VerticalOptions="End"
    HorizontalOptions="Center"
    Margin="0,0,0,28"
    WidthRequest="60"
    HeightRequest="60"
    BackgroundColor="{DynamicResource Blue}"
    Stroke="Transparent"
    StrokeShape="RoundRectangle 30">

            <Border.Shadow>
                <Shadow
            Brush="Black"
            Offset="0,4"
            Radius="12"
            Opacity="0.25"/>
            </Border.Shadow>

            <Border.GestureRecognizers>
                <TapGestureRecognizer
            Command="{Binding ScanQrCommand}"/>
            </Border.GestureRecognizers>

            <Label
        Text="&#xf029;"
        FontFamily="FontAwesome"
        FontSize="22"
        TextColor="White"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        InputTransparent="True"/>

        </Border>
    </Grid>

</ContentPage>
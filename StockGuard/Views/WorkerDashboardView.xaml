                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Damaged"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Damaged" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Red}"/>
                            </Frame>

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Paused"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Paused" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"/>
                            </Frame>

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Resumed"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Resumed" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Green}"/>
                            </Frame>

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Request"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Requests" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"/>
                            </Frame>

                        </HorizontalStackLayout>
                    </ScrollView>

                    --><!-- Activity items with day header + time indicator --><!--
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding RecentActivity}"
                        Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ActivityItem">
                                <VerticalStackLayout Spacing="0">

                                    --><!-- Day group header line --><!--
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8"
                                          Margin="0,10,0,4">
                                        <Label Grid.Column="0"
                                               Text="{Binding DayLabel}"
                                               FontSize="10" FontAttributes="Bold"
                                               TextColor="{DynamicResource Blue}"
                                               VerticalOptions="Center"/>
                                        <BoxView Grid.Column="1"
                                                 HeightRequest="1"
                                                 VerticalOptions="Center"
                                                 Color="{DynamicResource BorderSoft}"/>
                                    </Grid>

                                    --><!-- Activity card --><!--
                                    <Frame BackgroundColor="{DynamicResource BgCard}"
                                           BorderColor="{DynamicResource BorderColor}"
                                           CornerRadius="12" Padding="14"
                                           HasShadow="False">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="12">

                                            <Label Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="20"
                                                   VerticalOptions="Center"/>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource Text2}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>

                                            --><!-- Time: exact time + relative ago --><!--
                                            <VerticalStackLayout Grid.Column="2"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                Spacing="2">
                                                <Label Text="{Binding TimeLabel}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{DynamicResource Text2}"
                                                       HorizontalOptions="End"/>
                                                <Label Text="{Binding TimeAgo}"
                                                       FontSize="10"
                                                       TextColor="{DynamicResource Text3}"
                                                       HorizontalOptions="End"/>
                                            </VerticalStackLayout>

                                        </Grid>
                                    </Frame>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    --><!-- Activity pagination — hidden when only 1 page --><!--
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          IsVisible="{Binding ShowActivityPager}"
                          Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="‹ Prev"
                                Command="{Binding ActivityPrevCommand}"
                                IsEnabled="{Binding CanGoActivityPrev}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="12" CornerRadius="8"
                                HeightRequest="34" Padding="12,0"/>
                        <Label Grid.Column="1"
                               Text="{Binding ActivityPageLabel}"
                               FontSize="12"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="2"
                                Text="Next ›"
                                Command="{Binding ActivityNextCommand}"
                                IsEnabled="{Binding CanGoActivityNext}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="12" CornerRadius="8"
                                HeightRequest="34" Padding="12,0"/>
                    </Grid>

                </VerticalStackLayout>-->

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>


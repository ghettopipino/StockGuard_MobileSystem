<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             x:Class="StockGuard.Views.WorkerDashboardView"
             x:DataType="vm:WorkerDashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <RefreshView
        IsRefreshing="{Binding IsRefreshing}"
        Command="{Binding RefreshCommand}"
        RefreshColor="{DynamicResource Blue}">
        <ScrollView>
            <VerticalStackLayout Padding="20,52,20,40" Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding GreetingText}"
                               FontSize="13"
                               TextColor="{DynamicResource Text3}"/>
                        <Label Text="{Binding WorkerName}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"/>
                    </VerticalStackLayout>

                    <!--<Button
                            Text="{Binding ThemeIcon}"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16" CornerRadius="8"
                            WidthRequest="40" HeightRequest="36"
                            Padding="0"/>-->

                    <!--<Grid>
                        <Button Text="🔔"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"
                                Clicked="OnNotificationClicked"/>
                        <Frame IsVisible="{Binding HasPendingRequests}"
                               BackgroundColor="{DynamicResource Red}"
                               CornerRadius="8"
                               WidthRequest="16" HeightRequest="16"
                               Padding="0" HasShadow="False"
                               BorderColor="Transparent"
                               HorizontalOptions="End"
                               VerticalOptions="Start"
                               Margin="0,2,2,0"
                               InputTransparent="True">
                            <Label Text="{Binding PendingCount}"
                                   FontSize="9" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                    </Grid>-->

                    <Button Grid.Column="1" Text="Logout"
                            Command="{Binding LogoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Red}"
                            FontSize="13"/>
                </Grid>

                <!-- Active project -->
                <Label Text="No Active Project"
                       IsVisible="{Binding NoActiveProject}"
                       FontSize="13"
                       TextColor="{DynamicResource Text3}"/>

                <Border IsVisible="{Binding HasActiveProject}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource BgCard}"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ActiveProjectName}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{DynamicResource Text1}"/>
                        <Label Text="{Binding ActiveProjectLocation}"
                               FontSize="12" TextColor="{DynamicResource Text3}"/>
                        <Label Text="{Binding ActiveProjectDuration,
                                   StringFormat='Started {0}'}"
                               FontSize="11" TextColor="{DynamicResource Text3}"/>
                        <Label Text="{Binding DeploymentStatusText}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding DeploymentStatusColor}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Stats -->
                <Label FontSize="13" TextColor="{DynamicResource Text2}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding AssignedCount}" FontAttributes="Bold" TextColor="{DynamicResource Blue}"/>
                            <Span Text=" tools    "/>
                            <!--<Span Text="{Binding PendingCount}" FontAttributes="Bold" TextColor="{DynamicResource Amber}"/>
                            <Span Text=" pending  ·  "/>
                            <Span Text="{Binding ReturnedTodayCount}" FontAttributes="Bold" TextColor="{DynamicResource Green}"/>
                            <Span Text=" returned today"/>-->
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Pending Assignments -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasPendingAssignments}">

                    <Label Text="Pending Assignments" FontSize="15" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingAssignments}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PendingAssignmentItem">
                                <Border Stroke="{DynamicResource Amber}"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding ToolName}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource Text1}"/>
                                        <Label Text="{Binding ToolId}" FontSize="11" TextColor="{DynamicResource Text3}"/>
                                        <Label FontSize="11" TextColor="{DynamicResource Text3}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="Assigned by {0} · {1}">
                                                    <Binding Path="AssignedByName"/>
                                                    <Binding Path="ProjectName"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Grid.Column="0" Text="Decline"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}}, Path=DeclineAssignmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Red}"
                                                    BorderColor="{DynamicResource Red}" BorderWidth="1"
                                                    FontAttributes="Bold"
                                                    HeightRequest="40"/>
                                            <Button Grid.Column="1" Text="Accept"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}}, Path=AcceptAssignmentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{DynamicResource Blue}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    HeightRequest="40"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- My Tools -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="My Tools" FontSize="15" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding AssignedCount, StringFormat='{0} tool(s)'}"
                           FontSize="12" TextColor="{DynamicResource Text3}" VerticalOptions="Center"/>
                </Grid>

                <Label Text="No tools assigned yet"
                       IsVisible="{Binding HasNoTools}"
                       FontSize="13" TextColor="{DynamicResource Text3}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AssignedTools}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolAssignmentItem">
                            <Border Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerDashboardViewModel}}, Path=ViewToolCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding ToolName}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource Text1}"/>
                                        <Label Text="{Binding ToolId}" FontSize="12" TextColor="{DynamicResource Text3}"/>
                                        <Label Text="{Binding BorrowDuration}" FontSize="11" TextColor="{DynamicResource Blue}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Status}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Tools pagination -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ShowToolsPager}">
                    <Button Grid.Column="0" Text="‹ Prev"
                            Command="{Binding ToolsPrevCommand}"
                            IsEnabled="{Binding CanGoToolsPrev}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}" FontSize="12"/>
                    <Label Grid.Column="1" Text="{Binding ToolsPageLabel}"
                           FontSize="12" TextColor="{DynamicResource Text3}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Button Grid.Column="2" Text="Next ›"
                            Command="{Binding ToolsNextCommand}"
                            IsEnabled="{Binding CanGoToolsNext}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}" FontSize="12"/>
                </Grid>

                <!-- ══════════════════════════════════════════
                     RECENT ACTIVITY
                     • Filter chips scroll horizontally
                     • Each item shows day header + time
                     • Pagination 5 per page
                ══════════════════════════════════════════════ -->
                <!--<VerticalStackLayout Padding="20,16,20,0" Spacing="10">

                    <Label Text="📋  Recent Activity"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"/>

                    --><!-- Filter chips --><!--
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8" Padding="0,0,0,2">

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="All"/>
                                </Frame.GestureRecognizers>
                                <Label Text="All" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"/>
                            </Frame>

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Borrowed"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Borrowed" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Amber}"/>
                            </Frame>

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SetActivityFilterCommand}"
                                        CommandParameter="Returned"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Returned" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource Green}"/>
                            </Frame>

                            <Frame Padding="12,6" CornerRadius="20" HasShadow="False"

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             x:Class="StockGuard.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{Binding PageBackground}">

    <Grid RowDefinitions="*,Auto">

        <!-- ══════════════════════════════════════════════════════════
             MAIN CONTENT
        ══════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ── TOP BAR ──────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto"
                      Padding="28,56,28,0">
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="8"
                                           VerticalOptions="Center">
                        <Label Text="🛡"
                               FontSize="18"
                               VerticalOptions="Center"/>
                        <Label Text="STOCKGUARD"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4b7bec"
                               CharacterSpacing="3"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Button Grid.Column="1"
                            Text="{Binding ThemeIcon}"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{Binding TextSecondary}"
                            FontSize="18"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"/>
                </Grid>

                <!-- ── HERO TEXT ─────────────────────────────────── -->
                <VerticalStackLayout Padding="28,48,28,0" Spacing="0">

                    <!-- Accent line -->
                    <BoxView WidthRequest="40"
                             HeightRequest="3"
                             Color="#4b7bec"
                             HorizontalOptions="Start"
                             Margin="0,0,0,20"/>

                    <Label Text="Equipment,"
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="{Binding TextPrimary}"
                           LineHeight="1.1"/>
                    <Label Text="Under Control."
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="#4b7bec"
                           LineHeight="1.1"/>

                    <Label Text="Track every tool. Know who has what,"
                           FontSize="14"
                           TextColor="{Binding TextSecondary}"
                           LineHeight="1.6"
                           Margin="0,20,0,0"/>
                    <Label Text="when they took it, and where it's been."
                           FontSize="14"
                           TextColor="{Binding TextSecondary}"
                           LineHeight="1.6"/>

                </VerticalStackLayout>

                <!-- ── DIVIDER ───────────────────────────────────── -->
                <BoxView HeightRequest="1"
                         Color="{Binding DividerColor}"
                         Margin="28,48,28,0"/>

                <!-- ── FEATURE LIST — separated by hairlines ─────── -->
                <VerticalStackLayout Padding="28,0" Spacing="0">

                    <!-- Item 1 -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="16"
                          Padding="0,24">
                        <Label Grid.Column="0"
                               Text="🔧"
                               FontSize="22"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Tool Management"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{Binding TextPrimary}"/>
                            <Label Text="Borrow, return, transfer and report"
                                   FontSize="12"
                                   TextColor="{Binding TextMuted}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{Binding DividerColor}"/>

                    <!-- Item 2 -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="16"
                          Padding="0,24">
                        <Label Grid.Column="0"
                               Text="📋"
                               FontSize="22"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Full Audit Logs"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{Binding TextPrimary}"/>
                            <Label Text="Every action tracked and timestamped"
                                   FontSize="12"
                                   TextColor="{Binding TextMuted}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{Binding DividerColor}"/>

                    <!-- Item 3 -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="16"
                          Padding="0,24">
                        <Label Grid.Column="0"
                               Text="👷"
                               FontSize="22"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Role-Based Access"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{Binding TextPrimary}"/>
                            <Label Text="Engineers oversee, workers act"
                                   FontSize="12"
                                   TextColor="{Binding TextMuted}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{Binding DividerColor}"/>

                    <!-- Item 4 -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="16"
                          Padding="0,24">
                        <Label Grid.Column="0"
                               Text="📷"
                               FontSize="22"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="QR Code Scanning"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{Binding TextPrimary}"/>
                            <Label Text="Instant tool lookup on site"
                                   FontSize="12"
                                   TextColor="{Binding TextMuted}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{Binding DividerColor}"/>

                </VerticalStackLayout>

                <!-- Spacer for pinned button -->
                <BoxView HeightRequest="32"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════════════════════
             PINNED BOTTOM CTA
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Padding="28,16,28,44"
              BackgroundColor="{Binding PageBackground}">

            <Button Text="Get Started"
                    Command="{Binding GetStartedCommand}"
                    BackgroundColor="#4b7bec"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="54"/>
        </Grid>

    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.EquipmentCatalogView"
    x:DataType="vm:EquipmentCatalogViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- ═══════════════════════════════════════
                         HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <!-- MENU -->
                        <Button
                            Grid.Column="0"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                        <!-- TITLE -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="1"
                            VerticalOptions="Center">

                            <Label
                                Text="Equipment Catalog"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Manage equipment categories and stock"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>

                        <!-- REFRESH -->
                        <Button
                            Grid.Column="2"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>


                    <!-- ═══════════════════════════════════════
                         PAGE INTRO
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            Text="Equipment Inventory"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="View physical stock, borrowed equipment, and project allocation."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         SUMMARY
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,22,20,0"
                        Spacing="10">

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Inventory Overview"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Text="&#xf201;"
                                    FontFamily="FontAwesome"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Text="Live inventory"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                            </HorizontalStackLayout>

                        </Grid>


                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8">

                            <!-- CATALOGS -->
                            <Border
                                Grid.Column="0"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf07b;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalCatalogs}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Blue}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Catalogs"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- TOTAL TOOLS -->
                            <Border
                                Grid.Column="1"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Text2}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding TotalTools}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text1}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Tools"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- AVAILABLE -->
                            <Border
                                Grid.Column="2"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf058;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding AvailableTools}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Available"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         SEARCH + ADD
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10"
                        Padding="20,18,20,0">

                        <Border
                            Grid.Column="0"
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource InputBg}"
                            Padding="12,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf002;"
                                    FontFamily="FontAwesome"
                                    FontSize="12"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding SearchText}"
                                    Placeholder="Search catalog..."
                                    PlaceholderColor="{DynamicResource Text3}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Text1}"
                                    FontSize="12"
                                    HeightRequest="44"
                                    Margin="0"/>

                            </Grid>

                        </Border>

                        <Button
                            Grid.Column="1"
                            Text="Add"
                            Command="{Binding AddCatalogCommand}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="44"
                            Padding="16,0"/>

                    </Grid>


                    <!-- ═══════════════════════════════════════
                         LOADING
                         ═══════════════════════════════════════ -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,18,0,0"/>


                    <!-- ═══════════════════════════════════════
                         CATALOG SECTION
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,24,20,0"
                        Spacing="10">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="&#xf07b;"
                                FontFamily="FontAwesome"
                                FontSize="16"
                                TextColor="{DynamicResource Blue}"
                                WidthRequest="28"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Catalogs"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="2"
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center">

                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding TotalCatalogs}"/>
                                        <Span Text=" total"/>
                                    </FormattedString>
                                </Label.FormattedText>

                            </Label>

                        </Grid>


                        <!-- EMPTY STATE -->
                        <Border
                            IsVisible="{Binding NoCatalogs}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="24">

                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="8">

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesome"
                                    FontSize="22"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No equipment catalog yet"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Create a catalog to start adding equipment."
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- ═══════════════════════════════════
                             CATALOG LIST
                             ═══════════════════════════════════ -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Catalogs}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:CatalogDisplayItem">

                                    <Border
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Padding="0">

                                        <VerticalStackLayout
                                            Spacing="0">


                                            <!-- TOP INFORMATION -->
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12"
                                                Padding="14">


                                                <!-- TRANSPARENT ICON -->
                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf0ad;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="20"
                                                    TextColor="{DynamicResource Blue}"
                                                    WidthRequest="38"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    VerticalOptions="Center"/>


                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="4">

                                                    <Label
                                                        Text="{Binding CatalogName}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"
                                                        LineBreakMode="TailTruncation"/>

                                                    <HorizontalStackLayout
                                                        Spacing="6">

                                                        <Label
                                                            Text="{Binding TotalLabel}"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="·"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="Prefix: "/>
                                                                    <Span
                                                                        Text="{Binding Prefix}"
                                                                        FontAttributes="Bold"/>
                                                                </FormattedString>
                                                            </Label.FormattedText>

                                                        </Label>

                                                    </HorizontalStackLayout>

                                                </VerticalStackLayout>

                                            </Grid>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- STATUS COUNTS -->
                                            <Grid
                                                ColumnDefinitions="*,*,*"
                                                ColumnSpacing="8"
                                                Padding="14,12">


                                                <!-- AVAILABLE -->
                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="3"
                                                    HorizontalOptions="Center">

                                                    <Label
                                                        Text="&#xf058;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="14"
                                                        TextColor="{DynamicResource Green}"
                                                        HorizontalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding AvailableTools}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Green}"
                                                        HorizontalOptions="Center"/>

                                                    <Label
                                                        Text="Available"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        HorizontalOptions="Center"/>

                                                </VerticalStackLayout>


                                                <!-- BORROWED -->
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3"
                                                    HorizontalOptions="Center">

                                                    <Label
                                                        Text="&#xf466;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="14"
                                                        TextColor="{DynamicResource Amber}"
                                                        HorizontalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding BorrowedTools}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Amber}"
                                                        HorizontalOptions="Center"/>

                                                    <Label
                                                        Text="Borrowed"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        HorizontalOptions="Center"/>

                                                </VerticalStackLayout>


                                                <!-- DAMAGED -->
                                                <VerticalStackLayout
                                                    Grid.Column="2"
                                                    Spacing="3"
                                                    HorizontalOptions="Center">

                                                    <Label
                                                        Text="&#xf071;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="14"
                                                        TextColor="{DynamicResource Red}"
                                                        HorizontalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding DamagedTools}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Red}"
                                                        HorizontalOptions="Center"/>

                                                    <Label
                                                        Text="Damaged"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        HorizontalOptions="Center"/>

                                                </VerticalStackLayout>

                                            </Grid>


                                            <!-- PROJECT ALLOCATION -->
                                            <Border
                                                Stroke="{DynamicResource BorderSoft}"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="Transparent"
                                                Padding="10"
                                                Margin="14,0,14,12">

                                                <Grid
                                                    ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="8">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf1ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="12"
                                                        TextColor="{DynamicResource Blue}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="Allocated to active projects"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Grid.Column="2"
                                                        Text="{Binding AllocatedTools}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Blue}"
                                                        VerticalOptions="Center"/>

                                                </Grid>

                                            </Border>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- ACTIONS -->
                                            <Grid
                                                ColumnDefinitions="*,*,Auto"
                                                ColumnSpacing="0"
                                                HeightRequest="48">

                                                <Button
                                                    Grid.Column="0"
                                                    Text="View Tools"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EquipmentCatalogViewModel}},
                                                                      Path=ViewToolsCommand}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Blue}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    CornerRadius="0"/>

                                                <Button
                                                    Grid.Column="1"
                                                    Text="Add Tools"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EquipmentCatalogViewModel}},
                                                                      Path=AddToolsCommand}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Green}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    CornerRadius="0"/>

                                                <Button
                                                    Grid.Column="2"
                                                    Text="Delete"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EquipmentCatalogViewModel}},
                                                                      Path=DeleteCatalogCommand}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Red}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    Padding="14,0"
                                                    CornerRadius="0"/>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- FOOTER -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,30,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Equipment Catalog"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
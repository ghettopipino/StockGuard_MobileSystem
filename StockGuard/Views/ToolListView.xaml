<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.ToolListView"
    x:DataType="vm:ToolListViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- ═══════════════════════════════════════
                         HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">


                        <!-- BACK -->
                        <Button
                            Grid.Column="0"
                            Text="&#xf060;"
                            FontFamily="FontAwesome"
                            Command="{Binding GoBackCommand}"
                            Clicked="OnBackClicked"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>


                        <!-- TITLE -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="{Binding CatalogName}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                LineBreakMode="TailTruncation"/>

                            <Label
                                Text="{Binding ToolCountLabel}"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>


                        <!-- REFRESH -->
                        <Button
                            Grid.Column="2"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>


                        <!-- MENU -->
                        <Button
                            Grid.Column="3"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>



                    <!-- ═══════════════════════════════════════
                         PAGE INTRO
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            Text="Equipment"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Physical equipment and current inventory status."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         INVENTORY SUMMARY
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,22,20,0"
                        Spacing="10">


                        <!-- SUMMARY HEADER -->
                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Inventory Summary"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Text="&#xf201;"
                                    FontFamily="FontAwesome"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Text="Current status"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                            </HorizontalStackLayout>

                        </Grid>



                        <!-- ROW 1 -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">


                            <!-- AVAILABLE -->
                            <Border
                                Grid.Column="0"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf058;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding AvailableCount}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Green}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Available"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- BORROWED -->
                            <Border
                                Grid.Column="1"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf466;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding BorrowedCount}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Amber}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Borrowed"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>



                        <!-- ROW 2 -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">


                            <!-- DAMAGED -->
                            <Border
                                Grid.Column="0"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf071;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Red}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding DamagedCount}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Red}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Damaged"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>


                            <!-- LOST -->
                            <Border
                                Grid.Column="1"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="10,12">

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="&#xf128;"
                                        FontFamily="FontAwesome"
                                        FontSize="17"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="{Binding LostCount}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource Text2}"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Lost"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"
                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         LOADING
                         ═══════════════════════════════════════ -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,18,0,0"/>



                    <!-- ═══════════════════════════════════════
                         EQUIPMENT LIST HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        Padding="20,24,20,10">

                        <Label
                            Grid.Column="0"
                            Text="&#xf0ad;"
                            FontFamily="FontAwesome"
                            FontSize="16"
                            TextColor="{DynamicResource Blue}"
                            WidthRequest="28"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Equipment"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="{Binding ToolCountLabel}"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </Grid>



                    <!-- ═══════════════════════════════════════
                         PRINT SELECTION INFO
                         ═══════════════════════════════════════ -->

                    <Border
                        IsVisible="{Binding IsPrintSelectionMode}"
                        Margin="20,0,20,10"
                        Padding="12"
                        Stroke="{DynamicResource Blue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource BgCard}">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2"
                                VerticalOptions="Center">

                                <Label
                                    Text="Select Equipment"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="{Binding SelectedPrintLabel}"
                                    FontSize="10"
                                    TextColor="{DynamicResource Blue}"/>

                            </VerticalStackLayout>


                            <Button
                                Grid.Column="1"
                                Text="Select All"
                                Command="{Binding SelectAllPrintCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Blue}"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                Padding="8,0"/>

                        </Grid>

                    </Border>



                    <!-- ═══════════════════════════════════════
                         NORMAL TOOL LIST
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        IsVisible="{Binding IsNormalMode}"
                        BindableLayout.ItemsSource="{Binding Tools}"
                        Padding="20,0"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:Tool">

                                <Border
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="0">

                                    <VerticalStackLayout
                                        Spacing="0">


                                        <!-- TOOL INFORMATION -->
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            Padding="14"
                                            ColumnSpacing="12">


                                            <!-- TOOL ICON -->
                                            <Label
                                                Grid.Column="0"
                                                Text="&#xf0ad;"
                                                FontFamily="FontAwesome"
                                                FontSize="20"
                                                TextColor="{DynamicResource Blue}"
                                                WidthRequest="38"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                VerticalOptions="Center"/>


                                            <!-- TOOL DETAILS -->
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">


                                                <!-- TOOL ID -->
                                                <Label
                                                    Text="{Binding ToolId}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>


                                                <!-- TOOL NAME -->
                                                <Label
                                                    Text="{Binding ToolName}"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>


                                                <!-- STATUS -->
                                                <HorizontalStackLayout
                                                    Spacing="5">

                                                    <Label
                                                        Text="&#xf111;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="7"
                                                        TextColor="{Binding StatusColor}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding Status}"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding StatusColor}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>


                                                <!-- WORKER -->
                                                <HorizontalStackLayout
                                                    Spacing="5"
                                                    IsVisible="{Binding IsBorrowed}">

                                                    <Label
                                                        Text="&#xf007;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Blue}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding AssignedWorkerName}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Blue}"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"/>

                                                </HorizontalStackLayout>


                                                <!-- PROJECT -->
                                                <HorizontalStackLayout
                                                    Spacing="5"
                                                    IsVisible="{Binding IsBorrowed}">

                                                    <Label
                                                        Text="&#xf1ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding BorrowedProjectName}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        LineBreakMode="TailTruncation"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>


                                            <!-- CONDITION -->
                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Spacing="3"
                                                VerticalOptions="Start"
                                                HorizontalOptions="End">

                                                <Label
                                                    Text="Condition"
                                                    FontSize="8"
                                                    TextColor="{DynamicResource Text3}"
                                                    HorizontalOptions="End"/>

                                                <Label
                                                    Text="{Binding Condition}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text2}"
                                                    HorizontalOptions="End"/>

                                            </VerticalStackLayout>

                                        </Grid>



                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <!-- QR ACTION -->
                                        <Button
                                            Text="View QR Code"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ToolListViewModel}},
                                                              Path=ShowQrCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource Blue}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            HeightRequest="44"
                                            CornerRadius="0"/>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         PRINT SELECTION TOOL LIST
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        IsVisible="{Binding IsPrintSelectionMode}"
                        BindableLayout.ItemsSource="{Binding PrintItems}"
                        Padding="20,0"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="vm:ToolPrintItem">

                                <Border
                                    Stroke="{Binding SelectionBorderColor}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{Binding SelectionBackgroundColor}"
                                    Padding="0">

                                    <VerticalStackLayout
                                        Spacing="0">


                                        <!-- TOOL INFORMATION -->
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            Padding="14"
                                            ColumnSpacing="12">


                                            <!-- SELECTION ICON -->
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                Stroke="{Binding SelectionBorderColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 19"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center">

                                                <Label
                                                    Text="{Binding SelectionIcon}"
                                                    FontFamily="FontAwesome"
                                                    FontSize="17"
                                                    TextColor="{Binding SelectionTextColor}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>

                                            </Border>


                                            <!-- TOOL DETAILS -->
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">


                                                <!-- TOOL ID -->
                                                <Label
                                                    Text="{Binding ToolId}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>


                                                <!-- TOOL NAME -->
                                                <Label
                                                    Text="{Binding ToolName}"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>


                                                <!-- STATUS -->
                                                <HorizontalStackLayout
                                                    Spacing="5">

                                                    <Label
                                                        Text="&#xf111;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="7"
                                                        TextColor="{Binding StatusColor}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding Status}"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding StatusColor}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>


                                                <!-- WORKER -->
                                                <HorizontalStackLayout
                                                    Spacing="5"
                                                    IsVisible="{Binding IsBorrowed}">

                                                    <Label
                                                        Text="&#xf007;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Blue}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding AssignedWorkerName}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Blue}"
                                                        FontAttributes="Bold"
                                                        LineBreakMode="TailTruncation"/>

                                                </HorizontalStackLayout>


                                                <!-- PROJECT -->
                                                <HorizontalStackLayout
                                                    Spacing="5"
                                                    IsVisible="{Binding IsBorrowed}">

                                                    <Label
                                                        Text="&#xf1ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding BorrowedProjectName}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        LineBreakMode="TailTruncation"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>


                                            <!-- CONDITION -->
                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Spacing="3"
                                                VerticalOptions="Start"
                                                HorizontalOptions="End">

                                                <Label
                                                    Text="Condition"
                                                    FontSize="8"
                                                    TextColor="{DynamicResource Text3}"
                                                    HorizontalOptions="End"/>

                                                <Label
                                                    Text="{Binding Condition}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text2}"
                                                    HorizontalOptions="End"/>

                                            </VerticalStackLayout>

                                        </Grid>



                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <!-- SELECT / UNSELECT -->
                                        <Button
                                            Text="{Binding SelectionText}"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ToolListViewModel}},
                                                              Path=TogglePrintToolCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{Binding SelectionTextColor}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            HeightRequest="44"
                                            CornerRadius="0"/>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         NORMAL PRINT BUTTON
                         ═══════════════════════════════════════ -->

                    <Button
                        IsVisible="{Binding IsNormalMode}"
                        Text="Print QR Labels"
                        Command="{Binding PrintQrCommand}"
                        BackgroundColor="{DynamicResource Blue}"
                        TextColor="White"
                        FontSize="12"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="44"
                        Margin="20,16,20,0"/>



                    <!-- ═══════════════════════════════════════
                         PRINT SELECTION ACTIONS
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        IsVisible="{Binding IsPrintSelectionMode}"
                        Margin="20,16,20,0"
                        Spacing="10">


                        <!-- SELECTED COUNT -->
                        <Label
                            Text="{Binding SelectedPrintLabel}"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Blue}"
                            HorizontalOptions="Center"/>


                        <!-- PRINT SELECTED -->
                        <Button
                            Text="{Binding PrintSelectedButtonText}"
                            Command="{Binding PrintSelectedCommand}"
                            IsEnabled="{Binding HasPrintSelection}"
                            BackgroundColor="{DynamicResource Blue}"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="46"/>


                        <!-- CANCEL -->
                        <Button
                            Text="Cancel Selection"
                            Command="{Binding CancelPrintSelectionCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Red}"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="42"/>

                    </VerticalStackLayout>



                    <!-- ═══════════════════════════════════════
                         FOOTER
                         ═══════════════════════════════════════ -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,30,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Equipment"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
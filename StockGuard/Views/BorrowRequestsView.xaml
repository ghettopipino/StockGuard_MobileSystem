<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.BorrowRequestsView"
    x:DataType="vm:BorrowRequestsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- ================================================== -->
                    <!-- HEADER -->
                    <!-- ================================================== -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <!-- BACK -->
                        <Button
                            Grid.Column="0"
                            Text="&#xf060;"
                            FontFamily="FontAwesome"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                        <!-- TITLE -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Worker Requests"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Manage borrow and transfer requests"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>

                        <!-- THEME -->
                        <Button
                            Grid.Column="2"
                            Text="{Binding ThemeIcon}"
                            FontFamily="FontAwesome"
                            Command="{Binding ToggleThemeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                        <!-- REFRESH -->
                        <Button
                            Grid.Column="3"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="15"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>


                    <!-- ================================================== -->
                    <!-- LOADING -->
                    <!-- ================================================== -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,20"/>


                    <!-- ================================================== -->
                    <!-- INCOMING REQUESTS -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        Padding="20,18,20,0"
                        Spacing="12">


                        <!-- SECTION HEADER -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="Incoming Requests"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="Requests from other workers"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                            </VerticalStackLayout>


                            <!-- COUNT -->

                            <Border
                                Grid.Column="1"
                                IsVisible="{Binding HasIncoming}"
                                BackgroundColor="{DynamicResource RedBg}"
                                Stroke="{DynamicResource Red}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="9,4"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding IncomingRequests.Count}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Red}"/>

                            </Border>

                        </Grid>


                        <!-- ================================================== -->
                        <!-- EMPTY INCOMING -->
                        <!-- ================================================== -->

                        <Border
                            IsVisible="{Binding NoIncoming}"
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            Padding="26">

                            <VerticalStackLayout
                                Spacing="9"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf0e0;"
                                    FontFamily="FontAwesome"
                                    FontSize="24"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No incoming requests"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Borrow and transfer requests will appear here."
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- ================================================== -->
                        <!-- INCOMING CARDS -->
                        <!-- ================================================== -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding IncomingRequests}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:BorrowRequestItem">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="16">

                                        <VerticalStackLayout Spacing="12">


                                            <!-- REQUEST INFORMATION -->

                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12">


                                                <!-- ICON -->

                                                <Border
                                                    Grid.Column="0"
                                                    BackgroundColor="Transparent"
                                                    Stroke="Transparent"
                                                    WidthRequest="42"
                                                    HeightRequest="42"
                                                    VerticalOptions="Start">

                                                    <Label
                                                        Text="&#xf0e0;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="20"
                                                        TextColor="{DynamicResource Blue}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"/>

                                                </Border>


                                                <!-- DETAILS -->

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="5"
                                                    VerticalOptions="Center">


                                                    <!-- REQUESTER -->

                                                    <Label
                                                        Text="{Binding RequesterDisplay}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"/>


                                                    <!-- REQUEST TYPE -->

                                                    <Border
                                                        BackgroundColor="{DynamicResource BgElevated}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 7"
                                                        Padding="8,3"
                                                        HorizontalOptions="Start">

                                                        <Label
                                                            Text="{Binding RequestTypeLabel}"
                                                            FontSize="9"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding RequestTypeColor}"/>

                                                    </Border>


                                                    <!-- DESCRIPTION -->

                                                    <Label
                                                        Text="{Binding RequestDescription}"
                                                        FontSize="12"
                                                        TextColor="{DynamicResource Text2}"
                                                        LineBreakMode="WordWrap"/>


                                                    <!-- TOOL ID -->

                                                    <HorizontalStackLayout Spacing="6">

                                                        <Label
                                                            Text="&#xf02a;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <Label
                                                            Text="{Binding ToolId}"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                    </HorizontalStackLayout>


                                                    <!-- DATE -->

                                                    <HorizontalStackLayout Spacing="6">

                                                        <Label
                                                            Text="&#xf017;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                        <Label
                                                            Text="{Binding DateLabel}"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text3}"
                                                            VerticalOptions="Center"/>

                                                    </HorizontalStackLayout>

                                                </VerticalStackLayout>

                                            </Grid>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- ================================================== -->
                                            <!-- ACTIONS -->
                                            <!-- ================================================== -->

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding IsPending}">


                                                <!-- ACCEPT -->

                                                <Button
                                                    Grid.Column="0"
                                                    Text="Accept"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BorrowRequestsViewModel}},
                                                                      Path=AcceptCommand}"
                                                    BackgroundColor="{DynamicResource Green}"
                                                    TextColor="White"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    CornerRadius="10"
                                                    HeightRequest="44"/>


                                                <!-- DECLINE -->

                                                <Button
                                                    Grid.Column="1"
                                                    Text="Decline"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BorrowRequestsViewModel}},
                                                                      Path=DeclineCommand}"
                                                    BackgroundColor="{DynamicResource RedBg}"
                                                    TextColor="{DynamicResource Red}"
                                                    BorderColor="{DynamicResource Red}"
                                                    BorderWidth="1"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    CornerRadius="10"
                                                    HeightRequest="44"/>

                                            </Grid>


                                            <!-- ================================================== -->
                                            <!-- PROCESSED STATUS -->
                                            <!-- ================================================== -->

                                            <Border
                                                IsVisible="{Binding IsPending,
                                                    Converter={StaticResource InvertBoolConverter}}"
                                                BackgroundColor="{DynamicResource BgElevated}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="12,6"
                                                HorizontalOptions="Center">

                                                <Label
                                                    Text="{Binding Status}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding StatusColor}"
                                                    HorizontalOptions="Center"/>

                                            </Border>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- OUTGOING REQUESTS -->
                    <!-- ================================================== -->

                    <VerticalStackLayout
                        Padding="20,26,20,0"
                        Spacing="12">


                        <!-- SECTION HEADER -->

                        <VerticalStackLayout Spacing="2">

                            <Label
                                Text="My Sent Requests"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Requests you sent to other workers"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>


                        <!-- ================================================== -->
                        <!-- EMPTY OUTGOING -->
                        <!-- ================================================== -->

                        <Border
                            IsVisible="{Binding NoOutgoing}"
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            Padding="26">

                            <VerticalStackLayout
                                Spacing="9"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf1d8;"
                                    FontFamily="FontAwesome"
                                    FontSize="23"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No sent requests"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Requests you send will appear here."
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- ================================================== -->
                        <!-- OUTGOING CARDS -->
                        <!-- ================================================== -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding OutgoingRequests}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:BorrowRequestItem">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="16">

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12">


                                            <!-- ICON -->

                                            <Border
                                                Grid.Column="0"
                                                BackgroundColor="Transparent"
                                                Stroke="Transparent"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="&#xf1d8;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="18"
                                                    TextColor="{DynamicResource Blue}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>

                                            </Border>


                                            <!-- DETAILS -->

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="5"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding ToolName}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>


                                                <Border
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 7"
                                                    Padding="7,3"
                                                    HorizontalOptions="Start">

                                                    <Label
                                                        Text="{Binding RequestTypeLabel}"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding RequestTypeColor}"/>

                                                </Border>


                                                <HorizontalStackLayout Spacing="6">

                                                    <Label
                                                        Text="&#xf02a;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>


                                                <HorizontalStackLayout Spacing="6">

                                                    <Label
                                                        Text="&#xf017;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding DateLabel}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>


                                            <!-- STATUS -->

                                            <Border
                                                Grid.Column="2"
                                                BackgroundColor="{DynamicResource BgElevated}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="9,5"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Status}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding StatusColor}"/>

                                            </Border>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ================================================== -->
                    <!-- FOOTER -->
                    <!-- ================================================== -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,28,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Worker Requests"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
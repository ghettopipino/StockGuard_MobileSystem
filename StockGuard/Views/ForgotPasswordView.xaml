<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    x:Class="StockGuard.Views.ForgotPasswordView"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,60,24,40"
            Spacing="0">

            <!-- HEADER -->

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="&#xf060;"
                    FontFamily="FontAwesome"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="{DynamicResource BgElevated}"
                    TextColor="{DynamicResource Text2}"
                    FontSize="14"
                    CornerRadius="10"
                    WidthRequest="40"
                    HeightRequest="40"
                    Padding="0"/>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="Forgot Password"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text1}"/>

                    <Label
                        Text="Reset access to your StockGuard account."
                        FontSize="11"
                        TextColor="{DynamicResource Text3}"/>

                </VerticalStackLayout>

            </Grid>


            <!-- CARD -->

            <Border
                BackgroundColor="{DynamicResource BgCard}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 16"
                Padding="20"
                Margin="0,28,0,0">

                <VerticalStackLayout Spacing="16">

                    <!-- INFO -->

                    <Label
                        Text="Enter the email address registered to your account. StockGuard will send a 6-digit verification code."
                        FontSize="11"
                        TextColor="{DynamicResource Text3}"
                        LineBreakMode="WordWrap"/>


                    <!-- ERROR -->

                    <Border
                        IsVisible="{Binding HasError}"
                        BackgroundColor="{DynamicResource RedBg}"
                        Stroke="{DynamicResource Red}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12">

                        <Label
                            Text="{Binding ErrorMessage}"
                            FontSize="11"
                            TextColor="{DynamicResource Red}"
                            LineBreakMode="WordWrap"/>

                    </Border>


                    <!-- SUCCESS -->

                    <Border
                        IsVisible="{Binding HasSuccess}"
                        Stroke="{DynamicResource Green}"
                        StrokeShape="RoundRectangle 10"
                        Padding="12">

                        <Label
                            Text="{Binding SuccessMessage}"
                            FontSize="11"
                            TextColor="{DynamicResource Green}"
                            LineBreakMode="WordWrap"/>

                    </Border>


                    <!-- EMAIL -->

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Email"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text2}"/>

                        <Border
                            BackgroundColor="{DynamicResource InputBg}"
                            Stroke="{DynamicResource InputBorder}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,0">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="&#xf0e0;"
                                    FontFamily="FontAwesome"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding Email}"
                                    Placeholder="you@example.com"
                                    Keyboard="Email"
                                    PlaceholderColor="{DynamicResource Text3}"
                                    TextColor="{DynamicResource Text1}"
                                    BackgroundColor="Transparent"
                                    FontSize="12"
                                    HeightRequest="46"/>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>


                    <!-- SEND CODE -->

                    <Button
                        Text="Send Verification Code"
                        Command="{Binding SendCodeCommand}"
                        BackgroundColor="{DynamicResource Blue}"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="10"/>


                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
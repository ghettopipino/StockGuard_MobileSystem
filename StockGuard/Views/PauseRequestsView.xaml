<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             x:Class="StockGuard.Views.PauseRequestsView"
             x:DataType="vm:PauseRequestsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                    <!-- ── HEADER ──────────────────────────── -->
                    <!-- ☰ replaces ← — PauseRequestsView is a FlyoutItem root page -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="10"
                          Padding="20,52,20,16"
                          BackgroundColor="{DynamicResource BgSurface}">

                        <Button Grid.Column="0"
                                Text="☰"
                                Command="{Binding OpenFlyoutCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="18" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center" Spacing="1">
                            <Label Text="Pause Requests"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource Text1}"/>
                            <Label Text="Verify and approve tool pause requests"
                                   FontSize="11"
                                   TextColor="{DynamicResource Text3}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="{Binding ThemeIcon}"
                                Command="{Binding ToggleThemeCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>

                        <Button Grid.Column="3"
                                Text="🔄"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16" CornerRadius="8"
                                WidthRequest="40" HeightRequest="36"
                                Padding="0"/>
                    </Grid>

                    <!-- ── STATS ───────────────────────────── -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10"
                          Padding="20,14">

                        <Frame Grid.Column="0"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="14" Padding="0" HasShadow="False">
                            <VerticalStackLayout Padding="10,14" Spacing="4"
                                HorizontalOptions="Center">
                                <Label Text="⏳" FontSize="20"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding PendingCount}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="{DynamicResource Amber}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Pending" FontSize="10"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="14" Padding="0" HasShadow="False">
                            <VerticalStackLayout Padding="10,14" Spacing="4"
                                HorizontalOptions="Center">
                                <Label Text="✅" FontSize="20"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding ApprovedCount}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="{DynamicResource Green}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Approved" FontSize="10"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- ── LOADING ─────────────────────────── -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,10"/>

                    <!-- ── PENDING SECTION ─────────────────── -->
                    <Label Text="⏳  Pending Verification"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"
                           Padding="20,10,20,6"/>

                    <Frame IsVisible="{Binding NoPending}"
                           BackgroundColor="{DynamicResource BgCard}"
                           BorderColor="{DynamicResource BorderSoft}"
                           CornerRadius="14" Padding="24"
                           HasShadow="False" Margin="20,0">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="✅" FontSize="36" HorizontalOptions="Center"/>
                            <Label Text="No pending pause requests"
                                   FontSize="13"
                                   TextColor="{DynamicResource Text3}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding PendingRequests}"
                        Padding="20,0" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PauseRequestItem">
                                <Frame BackgroundColor="{DynamicResource BgCard}"
                                       BorderColor="#f59e0b"
                                       CornerRadius="16" Padding="0"
                                       HasShadow="False">
                                    <VerticalStackLayout Spacing="0">

                                        <VerticalStackLayout Padding="16,14,16,12" Spacing="6">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="⏸️" FontSize="18"/>
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding ToolName}"
                                                           FontSize="15" FontAttributes="Bold"
                                                           TextColor="{DynamicResource Text1}"/>
                                                    <Label Text="{Binding ToolId}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource Text3}"/>
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="👷" FontSize="12"/>
                                                <Label Text="{Binding WorkerName}"
                                                       FontSize="13"
                                                       TextColor="{DynamicResource Text2}"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="📍" FontSize="12"/>
                                                <Label Text="{Binding ProjectName}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource Text3}"/>
                                            </HorizontalStackLayout>

                                            <Frame BackgroundColor="{DynamicResource BgElevated}"
                                                   BorderColor="Transparent"
                                                   CornerRadius="8" Padding="12,8"
                                                   HasShadow="False">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="Reason" FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource Text3}"/>
                                                    <Label Text="{Binding Reason}"
                                                           FontSize="13"
                                                           TextColor="{DynamicResource Text2}"/>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <Label Text="{Binding DateLabel}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource Text3}"/>
                                        </VerticalStackLayout>

                                        <BoxView HeightRequest="1"
                                                 Color="{DynamicResource BorderSoft}"/>

                                        <Frame BackgroundColor="#1a1400"
                                               BorderColor="Transparent"
                                               CornerRadius="0" Padding="14,10"
                                               HasShadow="False">
                                            <Label Text="⚠️  Physically verify the tool is in site storage before approving"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource Amber}"
                                                   HorizontalTextAlignment="Center"/>
                                        </Frame>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                                            <Button Grid.Column="0"
                                                    Text="✅  Approve"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}}, Path=ApproveCommand}"
                                                    BackgroundColor="{DynamicResource Green}"
                                                    TextColor="White"
                                                    FontSize="13" FontAttributes="Bold"
                                                    CornerRadius="0" HeightRequest="48"/>
                                            <Button Grid.Column="1"
                                                    Text="❌  Reject"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}}, Path=RejectCommand}"
                                                    BackgroundColor="{DynamicResource RedBg}"
                                                    TextColor="{DynamicResource Red}"
                                                    FontSize="13" FontAttributes="Bold"
                                                    CornerRadius="0" HeightRequest="48"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ── RECENTLY PROCESSED ─────────────── -->
                    <Label Text="📋  Recently Processed"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"
                           Padding="20,20,20,6"/>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding ProcessedRequests}"
                        Padding="20,0" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PauseRequestItem">
                                <Frame BackgroundColor="{DynamicResource BgCard}"
                                       BorderColor="{DynamicResource BorderColor}"
                                       CornerRadius="12" Padding="14"
                                       HasShadow="False">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Label Grid.Column="0"
                                               Text="{Binding StatusIcon}"
                                               FontSize="22" VerticalOptions="Center"/>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding ToolName}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{DynamicResource Text1}"/>
                                            <Label Text="{Binding WorkerName}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource Text2}"/>
                                            <Label Text="{Binding DateLabel}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource Text3}"/>
                                        </VerticalStackLayout>

                                        <Frame Grid.Column="2"
                                               BackgroundColor="{DynamicResource BgElevated}"
                                               BorderColor="Transparent"
                                               CornerRadius="8" Padding="8,4"
                                               HasShadow="False" VerticalOptions="Center">
                                            <Label Text="{Binding Status}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding StatusColor}"/>
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>

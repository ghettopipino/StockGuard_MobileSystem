<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.PauseRequestsView"
    x:DataType="vm:PauseRequestsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">

                    <!-- HEADER -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <Button
                            Grid.Column="0"
                            Text="☰"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="18"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Return Requests"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Receive and verify returned equipment"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="↻"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="18"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="36"
                            Padding="0"/>

                    </Grid>


                    <!-- STATS -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Padding="20,14">

                        <Frame
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False">

                            <VerticalStackLayout
                                Padding="0,14"
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="Pending"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="{Binding PendingCount}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Amber}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Frame>

                        <Frame
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource BgCard}"
                            BorderColor="{DynamicResource BorderColor}"
                            CornerRadius="14"
                            Padding="0"
                            HasShadow="False">

                            <VerticalStackLayout
                                Padding="0,14"
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="Approved"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="{Binding ApprovedCount}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Green}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Frame>

                    </Grid>


                    <!-- LOADING -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,8"/>


                    <!-- PENDING HEADER -->
                    <Label
                        Text="Pending Return Verification"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text1}"
                        Padding="20,10,20,6"/>


                    <!-- EMPTY -->
                    <Frame
                        IsVisible="{Binding NoPendingReturn}"
                        BackgroundColor="{DynamicResource BgCard}"
                        BorderColor="{DynamicResource BorderSoft}"
                        CornerRadius="14"
                        Padding="24"
                        HasShadow="False"
                        Margin="20,0">

                        <Label
                            Text="No pending return requests"
                            FontSize="13"
                            TextColor="{DynamicResource Text3}"
                            HorizontalOptions="Center"/>

                    </Frame>


                    <!-- PENDING RETURNS -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding PendingReturnRequests}"
                        Padding="20,0"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:ReturnRequestResult">

                                <Frame
                                    BackgroundColor="{DynamicResource BgCard}"
                                    BorderColor="{DynamicResource Green}"
                                    CornerRadius="16"
                                    Padding="0"
                                    HasShadow="False">

                                    <VerticalStackLayout Spacing="0">

                                        <VerticalStackLayout
                                            Padding="16,14,16,12"
                                            Spacing="8">

                                            <Label
                                                Text="RETURN REQUEST"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Green}"/>

                                            <Label
                                                Text="{Binding Request.ToolName}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"/>

                                            <Label
                                                Text="{Binding Request.ToolId}"
                                                FontSize="12"
                                                TextColor="{DynamicResource Text3}"/>


                                            <!-- ACCOUNTABILITY -->
                                            <Grid
                                                ColumnDefinitions="80,*"
                                                RowDefinitions="Auto,Auto"
                                                ColumnSpacing="10"
                                                RowSpacing="6">

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Text="Worker"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Text="{Binding Request.WorkerName}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text2}"/>


                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Text="Project"
                                                    FontSize="11"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Text="{Binding Request.ProjectName}"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource Text2}"/>

                                            </Grid>


                                            <Label
                                                Text="{Binding Request.RequestDate,
                                                    StringFormat='Requested: {0:MMM d, yyyy h:mm tt}'}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}"/>

                                        </VerticalStackLayout>


                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <Label
                                            Text="Physically receive and inspect the equipment before approving."
                                            FontSize="11"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalTextAlignment="Center"
                                            Padding="14,10"/>


                                        <Grid ColumnDefinitions="*,*">

                                            <Button
                                                Grid.Column="0"
                                                Text="Approve Return"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}},
                                                                  Path=ApproveReturnCommand}"
                                                BackgroundColor="{DynamicResource Green}"
                                                TextColor="White"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                CornerRadius="0"
                                                HeightRequest="48"/>

                                            <Button
                                                Grid.Column="1"
                                                Text="Reject"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}},
                                                                  Path=RejectReturnCommand}"
                                                BackgroundColor="{DynamicResource RedBg}"
                                                TextColor="{DynamicResource Red}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                CornerRadius="0"
                                                HeightRequest="48"/>

                                        </Grid>

                                    </VerticalStackLayout>

                                </Frame>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>


                    <!-- PROCESSED -->
                    <Label
                        Text="Recently Processed"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text1}"
                        Padding="20,20,20,6"/>


                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding ProcessedReturnRequests}"
                        Padding="20,0"
                        Spacing="8">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:ReturnRequestResult">

                                <Frame
                                    BackgroundColor="{DynamicResource BgCard}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    CornerRadius="12"
                                    Padding="14"
                                    HasShadow="False">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">

                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="3">

                                            <Label
                                                Text="{Binding Request.ToolName}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text1}"/>

                                            <Label
                                                Text="{Binding Request.WorkerName}"
                                                FontSize="12"
                                                TextColor="{DynamicResource Text2}"/>

                                            <Label
                                                Text="{Binding Request.ProjectName}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}"/>

                                            <Label
                                                Text="{Binding Request.RequestDate,
                                                    StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                                FontSize="11"
                                                TextColor="{DynamicResource Text3}"/>

                                        </VerticalStackLayout>


                                        <Frame
                                            Grid.Column="1"
                                            BackgroundColor="{DynamicResource BgElevated}"
                                            BorderColor="Transparent"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            HasShadow="False"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Request.Status}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource Text2}"/>

                                        </Frame>

                                    </Grid>

                                </Frame>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
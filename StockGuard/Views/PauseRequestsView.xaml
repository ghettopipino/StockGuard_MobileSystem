<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.PauseRequestsView"
    x:DataType="vm:PauseRequestsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <ScrollView>

                <VerticalStackLayout
                    Spacing="0"
                    Padding="0,0,0,40">


                    <!-- ═══════════════════════════════════════
                         HEADER
                         ═══════════════════════════════════════ -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        Padding="20,52,20,16"
                        BackgroundColor="{DynamicResource BgSurface}">

                        <Button
                            Grid.Column="0"
                            Text="&#xf0c9;"
                            FontFamily="FontAwesome"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Return &amp; Check-In"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Verify equipment check-ins and returns"
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="2"
                            Text="&#xf2f1;"
                            FontFamily="FontAwesome"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="{DynamicResource BgElevated}"
                            TextColor="{DynamicResource Text2}"
                            FontSize="14"
                            CornerRadius="10"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>

                    </Grid>


                    <!-- ═══════════════════════════════════════
                         INTRO
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,20,20,0"
                        Spacing="4">

                        <Label
                            Text="Equipment Verification"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Review worker check-ins and physically verify returned equipment."
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         OVERVIEW
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,22,20,0"
                        Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Request Overview"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <Label
                                    Text="&#xf46c;"
                                    FontFamily="FontAwesome"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"/>

                                <Label
                                    Text="Verification"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                            </HorizontalStackLayout>

                        </Grid>


                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <!-- PENDING -->

                            <Border
                                Grid.Column="0"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="12">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf017;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        TextColor="{DynamicResource Amber}"
                                        WidthRequest="32"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding PendingCount}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"/>

                                        <Label
                                            Text="Pending"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>


                            <!-- APPROVED -->

                            <Border
                                Grid.Column="1"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BgCard}"
                                Padding="12">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf058;"
                                        FontFamily="FontAwesome"
                                        FontSize="18"
                                        TextColor="{DynamicResource Green}"
                                        WidthRequest="32"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="1"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ApprovedCount}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"/>

                                        <Label
                                            Text="Processed"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>


                    <!-- LOADING -->

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{DynamicResource Blue}"
                        HorizontalOptions="Center"
                        Margin="0,18,0,0"/>


                    <!-- ═══════════════════════════════════════
                         END-DAY CHECK-IN
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,24,20,0"
                        Spacing="10">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf46c;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Blue}"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1">

                                <Label
                                    Text="End-Day Check-In"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="Verify equipment checked in by workers"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                            </VerticalStackLayout>

                        </Grid>


                        <!-- EMPTY CHECK-IN -->

                        <Border
                            IsVisible="{Binding NoPendingCheckIns}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="24">

                            <VerticalStackLayout
                                Spacing="7"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf058;"
                                    FontFamily="FontAwesome"
                                    FontSize="22"
                                    TextColor="{DynamicResource Green}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No pending check-ins"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Worker end-day check-ins will appear here."
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- CHECK-IN LIST -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding PendingCheckIns}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate x:DataType="models:Tool">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="0">

                                        <VerticalStackLayout Spacing="0">


                                            <!-- TOOL HEADER -->

                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="11"
                                                Padding="14">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf0ad;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="18"
                                                    TextColor="{DynamicResource Blue}"
                                                    WidthRequest="34"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    VerticalOptions="Center"/>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding ToolName}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"/>

                                                    <Label
                                                        Text="{Binding ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>

                                            </Grid>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- DETAILS -->

                                            <VerticalStackLayout
                                                Padding="14,12"
                                                Spacing="10">


                                                <!-- WORKER -->

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="9">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf007;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        WidthRequest="18"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="1">

                                                        <Label
                                                            Text="Worker"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding AssignedWorkerName}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                    </VerticalStackLayout>

                                                </Grid>


                                                <!-- PROJECT -->

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="9">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf1ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        WidthRequest="18"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="1">

                                                        <Label
                                                            Text="Project"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding BorrowedProjectName}"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </VerticalStackLayout>

                                                </Grid>


                                                <!-- LOCATION -->

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="9">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf3c5;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        WidthRequest="18"
                                                        TextColor="{DynamicResource Blue}"
                                                        VerticalOptions="Center"/>

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="1">

                                                        <Label
                                                            Text="Check-In Location"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding LastCheckInLocation}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Blue}"/>

                                                    </VerticalStackLayout>

                                                </Grid>


                                                <!-- TIME -->

                                                <HorizontalStackLayout
                                                    Spacing="6">

                                                    <Label
                                                        Text="&#xf017;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding LastCheckInDate,
                                                            StringFormat='Checked in: {0:MMM d, yyyy h:mm tt}'}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- VERIFY -->

                                            <Button
                                                Text="Verify Check-In"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}},
                                                                  Path=VerifyCheckInCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Blue}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="46"/>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         RETURN VERIFICATION
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,26,20,0"
                        Spacing="10">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf2f6;"
                                FontFamily="FontAwesome"
                                FontSize="14"
                                TextColor="{DynamicResource Green}"
                                VerticalOptions="Center"/>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1">

                                <Label
                                    Text="Return Verification"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="Physically inspect equipment before approving"
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"/>

                            </VerticalStackLayout>

                        </Grid>


                        <!-- EMPTY RETURNS -->

                        <Border
                            IsVisible="{Binding NoPendingReturn}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="24">

                            <VerticalStackLayout
                                Spacing="7"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf058;"
                                    FontFamily="FontAwesome"
                                    FontSize="22"
                                    TextColor="{DynamicResource Green}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No pending returns"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Worker return requests will appear here."
                                    FontSize="10"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- RETURN REQUESTS -->

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding PendingReturnRequests}"
                            Spacing="10">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate x:DataType="models:ReturnRequestResult">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="0">

                                        <VerticalStackLayout Spacing="0">


                                            <!-- TOOL -->

                                            <Grid
                                                ColumnDefinitions="Auto,*,Auto"
                                                ColumnSpacing="11"
                                                Padding="14">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf0ad;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="18"
                                                    TextColor="{DynamicResource Green}"
                                                    WidthRequest="34"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    VerticalOptions="Center"/>

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="3"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{Binding Request.ToolName}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Text1}"/>

                                                    <Label
                                                        Text="{Binding Request.ToolId}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </VerticalStackLayout>


                                                <Border
                                                    Grid.Column="2"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Padding="8,4"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="Pending"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource Amber}"/>

                                                </Border>

                                            </Grid>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- INFORMATION -->

                                            <VerticalStackLayout
                                                Padding="14,12"
                                                Spacing="10">


                                                <!-- WORKER -->

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="9">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf007;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        WidthRequest="18"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="1">

                                                        <Label
                                                            Text="Worker"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding Request.WorkerName}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource Text1}"/>

                                                    </VerticalStackLayout>

                                                </Grid>


                                                <!-- PROJECT -->

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="9">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf1ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        WidthRequest="18"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="1">

                                                        <Label
                                                            Text="Project"
                                                            FontSize="9"
                                                            TextColor="{DynamicResource Text3}"/>

                                                        <Label
                                                            Text="{Binding Request.ProjectName}"
                                                            FontSize="11"
                                                            TextColor="{DynamicResource Text2}"/>

                                                    </VerticalStackLayout>

                                                </Grid>


                                                <!-- REQUEST DATE -->

                                                <HorizontalStackLayout
                                                    Spacing="6">

                                                    <Label
                                                        Text="&#xf073;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding Request.RequestDate,
                                                            StringFormat='Requested: {0:MMM d, yyyy h:mm tt}'}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>


                                                <!-- INSTRUCTION -->

                                                <Border
                                                    BackgroundColor="{DynamicResource BgElevated}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="11">

                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="8">

                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf06a;"
                                                            FontFamily="FontAwesome"
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Green}"
                                                            VerticalOptions="Start"/>

                                                        <Label
                                                            Grid.Column="1"
                                                            Text="Physically receive and inspect the equipment before approving the return."
                                                            FontSize="10"
                                                            TextColor="{DynamicResource Text2}"
                                                            LineBreakMode="WordWrap"/>

                                                    </Grid>

                                                </Border>

                                            </VerticalStackLayout>


                                            <BoxView
                                                HeightRequest="1"
                                                Color="{DynamicResource BorderSoft}"/>


                                            <!-- ACTIONS -->

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                HeightRequest="48">

                                                <Button
                                                    Grid.Column="0"
                                                    Text="Approve Return"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}},
                                                                      Path=ApproveReturnCommand}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Green}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    CornerRadius="0"/>

                                                <Button
                                                    Grid.Column="1"
                                                    Text="Reject"
                                                    CommandParameter="{Binding .}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PauseRequestsViewModel}},
                                                                      Path=RejectReturnCommand}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{DynamicResource Red}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    CornerRadius="0"/>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- ═══════════════════════════════════════
                         RECENTLY PROCESSED
                         ═══════════════════════════════════════ -->

                    <VerticalStackLayout
                        Padding="20,26,20,0"
                        Spacing="10">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf1da;"
                                FontFamily="FontAwesome"
                                FontSize="13"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="Recently Processed"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"
                                VerticalOptions="Center"/>

                        </Grid>


                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding ProcessedReturnRequests}"
                            Spacing="8">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate x:DataType="models:ReturnRequestResult">

                                    <Border
                                        BackgroundColor="{DynamicResource BgCard}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14">

                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                Text="&#xf0ad;"
                                                FontFamily="FontAwesome"
                                                FontSize="15"
                                                TextColor="{DynamicResource Text3}"
                                                WidthRequest="28"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                VerticalOptions="Center"/>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding Request.ToolId}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>

                                                <Label
                                                    Text="{Binding Request.ToolName}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text2}"/>
                                                <Label
                                                    Text="{Binding Request.WorkerName}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text2}"/>

                                                <Label
                                                    Text="{Binding Request.ProjectName}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"/>

                                                <Label
                                                    Text="{Binding Request.RequestDate,
                                                        StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                                    FontSize="9"
                                                    TextColor="{DynamicResource Text3}"/>

                                            </VerticalStackLayout>


                                            <Border
                                                Grid.Column="2"
                                                BackgroundColor="{DynamicResource BgElevated}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Request.Status}"
                                                    FontSize="9"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text2}"/>

                                            </Border>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <!-- FOOTER -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="6"
                        Margin="0,30,0,0">

                        <Label
                            Text="&#xf3ed;"
                            FontFamily="FontAwesome"
                            FontSize="9"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                        <Label
                            Text="StockGuard · Return &amp; Check-In"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
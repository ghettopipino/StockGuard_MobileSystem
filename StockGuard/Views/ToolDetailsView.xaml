<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    xmlns:converters="clr-namespace:StockGuard.Converters"
    x:Class="StockGuard.Views.ToolDetailsView"
    x:DataType="vm:ToolDetailsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <ContentPage.Resources>
        <converters:StatusColorConverter
            x:Key="StatusColorConverter"/>
    </ContentPage.Resources>

    <Grid>

        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <CollectionView
                x:Name="ToolsCollection"
                ItemsSource="{Binding Tools}"
                ItemSizingStrategy="MeasureFirstItem">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10"/>
                </CollectionView.ItemsLayout>


                <!-- ═══════════════════════════════════════
                     HEADER
                     ═══════════════════════════════════════ -->

                <CollectionView.Header>

                    <VerticalStackLayout
                        Spacing="0"
                        Padding="0,0,0,4">


                        <!-- PAGE HEADER -->
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10"
                            Padding="20,52,20,16"
                            BackgroundColor="{DynamicResource BgSurface}">

                            <!-- MENU -->
                            <Button
                                Grid.Column="0"
                                Text="&#xf0c9;"
                                FontFamily="FontAwesome"
                                Command="{Binding OpenFlyoutCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="16"
                                CornerRadius="10"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"/>

                            <!-- TITLE -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="1"
                                VerticalOptions="Center">

                                <Label
                                    Text="Tools"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <Label
                                    Text="Browse and manage equipment"
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"/>

                            </VerticalStackLayout>

                            <!-- REFRESH -->
                            <Button
                                Grid.Column="2"
                                Text="&#xf2f1;"
                                FontFamily="FontAwesome"
                                Command="{Binding RefreshCommand}"
                                BackgroundColor="{DynamicResource BgElevated}"
                                TextColor="{DynamicResource Text2}"
                                FontSize="15"
                                CornerRadius="10"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"/>

                        </Grid>


                        <!-- ═══════════════════════════════════
                             PAGE INTRO
                             ═══════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,20,20,0"
                            Spacing="4">

                            <Label
                                Text="Equipment Inventory"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text1}"/>

                            <Label
                                Text="Filter and review physical equipment records."
                                FontSize="11"
                                TextColor="{DynamicResource Text3}"/>

                        </VerticalStackLayout>


                        <!-- ═══════════════════════════════════
                             INVENTORY OVERVIEW
                             ═══════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,22,20,0"
                            Spacing="10">

                            <Grid
                                ColumnDefinitions="*,Auto">

                                <Label
                                    Grid.Column="0"
                                    Text="Inventory Overview"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text1}"/>

                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf201;"
                                        FontFamily="FontAwesome"
                                        FontSize="9"
                                        TextColor="{DynamicResource Text3}"/>

                                    <Label
                                        Text="Live inventory"
                                        FontSize="10"
                                        TextColor="{DynamicResource Text3}"/>

                                </HorizontalStackLayout>

                            </Grid>


                            <Grid
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="8">


                                <!-- TOTAL -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf0ad;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding TotalTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Total"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- AVAILABLE -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf058;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding AvailableTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Green}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Available"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- BORROWED -->
                                <Border
                                    Grid.Column="2"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="10,12">

                                    <VerticalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Label
                                            Text="&#xf466;"
                                            FontFamily="FontAwesome"
                                            FontSize="17"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="{Binding BorrowedTools}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Amber}"
                                            HorizontalOptions="Center"/>

                                        <Label
                                            Text="Borrowed"
                                            FontSize="9"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>


                        <!-- ═══════════════════════════════════
                             FILTERS
                             ═══════════════════════════════════ -->

                        <VerticalStackLayout
                            Padding="20,20,20,14"
                            Spacing="10">


                            <!-- SEARCH -->
                            <Border
                                Stroke="{DynamicResource InputBorder}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource InputBg}"
                                Padding="12,0">

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="8">

                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf002;"
                                        FontFamily="FontAwesome"
                                        FontSize="12"
                                        TextColor="{DynamicResource Text3}"
                                        VerticalOptions="Center"/>

                                    <Entry
                                        Grid.Column="1"
                                        Text="{Binding SearchText}"
                                        Placeholder="Search by name or ID..."
                                        PlaceholderColor="{DynamicResource Text3}"
                                        TextColor="{DynamicResource Text1}"
                                        BackgroundColor="Transparent"
                                        FontSize="12"
                                        HeightRequest="44"
                                        Margin="0"/>

                                    <Button
                                        Grid.Column="2"
                                        Text="&#xf00d;"
                                        FontFamily="FontAwesome"
                                        Command="{Binding ClearFiltersCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Text3}"
                                        FontSize="12"
                                        WidthRequest="34"
                                        HeightRequest="44"
                                        Padding="0"/>

                                </Grid>

                            </Border>


                            <!-- PICKERS -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">


                                <!-- CATALOG -->
                                <Border
                                    Grid.Column="0"
                                    Stroke="{DynamicResource InputBorder}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource InputBg}"
                                    Padding="0">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="5">

                                        <Label
                                            Grid.Column="0"
                                            Text="&#xf07b;"
                                            FontFamily="FontAwesome"
                                            FontSize="11"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"
                                            Margin="10,0,0,0"/>

                                        <Picker
                                            Grid.Column="1"
                                            ItemsSource="{Binding Catalogs}"
                                            SelectedItem="{Binding SelectedCatalog}"
                                            ItemDisplayBinding="{Binding CatalogName}"
                                            TextColor="{DynamicResource Text1}"
                                            TitleColor="{DynamicResource Text3}"
                                            Title="Select catalog"
                                            FontSize="12"
                                            HeightRequest="52"
                                            Margin="0"
                                            BackgroundColor="Transparent"/>

                                    </Grid>

                                </Border>


                                <!-- STATUS -->
                                <Border
                                    Grid.Column="1"
                                    Stroke="{DynamicResource InputBorder}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource InputBg}"
                                    Padding="0">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="5">

                                        <Label
                                            Grid.Column="0"
                                            Text="&#xf0ae;"
                                            FontFamily="FontAwesome"
                                            FontSize="11"
                                            TextColor="{DynamicResource Text3}"
                                            VerticalOptions="Center"
                                            Margin="10,0,0,0"/>

                                        <Picker
                                            Grid.Column="1"
                                            ItemsSource="{Binding StatusOptions}"
                                            SelectedItem="{Binding SelectedStatus}"
                                            TextColor="{DynamicResource Text1}"
                                            TitleColor="{DynamicResource Text3}"
                                            Title="All Status"
                                            FontSize="12"
                                            HeightRequest="52"
                                            Margin="0"
                                            BackgroundColor="Transparent"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </VerticalStackLayout>


                        <!-- LOADING -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            HorizontalOptions="Center"
                            Margin="0,18"/>


                        <!-- ═══════════════════════════════════
                             SELECT CATALOG EMPTY STATE
                             ═══════════════════════════════════ -->

                        <Border
                            IsVisible="{Binding NoCatalogSelected}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="28"
                            Margin="20,4">

                            <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesome"
                                    FontSize="28"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Select a catalog"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Choose a catalog above to browse its equipment."
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- ═══════════════════════════════════
                             NO RESULTS
                             ═══════════════════════════════════ -->

                        <Border
                            IsVisible="{Binding NoTools}"
                            Stroke="{DynamicResource BorderSoft}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="28"
                            Margin="20,4">

                            <VerticalStackLayout
                                Spacing="10"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf0ad;"
                                    FontFamily="FontAwesome"
                                    FontSize="28"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="No tools found"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Text2}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Try changing your search or status filter."
                                    FontSize="11"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"/>

                                <Button
                                    Text="Clear Filters"
                                    Command="{Binding ClearFiltersCommand}"
                                    BackgroundColor="{DynamicResource Blue}"
                                    TextColor="White"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    Margin="0,6,0,0"/>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                </CollectionView.Header>


                <!-- ═══════════════════════════════════════
                     TOOL CARDS
                     ═══════════════════════════════════════ -->

                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="models:Tool">

                        <Border
                            BackgroundColor="{DynamicResource BgCard}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 14"
                            Margin="20,0"
                            Padding="0">

                            <VerticalStackLayout
                                Spacing="0">


                                <!-- TOOL INFORMATION -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    Padding="14"
                                    ColumnSpacing="12">


                                    <!-- TOOL ICON -->
                                    <Label
                                        Grid.Column="0"
                                        Text="&#xf0ad;"
                                        FontFamily="FontAwesome"
                                        FontSize="20"
                                        TextColor="{DynamicResource Blue}"
                                        WidthRequest="38"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        VerticalOptions="Center"/>


                                    <!-- TOOL DETAILS -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding ToolId}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Blue}"/>

                                        <Label
                                            Text="{Binding ToolName}"
                                            FontSize="11"
                                            TextColor="{DynamicResource Text2}"/>


                                        <!-- STATUS -->
                                        <HorizontalStackLayout
                                            Spacing="5">

                                            <Label
                                                Text="&#xf111;"
                                                FontFamily="FontAwesome"
                                                FontSize="7"
                                                TextColor="{Binding Status,
                                                    Converter={StaticResource StatusColorConverter}}"
                                                VerticalOptions="Center"/>

                                            <Label
                                                Text="{Binding Status}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="{Binding Status,
                                                    Converter={StaticResource StatusColorConverter}}"
                                                VerticalOptions="Center"/>

                                        </HorizontalStackLayout>


                                        <!-- ASSIGNMENT INFO -->
                                        <VerticalStackLayout
                                            IsVisible="{Binding HasAssignmentInfo}"
                                            Spacing="4"
                                            Margin="0,5,0,0">

                                            <!-- WORKER -->
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="6">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf007;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="9"
                                                    TextColor="{DynamicResource Text3}"
                                                    WidthRequest="16"
                                                    VerticalOptions="Center"/>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding AssignedWorkerName}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text2}"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation"/>

                                            </Grid>


                                            <!-- PROJECT -->
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="6">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf1ad;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="9"
                                                    TextColor="{DynamicResource Text3}"
                                                    WidthRequest="16"
                                                    VerticalOptions="Center"/>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding BorrowedProjectName}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text2}"
                                                    LineBreakMode="TailTruncation"/>

                                            </Grid>


                                            <!-- ASSIGNED BY -->
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="6">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="&#xf2bd;"
                                                    FontFamily="FontAwesome"
                                                    FontSize="9"
                                                    TextColor="{DynamicResource Text3}"
                                                    WidthRequest="16"
                                                    VerticalOptions="Center"/>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding AssignedByName}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text2}"
                                                    LineBreakMode="TailTruncation"/>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </VerticalStackLayout>


                                    <!-- CONDITION -->
                                    <VerticalStackLayout
                                        Grid.Column="2"
                                        Spacing="2"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start">

                                        <Label
                                            Text="Condition"
                                            FontSize="8"
                                            TextColor="{DynamicResource Text3}"
                                            HorizontalOptions="End"/>

                                        <Label
                                            Text="{Binding Condition}"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource Text2}"
                                            HorizontalOptions="End"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>


                <!-- ═══════════════════════════════════════
                     FOOTER
                     ═══════════════════════════════════════ -->

                <CollectionView.Footer>

                    <VerticalStackLayout
                        Spacing="0">

                        <!-- LOAD MORE -->
                        <Border
                            IsVisible="{Binding HasMorePages}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource BgCard}"
                            Margin="20,10,20,0"
                            Padding="0">

                            <Button
                                Text="Load More"
                                Command="{Binding Source={x:Reference ToolsCollection},
                                                  Path=BindingContext.LoadMoreCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Blue}"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="46"/>

                        </Border>


                        <!-- FOOTER -->
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="6"
                            Margin="0,24,0,40">

                            <Label
                                Text="&#xf3ed;"
                                FontFamily="FontAwesome"
                                FontSize="9"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="StockGuard · Tools"
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </CollectionView.Footer>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
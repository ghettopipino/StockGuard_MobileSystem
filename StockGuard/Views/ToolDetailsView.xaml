<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             xmlns:converters="clr-namespace:StockGuard.Converters"
             x:Class="StockGuard.Views.ToolDetailsView"
             x:DataType="vm:ToolDetailsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <ContentPage.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
    </ContentPage.Resources>

    <Grid>
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            RefreshColor="{DynamicResource Blue}">

            <CollectionView
                x:Name="ToolsCollection"
                ItemsSource="{Binding Tools}"
                ItemSizingStrategy="MeasureFirstItem">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <!-- ══════════════════════════════════════════════════════
                     HEADER
                     ══════════════════════════════════════════════════════ -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,4">

                        <!-- ── PAGE HEADER ──────────────────────────────── -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="10"
                              Padding="20,52,20,16"
                              BackgroundColor="{DynamicResource BgSurface}">

                            <Button Grid.Column="0"
                                    Text="☰"
                                    Command="{Binding OpenFlyoutCommand}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="18" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="1">
                                <Label Text="Tools "        
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text1}"/>
                                <Label Text="Browse and manage all tools"
                                       FontSize="11"
                                       TextColor="{DynamicResource Text3}"/>
                            </VerticalStackLayout>
                            <!--amp; QR Codes-->

                            <Button Grid.Column="2"
                                    Text="{Binding ThemeIcon}"
                                    Command="{Binding ToggleThemeCommand}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="16" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>

                            <Button Grid.Column="3"
                                    Text="🔄"
                                    Command="{Binding RefreshCommand}"
                                    BackgroundColor="{DynamicResource BgElevated}"
                                    TextColor="{DynamicResource Text2}"
                                    FontSize="16" CornerRadius="8"
                                    WidthRequest="40" HeightRequest="36"
                                    Padding="0"/>
                        </Grid>

                        <!-- ── STATS ROW ────────────────────────────────── -->
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="10"
                              Padding="20,14">

                            <Frame Grid.Column="0"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0"
                                   HasShadow="False">
                                <VerticalStackLayout Padding="10,14" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="🔧" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Blue}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Total" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Column="1"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0"
                                   HasShadow="False">
                                <VerticalStackLayout Padding="10,14" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="✅" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding AvailableTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Green}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Available" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Column="2"
                                   BackgroundColor="{DynamicResource BgCard}"
                                   BorderColor="{DynamicResource BorderColor}"
                                   CornerRadius="14" Padding="0"
                                   HasShadow="False">
                                <VerticalStackLayout Padding="10,14" Spacing="4"
                                    HorizontalOptions="Center">
                                    <Label Text="📦" FontSize="20"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding BorrowedTools}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{DynamicResource Amber}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Borrowed" FontSize="10"
                                           TextColor="{DynamicResource Text3}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- ── FILTERS ──────────────────────────────────── -->
                        <VerticalStackLayout Padding="20,0,20,14" Spacing="10">

                            <!-- Search bar -->
                            <Frame Padding="0" CornerRadius="12"
                                   HasShadow="False"
                                   BorderColor="{DynamicResource InputBorder}"
                                   BackgroundColor="{DynamicResource InputBg}"
                                   HeightRequest="46">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0"
                                           Text="🔍" FontSize="16"
                                           Margin="14,0,0,0"
                                           VerticalOptions="Center"/>
                                    <Entry Grid.Column="1"
                                           Text="{Binding SearchText}"
                                           Placeholder="Search by name or ID…"
                                           PlaceholderColor="{DynamicResource Text3}"
                                           TextColor="{DynamicResource Text1}"
                                           BackgroundColor="Transparent"
                                           FontSize="13"
                                           Margin="8,0"/>
                                    <Button Grid.Column="2"
                                            Text="✕"
                                            Command="{Binding ClearFiltersCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource Text3}"
                                            FontSize="13"
                                            WidthRequest="36"
                                            Padding="0"/>
                                </Grid>
                            </Frame>

                            <!-- Catalog + Status pickers -->
                            <!--
                                CHANGED: Catalog picker title is now "Select a catalog…"
                                (no "All Catalogs" sentinel). Selecting the first item in
                                Catalogs (the placeholder) keeps NoCatalogSelected = true
                                and shows zero tool cards — intentional for performance.
                            -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <Frame Grid.Column="0"
                                       Padding="0" CornerRadius="12"
                                       HasShadow="False"
                                       BorderColor="{DynamicResource InputBorder}"
                                       BackgroundColor="{DynamicResource InputBg}"
                                       HeightRequest="65">
                                    <Picker ItemsSource="{Binding Catalogs}"
                                            SelectedItem="{Binding SelectedCatalog}"
                                            ItemDisplayBinding="{Binding CatalogName}"
                                            TextColor="{DynamicResource Text1}"
                                            TitleColor="{DynamicResource Text3}"
                                            Title="Select a catalog…"
                                            FontSize="13"
                                            Margin="12,0"
                                            BackgroundColor="Transparent"
                                            />
                                </Frame>

                                <Frame Grid.Column="1"
                                       Padding="0" CornerRadius="12"
                                       HasShadow="False"
                                       BorderColor="{DynamicResource InputBorder}"
                                       BackgroundColor="{DynamicResource InputBg}"
                                       HeightRequest="65">
                                    <Picker ItemsSource="{Binding StatusOptions}"
                                            SelectedItem="{Binding SelectedStatus}"
                                            TextColor="{DynamicResource Text1}"
                                            TitleColor="{DynamicResource Text3}"
                                            Title="All Status"
                                            FontSize="13"
                                            Margin="12,0"
                                            BackgroundColor="Transparent"/>
                                </Frame>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── LOADING INDICATOR ────────────────────────── -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource Blue}"
                            HorizontalOptions="Center"
                            Margin="0,20"/>

                        <!-- ── PICK A CATALOG EMPTY STATE ───────────────── -->
                        <!--
                            Shown when NoCatalogSelected = true (default on entry).
                            This is the primary perf gate: no tool cards are inflated
                            until the user explicitly picks a real catalog.
                        -->
                        <Frame IsVisible="{Binding NoCatalogSelected}"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderSoft}"
                               CornerRadius="14" Padding="32"
                               HasShadow="False" Margin="20,4">
                            <VerticalStackLayout Spacing="12"
                                HorizontalOptions="Center">
                                <Label Text="📂" FontSize="52"
                                       HorizontalOptions="Center"/>
                                <Label Text="Select a catalog"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Pick a catalog above to browse its tools"
                                       FontSize="13"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- ── NO RESULTS EMPTY STATE ───────────────────── -->
                        <!--
                            Shown only when a catalog IS selected but the search /
                            status filter returns zero results.
                        -->
                        <Frame IsVisible="{Binding NoTools}"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderSoft}"
                               CornerRadius="14" Padding="32"
                               HasShadow="False" Margin="20,4">
                            <VerticalStackLayout Spacing="12"
                                HorizontalOptions="Center">
                                <Label Text="🔧" FontSize="52"
                                       HorizontalOptions="Center"/>
                                <Label Text="No tools found"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{DynamicResource Text2}"
                                       HorizontalOptions="Center"/>
                                <Label Text="Try adjusting your search or filters"
                                       FontSize="13"
                                       TextColor="{DynamicResource Text3}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                                <Button Text="Clear Filters"
                                        Command="{Binding ClearFiltersCommand}"
                                        BackgroundColor="{DynamicResource Blue}"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="42"
                                        Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- ══════════════════════════════════════════════════════
                     ITEM TEMPLATE
                     ══════════════════════════════════════════════════════ -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tool">

                        <Border BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeShape="RoundRectangle 14"
                                Margin="20,0">

                            <VerticalStackLayout Spacing="0">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="14,14,14,12"
                                      ColumnSpacing="12">

                                    <Border Grid.Column="0"
                                            BackgroundColor="{DynamicResource BlueSubtle}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="Transparent"
                                            WidthRequest="48" HeightRequest="48"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding ToolIcon}"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding ToolId}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource Blue}"/>

                                        <Label Text="{Binding ToolName}"
                                               FontSize="12"
                                               TextColor="{DynamicResource Text2}"/>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{Binding StatusIcon}"
                                                   FontSize="11"/>
                                            <Label Text="{Binding Status}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding Status,
                                                       Converter={StaticResource StatusColorConverter}}"/>
                                        </HorizontalStackLayout>

                                        <Label IsVisible="{Binding IsBorrowed}"
                                               FontSize="11"
                                               TextColor="{DynamicResource Text3}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="👷 "/>
                                                    <Span Text="{Binding AssignedWorkerName}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="{DynamicResource BgElevated}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,4"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding Condition}"
                                               FontSize="10" FontAttributes="Bold"
                                               TextColor="{DynamicResource Text2}"/>
                                    </Border>
                                </Grid>

                                <!--
                                        <BoxView HeightRequest="1"
                                                 Color="{DynamicResource BorderSoft}"/>

                                        <Button Text="📱  Show QR Code"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={x:Reference ToolsCollection},
                                                                  Path=BindingContext.ShowQrCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Blue}"
                                                FontSize="13" FontAttributes="Bold"
                                                HeightRequest="44"/>
                                        -->

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- ══════════════════════════════════════════════════════
                     FOOTER — pagination + copyright
                     ══════════════════════════════════════════════════════ -->
                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="0">

                        <!--
                            LOAD MORE BUTTON
                            Visible only when HasMorePages = true.
                            Uses append (not replace) in the VM so the scroll
                            position is preserved after tapping.
                        -->
                        <Frame IsVisible="{Binding HasMorePages}"
                               BackgroundColor="{DynamicResource BgCard}"
                               BorderColor="{DynamicResource BorderColor}"
                               CornerRadius="12" Padding="0"
                               HasShadow="False"
                               Margin="20,10,20,0">
                            <Button Text="Load more tools…"
                                    Command="{Binding Source={x:Reference ToolsCollection},
                                                      Path=BindingContext.LoadMoreCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Blue}"
                                    FontSize="13" FontAttributes="Bold"
                                    HeightRequest="48"/>
                        </Frame>

                        <Label Text="© 2025 StockGuard"
                               FontSize="10"
                               TextColor="{DynamicResource Text3}"
                               HorizontalOptions="Center"
                               Margin="0,20,0,40"/>
                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>

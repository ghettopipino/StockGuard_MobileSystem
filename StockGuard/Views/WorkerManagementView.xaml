<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StockGuard.ViewModels"
    xmlns:models="clr-namespace:StockGuard.Models"
    x:Class="StockGuard.Views.WorkerManagementView"
    x:DataType="vm:WorkerManagementViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BgBase}">

    <RefreshView
        IsRefreshing="{Binding IsRefreshing}"
        Command="{Binding RefreshCommand}"
        RefreshColor="{DynamicResource Blue}">

        <ScrollView>

            <VerticalStackLayout
                Spacing="0"
                Padding="0,0,0,40">


                <!-- ═══════════════════════════════════════
                     HEADER
                     ═══════════════════════════════════════ -->

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10"
                    Padding="20,52,20,16"
                    BackgroundColor="{DynamicResource BgSurface}">

                    <!-- MENU -->
                    <Button
                        Grid.Column="0"
                        Text="&#xf0c9;"
                        FontFamily="FontAwesome"
                        Command="{Binding OpenFlyoutCommand}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        TextColor="{DynamicResource Text2}"
                        FontSize="16"
                        CornerRadius="10"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"/>

                    <!-- TITLE -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="1"
                        VerticalOptions="Center">

                        <Label
                            Text="Worker Management"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <Label
                            Text="Manage worker accounts and access"
                            FontSize="11"
                            TextColor="{DynamicResource Text3}"/>

                    </VerticalStackLayout>

                    <!-- REFRESH -->
                    <Button
                        Grid.Column="2"
                        Text="&#xf2f1;"
                        FontFamily="FontAwesome"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="{DynamicResource BgElevated}"
                        TextColor="{DynamicResource Text2}"
                        FontSize="15"
                        CornerRadius="10"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"/>

                </Grid>


                <!-- ═══════════════════════════════════════
                     PAGE INTRO
                     ═══════════════════════════════════════ -->

                <VerticalStackLayout
                    Padding="20,20,20,0"
                    Spacing="4">

                    <Label
                        Text="Workers"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text1}"/>

                    <Label
                        Text="Review registrations and manage authorized workers."
                        FontSize="11"
                        TextColor="{DynamicResource Text3}"/>

                </VerticalStackLayout>


                <!-- ═══════════════════════════════════════
                     WORKER OVERVIEW
                     ═══════════════════════════════════════ -->

                <VerticalStackLayout
                    Padding="20,22,20,0"
                    Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="Worker Overview"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"/>

                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Text="&#xf0c0;"
                                FontFamily="FontAwesome"
                                FontSize="9"
                                TextColor="{DynamicResource Text3}"/>

                            <Label
                                Text="Personnel"
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"/>

                        </HorizontalStackLayout>

                    </Grid>


                    <!-- STATS -->
                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="8">


                        <!-- TOTAL -->
                        <Border
                            Grid.Column="0"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="8,12">

                            <VerticalStackLayout
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf0c0;"
                                    FontFamily="FontAwesome"
                                    FontSize="17"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="{Binding TotalWorkers}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Blue}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Total"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- ACTIVE -->
                        <Border
                            Grid.Column="1"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="8,12">

                            <VerticalStackLayout
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf058;"
                                    FontFamily="FontAwesome"
                                    FontSize="17"
                                    TextColor="{DynamicResource Green}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="{Binding ActiveWorkers}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Green}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Active"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>


                        <!-- PENDING -->
                        <Border
                            Grid.Column="2"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource BgCard}"
                            Padding="8,12">

                            <VerticalStackLayout
                                Spacing="4"
                                HorizontalOptions="Center">

                                <Label
                                    Text="&#xf017;"
                                    FontFamily="FontAwesome"
                                    FontSize="17"
                                    TextColor="{DynamicResource Amber}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="{Binding PendingWorkers}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource Amber}"
                                    HorizontalOptions="Center"/>

                                <Label
                                    Text="Pending"
                                    FontSize="9"
                                    TextColor="{DynamicResource Text3}"
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>


                <!-- ═══════════════════════════════════════
                     SEARCH
                     ═══════════════════════════════════════ -->

                <VerticalStackLayout
                    Padding="20,18,20,0">

                    <Border
                        Stroke="{DynamicResource InputBorder}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource InputBg}"
                        Padding="12,0">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="&#xf002;"
                                FontFamily="FontAwesome"
                                FontSize="12"
                                TextColor="{DynamicResource Text3}"
                                VerticalOptions="Center"/>

                            <Entry
                                Grid.Column="1"
                                Text="{Binding SearchText}"
                                Placeholder="Search workers..."
                                PlaceholderColor="{DynamicResource Text3}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Text1}"
                                FontSize="12"
                                HeightRequest="44"
                                Margin="0"/>

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- LOADING -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{DynamicResource Blue}"
                    HorizontalOptions="Center"
                    Margin="0,18,0,0"/>


                <!-- ═══════════════════════════════════════
                     PENDING APPROVALS
                     ═══════════════════════════════════════ -->

                <VerticalStackLayout
                    Padding="20,24,20,0"
                    Spacing="10">

                    <!-- SECTION HEADER -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="8">

                        <Label
                            Grid.Column="0"
                            Text="&#xf017;"
                            FontFamily="FontAwesome"
                            FontSize="14"
                            TextColor="{DynamicResource Amber}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Pending Approvals"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="2"
                            FontSize="10"
                            TextColor="{DynamicResource Text3}"
                            VerticalOptions="Center">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding PendingWorkers}"/>
                                    <Span Text=" pending"/>
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                    </Grid>


                    <!-- EMPTY STATE -->
                    <Border
                        IsVisible="{Binding NoPending}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource BgCard}"
                        Padding="22">

                        <VerticalStackLayout
                            Spacing="7"
                            HorizontalOptions="Center">

                            <Label
                                Text="&#xf058;"
                                FontFamily="FontAwesome"
                                FontSize="21"
                                TextColor="{DynamicResource Green}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No pending approvals"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="New worker registrations will appear here."
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- PENDING WORKERS -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding PendingApprovals}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:WorkerDisplayItem">

                                <Border
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="0">

                                    <VerticalStackLayout Spacing="0">


                                        <!-- WORKER INFO -->
                                        <Grid
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="12"
                                            Padding="14">

                                            <!-- ICON -->
                                            <Label
                                                Grid.Column="0"
                                                Text="&#xf007;"
                                                FontFamily="FontAwesome"
                                                FontSize="19"
                                                TextColor="{DynamicResource Amber}"
                                                WidthRequest="36"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                VerticalOptions="Center"/>


                                            <!-- DETAILS -->
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4">

                                                <Label
                                                    Text="{Binding FullName}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"/>

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="6">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf0e0;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Email}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"
                                                        LineBreakMode="TailTruncation"/>

                                                </Grid>


                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="6">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf073;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding JoinedLabel,
                                                            StringFormat='Registered: {0}'}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text3}"/>

                                                </Grid>

                                            </VerticalStackLayout>

                                        </Grid>


                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <!-- ACTIONS -->
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="0"
                                            HeightRequest="46">

                                            <Button
                                                Grid.Column="0"
                                                Text="Approve"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}},
                                                                  Path=ApproveCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Green}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                CornerRadius="0"/>

                                            <Button
                                                Grid.Column="1"
                                                Text="Reject"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}},
                                                                  Path=RejectCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Red}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                CornerRadius="0"/>

                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>


                <!-- ═══════════════════════════════════════
                     APPROVED WORKERS
                     ═══════════════════════════════════════ -->

                <VerticalStackLayout
                    Padding="20,26,20,0"
                    Spacing="10">

                    <!-- SECTION HEADER -->
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="8">

                        <Label
                            Grid.Column="0"
                            Text="&#xf0c0;"
                            FontFamily="FontAwesome"
                            FontSize="14"
                            TextColor="{DynamicResource Blue}"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Approved Workers"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Text1}"
                            VerticalOptions="Center"/>

                    </Grid>


                    <!-- EMPTY STATE -->
                    <Border
                        IsVisible="{Binding NoApproved}"
                        Stroke="{DynamicResource BorderSoft}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource BgCard}"
                        Padding="22">

                        <VerticalStackLayout
                            Spacing="7"
                            HorizontalOptions="Center">

                            <Label
                                Text="&#xf0c0;"
                                FontFamily="FontAwesome"
                                FontSize="21"
                                TextColor="{DynamicResource Text3}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="No approved workers"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource Text2}"
                                HorizontalOptions="Center"/>

                            <Label
                                Text="Approved worker accounts will appear here."
                                FontSize="10"
                                TextColor="{DynamicResource Text3}"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- APPROVED WORKERS -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding ApprovedWorkers}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate
                                x:DataType="models:WorkerDisplayItem">

                                <Border
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="0">

                                    <VerticalStackLayout Spacing="0">


                                        <!-- WORKER -->
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="12"
                                            Padding="14">

                                            <!-- ICON -->
                                            <Label
                                                Grid.Column="0"
                                                Text="&#xf007;"
                                                FontFamily="FontAwesome"
                                                FontSize="19"
                                                TextColor="{DynamicResource Blue}"
                                                WidthRequest="36"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                VerticalOptions="Center"/>


                                            <!-- DETAILS -->
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding FullName}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Text1}"
                                                    LineBreakMode="TailTruncation"/>

                                                <Label
                                                    Text="{Binding Email}"
                                                    FontSize="10"
                                                    TextColor="{DynamicResource Text3}"
                                                    LineBreakMode="TailTruncation"/>


                                                <HorizontalStackLayout
                                                    Spacing="5">

                                                    <Label
                                                        Text="&#xf0ad;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="9"
                                                        TextColor="{DynamicResource Text3}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding ToolsLabel}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource Text2}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>


                                            <!-- ACTIVITY -->
                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Spacing="3"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="Status"
                                                    FontSize="8"
                                                    TextColor="{DynamicResource Text3}"
                                                    HorizontalOptions="End"/>

                                                <HorizontalStackLayout
                                                    Spacing="4"
                                                    HorizontalOptions="End">

                                                    <Label
                                                        Text="&#xf111;"
                                                        FontFamily="FontAwesome"
                                                        FontSize="6"
                                                        TextColor="{Binding ActivityColor}"
                                                        VerticalOptions="Center"/>

                                                    <Label
                                                        Text="{Binding ActivityStatus}"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{Binding ActivityColor}"
                                                        VerticalOptions="Center"/>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>

                                        </Grid>


                                        <BoxView
                                            HeightRequest="1"
                                            Color="{DynamicResource BorderSoft}"/>


                                        <!-- ACTIONS -->
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            HeightRequest="46">

                                            <Button
                                                Grid.Column="0"
                                                Text="View Details"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}},
                                                                  Path=ViewWorkerCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Blue}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                CornerRadius="0"/>

                                            <Button
                                                Grid.Column="1"
                                                Text="Remove"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}},
                                                                  Path=RemoveWorkerCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Red}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                CornerRadius="0"/>

                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>


                <!-- FOOTER -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="6"
                    Margin="0,30,0,0">

                    <Label
                        Text="&#xf3ed;"
                        FontFamily="FontAwesome"
                        FontSize="9"
                        TextColor="{DynamicResource Text3}"
                        VerticalOptions="Center"/>

                    <Label
                        Text="StockGuard · Worker Management"
                        FontSize="10"
                        TextColor="{DynamicResource Text3}"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

    </RefreshView>

</ContentPage>
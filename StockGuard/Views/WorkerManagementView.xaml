<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StockGuard.ViewModels"
             xmlns:models="clr-namespace:StockGuard.Models"
             x:Class="StockGuard.Views.WorkerManagementView"
             x:DataType="vm:WorkerManagementViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgBase}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}"
                 RefreshColor="{DynamicResource Blue}">
        <ScrollView>
            <VerticalStackLayout Padding="20,52,20,40" Spacing="16">

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Text="☰"
                            Command="{Binding OpenFlyoutCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="18"/>
                    <Label Grid.Column="1" Text="Worker Management"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource Text1}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="2" Text="↻"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Text2}"
                            FontSize="16"/>
                </Grid>

                <Label FontSize="13" TextColor="{DynamicResource Text2}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding TotalWorkers}" FontAttributes="Bold"/>
                            <Span Text=" total  ·  "/>
                            <Span Text="{Binding ActiveWorkers}" FontAttributes="Bold"/>
                            <Span Text=" active  ·  "/>
                            <Span Text="{Binding PendingWorkers}" FontAttributes="Bold"/>
                            <Span Text=" pending"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Entry Text="{Binding SearchText}"
                       Placeholder="Search workers..."
                       BackgroundColor="{DynamicResource InputBg}"
                       TextColor="{DynamicResource Text1}"
                       HeightRequest="44"/>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource Blue}"
                                   HorizontalOptions="Center"/>

                <!-- Pending -->
                <Label Text="Pending Approvals" FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource Text1}"/>

                <Label Text="No pending approvals"
                       IsVisible="{Binding NoPending}"
                       FontSize="13" TextColor="{DynamicResource Text3}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingApprovals}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkerDisplayItem">
                            <Border Stroke="{DynamicResource Amber}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold"
                                           TextColor="{DynamicResource Text1}"/>
                                    <Label Text="{Binding Email}" FontSize="12" TextColor="{DynamicResource Text3}"/>
                                    <Label Text="{Binding JoinedLabel, StringFormat='Registered: {0}'}"
                                           FontSize="11" TextColor="{DynamicResource Text3}"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                                        <Button Grid.Column="0" Text="Approve"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}}, Path=ApproveCommand}"
                                                BackgroundColor="{DynamicResource Green}"
                                                TextColor="White" FontAttributes="Bold"
                                                HeightRequest="40"/>
                                        <Button Grid.Column="1" Text="Reject"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}}, Path=RejectCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Red}"
                                                BorderColor="{DynamicResource Red}" BorderWidth="1"
                                                FontAttributes="Bold"
                                                HeightRequest="40"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Approved -->
                <Label Text="Approved Workers" FontSize="15" FontAttributes="Bold"
                       TextColor="{DynamicResource Text1}" Margin="0,10,0,0"/>

                <Label Text="No approved workers yet"
                       IsVisible="{Binding NoApproved}"
                       FontSize="13" TextColor="{DynamicResource Text3}"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ApprovedWorkers}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkerDisplayItem">
                            <Border Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource BgCard}"
                                    Padding="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource Text1}"/>
                                        <Label Text="{Binding Email}" FontSize="12" TextColor="{DynamicResource Text3}"/>
                                        <Label FontSize="11" TextColor="{DynamicResource Text2}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ToolsLabel}"/>
                                                    <Span Text="  ·  "/>
                                                    <Span Text="{Binding ActivityStatus}" TextColor="{Binding ActivityColor}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Button Text="View"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}}, Path=ViewWorkerCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Blue}" FontSize="12"/>
                                        <Button Text="Remove"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkerManagementViewModel}}, Path=RemoveWorkerCommand}"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Red}" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
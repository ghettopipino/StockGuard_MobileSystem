<?xml version="1.0" encoding="utf-8" ?>

<Shell
    x:Class="StockGuard.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StockGuard.Views"
    xmlns:converters="clr-namespace:StockGuard.Converters"
    FlyoutBehavior="Flyout"
    FlyoutWidth="272"
    Shell.NavBarIsVisible="False"
    FlyoutBackgroundColor="{DynamicResource BgSurface}">

    <!-- ============================================================
         RESOURCES
    ============================================================= -->
    <Shell.Resources>

        <!--
            Flyout navigation button style.

            Button does NOT support:
            HorizontalTextAlignment
            VerticalTextAlignment

            ContentLayout is used instead.
        -->
        <Style x:Key="FlyoutItemStyle"
               TargetType="Button">

            <Setter Property="BackgroundColor"
                    Value="Transparent"/>

            <Setter Property="TextColor"
                    Value="{DynamicResource Text2}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="HorizontalOptions"
                    Value="Fill"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="HeightRequest"
                    Value="46"/>

            <!-- Position button content toward the left -->
            <Setter Property="ContentLayout"
                    Value="Left,0"/>

            <!-- Left padding -->
            <Setter Property="Padding"
                    Value="14,0,0,0"/>

        </Style>


        <!-- Converts pending counts to visibility -->
        <converters:IntToBoolConverter
            x:Key="IntToBoolConverter"/>

    </Shell.Resources>


    <!-- ============================================================
         SHELL PAGES
    ============================================================= -->


    <!-- LOGIN -->
    <ShellContent
        Route="LoginView"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate views:LoginView}"/>


    <!-- WORKER DASHBOARD -->
    <ShellContent
        Route="WorkerDashboardView"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate views:WorkerDashboardView}"/>


    <!-- PROJECT ENGINEER DASHBOARD -->
    <FlyoutItem
        Route="PEDashboardView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="PEDashboardView"
            ContentTemplate="{DataTemplate views:PEDashboardView}"/>

    </FlyoutItem>


    <!-- PROJECT MANAGEMENT -->
    <FlyoutItem
        Route="ProjectManagementView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="ProjectManagementView"
            ContentTemplate="{DataTemplate views:ProjectManagementView}"/>

    </FlyoutItem>


    <!-- EQUIPMENT CATALOG -->
    <FlyoutItem
        Route="EquipmentCatalogView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="EquipmentCatalogView"
            ContentTemplate="{DataTemplate views:EquipmentCatalogView}"/>

    </FlyoutItem>


    <!-- TOOL DETAILS -->
    <FlyoutItem
        Route="ToolDetailsView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="ToolDetailsView"
            ContentTemplate="{DataTemplate views:ToolDetailsView}"/>

    </FlyoutItem>


    <!-- WORKER MANAGEMENT -->
    <FlyoutItem
        Route="WorkerManagementView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="WorkerManagementView"
            ContentTemplate="{DataTemplate views:WorkerManagementView}"/>

    </FlyoutItem>


    <!-- RETURN AND CHECK-IN -->
    <FlyoutItem
        Route="PauseRequestsView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="PauseRequestsView"
            ContentTemplate="{DataTemplate views:PauseRequestsView}"/>

    </FlyoutItem>


    <!-- DAMAGE REPORT -->
    <FlyoutItem
        Route="DamageReportsView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="DamageReportsView"
            ContentTemplate="{DataTemplate views:DamageReportsView}"/>

    </FlyoutItem>


    <!-- TRANSACTION HISTORY -->
    <FlyoutItem
        Route="TransactionHistoryView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="TransactionHistoryView"
            ContentTemplate="{DataTemplate views:TransactionHistoryView}"/>

    </FlyoutItem>


    <!-- PROJECT ANALYTICS -->
    <FlyoutItem
        Route="ProjectAnalyticsView"
        FlyoutItemIsVisible="False">

        <ShellContent
            Route="ProjectAnalyticsView"
            ContentTemplate="{DataTemplate views:ProjectAnalyticsView}"/>

    </FlyoutItem>



    <!-- ============================================================
         CUSTOM FLYOUT
    ============================================================= -->

    <Shell.FlyoutContent>

        <Grid
            RowDefinitions="Auto,*,Auto"
            BackgroundColor="{DynamicResource BgSurface}">


            <!-- ====================================================
                 HEADER
            ===================================================== -->

            <VerticalStackLayout
                Grid.Row="0"
                Padding="24,52,24,20"
                Spacing="4"
                BackgroundColor="{DynamicResource BgElevated}">

                <Label
                    Text="StockGuard"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource Text1}"/>

                <Label
                    Text="Admin Panel"
                    FontSize="12"
                    TextColor="{DynamicResource Text3}"/>

            </VerticalStackLayout>



            <!-- ====================================================
                 NAVIGATION
            ===================================================== -->

            <ScrollView Grid.Row="1">

                <VerticalStackLayout
                    Padding="12,16,12,8"
                    Spacing="2">


                    <!-- ============================================
                         MAIN
                    ============================================= -->

                    <Label
                        Text="MAIN"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text3}"
                        CharacterSpacing="2"
                        Margin="12,0,0,6"/>


                    <!-- DASHBOARD -->
                    <Button
                        x:Name="BtnDashboard"
                        Text="Dashboard"
                        Clicked="OnDashboardClicked"
                        Style="{StaticResource FlyoutItemStyle}"/>



                    <!-- ============================================
                         OPERATIONS
                    ============================================= -->

                    <Label
                        Text="OPERATIONS"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text3}"
                        CharacterSpacing="2"
                        Margin="12,16,0,6"/>


                    <!-- PROJECTS -->
                    <Button
                        x:Name="BtnProjects"
                        Text="Projects"
                        Clicked="OnProjectsClicked"
                        Style="{StaticResource FlyoutItemStyle}"/>


                    <!-- EQUIPMENT CATALOG -->
                    <Button
                        x:Name="BtnCatalog"
                        Text="Equipment Catalog"
                        Clicked="OnCatalogClicked"
                        Style="{StaticResource FlyoutItemStyle}"/>


                    <!-- TOOLS -->
                    <Button
                        x:Name="BtnTools"
                        Text="Tools"
                        Clicked="OnToolsClicked"
                        Style="{StaticResource FlyoutItemStyle}"/>



                    <!-- ============================================
                         WORKERS + PENDING BADGE
                    ============================================= -->

                    <Grid>

                        <Button
                            x:Name="BtnWorkers"
                            Text="Workers"
                            Clicked="OnWorkersClicked"
                            Style="{StaticResource FlyoutItemStyle}"/>


                        <Frame
                            IsVisible="{Binding PendingWorkers,
                                Converter={StaticResource IntToBoolConverter}}"
                            BackgroundColor="#ef4444"
                            BorderColor="Transparent"
                            CornerRadius="10"
                            WidthRequest="22"
                            HeightRequest="22"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,10,0">

                            <Label
                                Text="{Binding PendingWorkers}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Frame>

                    </Grid>



                    <!-- ============================================
                         REPORTS & ADMIN
                    ============================================= -->

                    <Label
                        Text="REPORTS &amp; ADMIN"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource Text3}"
                        CharacterSpacing="2"
                        Margin="12,16,0,6"/>



                    <!-- ============================================
                         RETURN AND CHECK-IN + BADGE
                    ============================================= -->

                    <Grid>

                        <Button
                            x:Name="BtnPause"
                            Text="Return and Check-In"
                            Clicked="OnPauseClicked"
                            Style="{StaticResource FlyoutItemStyle}"/>


                        <Frame
                            IsVisible="{Binding PendingReturnCheckIn,
                                Converter={StaticResource IntToBoolConverter}}"
                            BackgroundColor="#ef4444"
                            BorderColor="Transparent"
                            CornerRadius="10"
                            WidthRequest="22"
                            HeightRequest="22"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,10,0">

                            <Label
                                Text="{Binding PendingReturnCheckIn}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Frame>

                    </Grid>



                    <!-- ============================================
                         DAMAGE REPORT + BADGE
                    ============================================= -->

                    <Grid>

                        <Button
                            x:Name="BtnDamage"
                            Text="Damage Report"
                            Clicked="OnDamageClicked"
                            Style="{StaticResource FlyoutItemStyle}"/>


                        <Frame
                            IsVisible="{Binding PendingDamage,
                                Converter={StaticResource IntToBoolConverter}}"
                            BackgroundColor="#ef4444"
                            BorderColor="Transparent"
                            CornerRadius="10"
                            WidthRequest="22"
                            HeightRequest="22"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,10,0">

                            <Label
                                Text="{Binding PendingDamage}"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Frame>

                    </Grid>



                    <!-- ============================================
                         TRANSACTIONS + BADGE
                    ============================================= -->

                    <Grid>

                        <Button
                            x:Name="BtnTransactions"
                            Text="Transactions"
                            Clicked="OnTransactionsClicked"
                            Style="{StaticResource FlyoutItemStyle}"/>


                        <Frame
                            IsVisible="{Binding PendingReturnCheckIn,
                                Converter={StaticResource IntToBoolConverter}}"
                            BackgroundColor="#ef4444"
                            BorderColor="Transparent"
                            CornerRadius="10"
                            WidthRequest="22"
                            HeightRequest="22"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,10,0">

                            <Label
                            Text="{Binding PendingReturnCheckIn}"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                        </Frame>

                    </Grid>



                    <!-- ============================================
                         ANALYTICS
                         Currently disabled
                    =============================================

                    <Button
                        x:Name="BtnAnalytics"
                        Text="Analytics"
                        Clicked="OnAnalyticsClicked"
                        Style="{StaticResource FlyoutItemStyle}"/>

                    -->


                </VerticalStackLayout>

            </ScrollView>



            <!-- ====================================================
                 LOGOUT
            ===================================================== -->

            <VerticalStackLayout
                Grid.Row="2"
                Padding="12,12,12,36"
                Spacing="0">


                <!-- DIVIDER -->
                <BoxView
                    HeightRequest="1"
                    Color="{DynamicResource BorderSoft}"
                    Margin="0,0,0,12"/>


                <!-- LOGOUT BUTTON -->
                <Button
                    Text="Logout"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="{DynamicResource RedBg}"
                    TextColor="{DynamicResource Red}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    CornerRadius="12"
                    HeightRequest="48"
                    ContentLayout="Left,0"
                    Padding="14,0,0,0"/>


            </VerticalStackLayout>


        </Grid>

    </Shell.FlyoutContent>

</Shell>
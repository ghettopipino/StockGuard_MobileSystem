@using StockGuard.Web.Models
@{
    ViewData["Title"] = ViewBag.Project?.ProjectName
        ?? "Project Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        ⚠️ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (ViewBag.Project != null)
{
    var project = (StockGuard.Web.Models.Project)ViewBag.Project;

    var assignedWorkers =
        ViewBag.AssignedWorkers as List<User>
        ?? new List<User>();

    var deployedTools =
        ViewBag.DeployedTools as List<Tool>
        ?? new List<Tool>();

    var availableWorkers =
        ViewBag.AvailableWorkers as List<User>
        ?? new List<User>();

    var availableTools =
        ViewBag.AvailableTools as List<Tool>
        ?? new List<Tool>();

    var workerProjectMap =
        ViewBag.WorkerProjectMap as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    <!-- Project Info -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="fw-bold mb-1">@project.ProjectName</h5>
                    <div style="font-size:13px; color:#94a3b8">
                        📍 @project.Location
                    </div>
                    @if (!string.IsNullOrEmpty(project.Description))
                    {
                        <div style="font-size:13px; color:#94a3b8; margin-top:4px">
                            @project.Description
                        </div>
                    }
                </div>
                <span class="@project.StatusBadgeClass fs-6">
                    @project.Status
                </span>
            </div>

            <div class="row g-3 text-center">
                <div class="col-3">
                    <div class="fw-bold fs-4 text-primary">@assignedWorkers.Count</div>
                    <div style="font-size:11px; color:#94a3b8">Workers</div>
                </div>
                <div class="col-3">
                    <div class="fw-bold fs-4 text-success">@deployedTools.Count</div>
                    <div style="font-size:11px; color:#94a3b8">Tools</div>
                </div>
                <div class="col-3">
                    <div class="fw-bold fs-4 text-warning">@ViewBag.BorrowedCount</div>
                    <div style="font-size:11px; color:#94a3b8">Assigned</div>
                </div>
                <div class="col-3">
                    <div class="fw-bold" style="font-size:13px">@project.DurationLabel</div>
                    <div style="font-size:11px; color:#94a3b8">Duration</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- Workers -->
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold" style="font-size:14px">
                        👷 Workers (@assignedWorkers.Count)
                    </span>
                    @if (project.Status == "Active")
                    {
                        <button class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#assignWorkerModal">
                            ➕
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (assignedWorkers.Count > 0)
                    {
                        @foreach (var w in assignedWorkers)
                        {
                            var wTools = deployedTools
                            .Where(t => t.AssignedWorkerId == w.UniqueKey)
                            .ToList();
                            <div class="d-flex align-items-center justify-content-between p-3"
                                 style="border-bottom:1px solid #1e3a5f">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="worker-avatar"
                                         style="width:32px; height:32px; font-size:12px">
                                        @w.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="font-size:13px">@w.FullName</div>
                                        <div style="font-size:11px; color:#94a3b8">
                                            @wTools.Count tool(s) assigned
                                        </div>
                                    </div>
                                </div>
                                @if (project.Status == "Active")
                                {
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary"
                                                onclick="openBulkAssign('@w.UniqueKey', '@w.FullName')"
                                                title="Bulk assign tools">
                                            🔧
                                        </button>
                                        <form method="post" action="/Project/RemoveWorker">
                                            <input type="hidden" name="projectId" value="@project.ProjectId" />
                                            <input type="hidden" name="workerKey" value="@w.UniqueKey" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-secondary" style="font-size:13px">
                            No workers assigned yet
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Deployed Tools -->
        <div class="col-12 col-md-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold" style="font-size:14px">
                        🔧 Deployed Tools (@deployedTools.Count)
                    </span>
                    @if (project.Status == "Active")
                    {
                        <button class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#deployToolModal">
                            ➕ Deploy
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (deployedTools.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Tool</th>
                                        <th>Status</th>
                                        <th>Assigned To</th>
                                        @if (project.Status == "Active")
                                        {
                                            <th>Action</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tool in deployedTools)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold" style="font-size:13px">@tool.ToolName</div>
                                                <code style="font-size:11px">@tool.ToolId</code>
                                            </td>
                                            <td>
                                                <span class="@tool.StatusBadgeClass">@tool.Status</span>
                                            </td>
                                            <td style="font-size:12px">
                                                @if (string.IsNullOrEmpty(tool.AssignedWorkerName))
                                                {
                                                    <span style="color:#94a3b8">—</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold" style="color:#3b82f6">
                                                        @tool.AssignedWorkerName
                                                    </span>
                                                }
                                            </td>
                                            @if (project.Status == "Active")
                                            {
                                                <td>
                                                    @if (string.IsNullOrEmpty(tool.AssignedWorkerId))
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary"
                                                                onclick="openSingleAssign('@tool.ToolId', '@tool.ToolName')">
                                                            👤 Assign
                                                        </button>
                                                    }
                                                    else if (tool.Status != "Damaged" && tool.Status != "Lost")
                                                    {
                                                        <form method="post" action="/Project/UnassignTool" style="display:inline">
                                                            <input type="hidden" name="projectId" value="@project.ProjectId" />
                                                            <input type="hidden" name="toolId" value="@tool.ToolId" />
                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-warning"
                                                                    onclick="return confirm('Unassign this tool?')">
                                                                ✕ Unassign
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span style="font-size:11px; color:#94a3b8">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-secondary" style="font-size:13px">
                            No tools deployed yet
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Assignment Summary -->
    @if (assignedWorkers.Count > 0 && project.Status == "Active")
    {
        <div class="card mb-4">
            <div class="card-header">
                <span class="fw-bold" style="font-size:14px">📋 Assignment Summary</span>
                <small class="text-secondary ms-2" style="font-size:12px">
                    Click 🔧 to bulk assign tools to a worker
                </small>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Worker</th>
                            <th>Assigned Tools</th>
                            <th>Count</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in assignedWorkers)
                        {
                            var wTools = deployedTools
                            .Where(t => t.AssignedWorkerId == w.UniqueKey)
                            .ToList();
                            <tr>
                                <td>
                                    <div class="fw-bold" style="font-size:13px">@w.FullName</div>
                                    <div style="font-size:11px; color:#94a3b8">@w.Email</div>
                                </td>
                                <td>
                                    @if (wTools.Count > 0)
                                    {
                                        @foreach (var t in wTools)
                                        {
                                            <span class="badge bg-primary me-1 mb-1" style="font-size:11px">
                                                @t.ToolId @t.ToolName
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8; font-size:12px">No tools assigned</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(wTools.Count > 0 ? "bg-success" : "bg-secondary")"
                                          style="font-size:13px">
                                        @wTools.Count
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary"
                                            onclick="openBulkAssign('@w.UniqueKey', '@w.FullName')">
                                        🔧 Bulk Assign
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════
         MODALS
    ══════════════════════════════════════════════ -->
    <!-- Assign Worker Modal -->
    <div class="modal fade" id="assignWorkerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">➕ Assign Workers</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (availableWorkers.Count > 0)
                    {
                        @foreach (var w in availableWorkers)
                        {
                            // availableWorkers is already filtered server-side to exclude
                            // workers on other active projects, so isOccupied will never
                            // be true here — but we keep the map check for display safety.
                            var isOccupied = workerProjectMap.ContainsKey(w.UniqueKey);
                            var occupiedProject = isOccupied ? workerProjectMap[w.UniqueKey] : null;

                            <div class="d-flex justify-content-between align-items-center p-2 mb-2"
                                 style="background:@(isOccupied ? "#1a1a2e" : "#111d33");
                                                    border-radius:8px;
                                                    opacity:@(isOccupied ? "0.6" : "1")">
                                <div>
                                    <div class="fw-bold" style="font-size:13px">@w.FullName</div>
                                    <div style="font-size:11px; color:#94a3b8">@w.Email</div>
                                    @if (isOccupied)
                                    {
                                        <span class="badge bg-warning text-dark mt-1" style="font-size:10px">
                                            📌 @occupiedProject
                                        </span>
                                    }
                                </div>
                                @if (!isOccupied)
                                {
                                    <form method="post" action="/Project/AssignWorker">
                                        <input type="hidden" name="projectId" value="@project.ProjectId" />
                                        <input type="hidden" name="workerKey" value="@w.UniqueKey" />
                                        <button type="submit" class="btn btn-sm btn-primary">➕ Assign</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-secondary disabled">Occupied</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-secondary text-center" style="font-size:13px">
                            No workers available — all are assigned to active projects
                        </p>
                    }
                </div>
                @if (availableWorkers.Any(w => !workerProjectMap.ContainsKey(w.UniqueKey)))
                {
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary"
                                data-bs-dismiss="modal"
                                data-bs-toggle="modal"
                                data-bs-target="#bulkAssignWorkersModal">
                            👥 Bulk Assign
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bulk Assign Workers Modal -->
    <div class="modal fade" id="bulkAssignWorkersModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">👥 Bulk Assign Workers</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/Project/BulkAssignWorkers">
                    <input type="hidden" name="projectId" value="@project.ProjectId" />
                    <div class="modal-body">
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="selectAllWorkers()">
                                ✅ Select All
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    onclick="clearAllWorkers()">
                                Clear
                            </button>
                            <span id="selectedWorkerCount" class="my-auto text-secondary"
                                  style="font-size:13px">0 selected</span>
                        </div>

                        @foreach (var w in availableWorkers)
                        {
                            var isOccupied = workerProjectMap.ContainsKey(w.UniqueKey);
                            var occupiedProject = isOccupied ? workerProjectMap[w.UniqueKey] : null;

                            <div class="d-flex align-items-center gap-3 p-3 mb-2 worker-row"
                                 style="background:@(isOccupied ? "#1a1a2e" : "#111d33");
                                                border-radius:8px;
                                                opacity:@(isOccupied ? "0.5" : "1");
                                                cursor:@(isOccupied ? "not-allowed" : "pointer");
                                                border:1px solid transparent"
                                 onclick="@(!isOccupied ? "toggleWorker(this)" : "")">
                                <input type="checkbox"
                                       name="workerKeys"
                                       value="@w.UniqueKey"
                                       class="worker-checkbox form-check-input"
                                       style="width:18px; height:18px; cursor:pointer"
                                       @(isOccupied ? "disabled" : "")
                                       onchange="updateWorkerCount()" />
                                <div class="flex-grow-1">
                                    <div class="fw-bold" style="font-size:13px">@w.FullName</div>
                                    <div style="font-size:11px; color:#94a3b8">@w.Email</div>
                                    @if (isOccupied)
                                    {
                                        <span class="badge bg-warning text-dark mt-1" style="font-size:10px">
                                            📌 @occupiedProject
                                        </span>
                                    }
                                </div>
                                @if (isOccupied)
                                {
                                    <span class="badge bg-secondary">Occupied</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" id="bulkAssignWorkersBtn"
                                class="btn btn-primary" disabled>
                            👥 Assign Selected Workers
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Deploy Tool Modal -->
    <div class="modal fade" id="deployToolModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">➕ Deploy Tools to Project</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/Project/BulkDeployTools">
                    <input type="hidden" name="projectId" value="@project.ProjectId" />
                    <div class="modal-body">

                        <!-- Step 1 — Catalog Selector -->
                        <div class="mb-3">
                            <label style="font-size:12px; color:#94a3b8">
                                Step 1 — Select a Catalog
                            </label>
                            <select id="deployCatalogSelect" class="form-select"
                                    onchange="filterDeployTools()">
                                <option value="">— Select Catalog —</option>
                                @{
                                    var allCatalogs = ViewBag.AllCatalogs as
                                    List<StockGuard.Web.Models.EquipmentCatalog>
                                    ?? new List<StockGuard.Web.Models.EquipmentCatalog>();

                                    // FIX: trim catalog IDs to remove any whitespace from Razor rendering
                                    var deployCatalogIds = availableTools
                                    .Select(t => t.CatalogId.Trim())
                                    .Distinct()
                                    .ToList();
                                }
                                @foreach (var catId in deployCatalogIds)
                                {
                                    var catalog = allCatalogs.FirstOrDefault(c => c.CatalogId.Trim() == catId);
                                    var catName = catalog?.CatalogName ?? catId;
                                    var count = availableTools.Count(t => t.CatalogId.Trim() == catId);
                                    <option value="@catId">@catName — @count tool(s) available</option>
                                }
                            </select>
                        </div>

                        <!-- Step 2 — Tool Selection -->
                        <div id="deployToolSection" style="display:none">
                            <label style="font-size:12px; color:#94a3b8">
                                Step 2 — Select Tools to Deploy
                            </label>
                            <div class="d-flex gap-2 my-2">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="selectAllDeployTools()">
                                    ✅ Select All
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="clearAllDeployTools()">
                                    Clear
                                </button>
                                <span id="deployToolCount" class="my-auto text-secondary"
                                      style="font-size:13px">0 selected</span>
                            </div>

                            <div id="deployToolRows">
                                @foreach (var t in availableTools)
                                {
                                    // FIX: store trimmed catalog id in data attribute to guarantee
                                    // exact match with the <select> option value in JS comparison
                                    <div class="deploy-tool-row"
                                         data-catalog="@t.CatalogId.Trim()"
                                         style="display:none; background:#111d33; border-radius:8px;
                                                        cursor:pointer; border:1px solid transparent;
                                                        padding:12px; margin-bottom:8px;"
                                         onclick="toggleDeployTool(this)">
                                        <div class="d-flex align-items-center gap-3">
                                            <input type="checkbox"
                                                   name="toolIds"
                                                   value="@t.ToolId"
                                                   class="deploy-tool-checkbox form-check-input"
                                                   style="width:18px; height:18px; cursor:pointer"
                                                   onchange="updateDeployCount()" />
                                            <div class="flex-grow-1">
                                                <div class="fw-bold" style="font-size:13px">@t.ToolName</div>
                                                <code style="color:#60a5fa; font-size:11px">@t.ToolId</code>
                                            </div>
                                            <span class="@t.StatusBadgeClass">@t.Status</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div id="noToolsMsg" class="text-center text-secondary p-3"
                                 style="display:none; font-size:13px">
                                No available tools in this catalog.
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" id="deployToolsBtn"
                                class="btn btn-primary" disabled>
                            ➕ Deploy Selected Tools
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bulk Assign Tools Modal -->
    <div class="modal fade" id="bulkAssignModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="bulkAssignTitle">🔧 Bulk Assign Tools</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/Project/BulkAssignTools">
                    <input type="hidden" name="projectId" value="@project.ProjectId" />
                    <input type="hidden" id="bulkWorkerKey" name="workerKey" value="" />
                    <div class="modal-body">
                        <div class="p-3 mb-3 rounded"
                             style="background:#0f1c35; border:1px solid #1e3a5f">
                            <div style="font-size:12px; color:#94a3b8">Assigning tools to:</div>
                            <div class="fw-bold" id="bulkWorkerName" style="font-size:16px"></div>
                        </div>
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="selectAllTools()">
                                ✅ Select All
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    onclick="clearAllTools()">
                                Clear
                            </button>
                            <span id="selectedCount" class="my-auto text-secondary"
                                  style="font-size:13px">0 selected</span>
                        </div>

                        @{
                            var assignableTools = deployedTools
                            .Where(t => string.IsNullOrEmpty(t.AssignedWorkerId))
                            .ToList();
                        }

                        @if (assignableTools.Count > 0)
                        {
                            @foreach (var t in assignableTools)
                            {
                                <div class="d-flex align-items-center gap-3 p-3 mb-2 tool-row"
                                     style="background:#111d33; border-radius:8px;
                                                        cursor:pointer; border:1px solid transparent"
                                     onclick="toggleTool(this)">
                                    <input type="checkbox"
                                           name="toolIds"
                                           value="@t.ToolId"
                                           class="tool-checkbox form-check-input"
                                           style="width:18px; height:18px; cursor:pointer"
                                           onchange="updateCount()" />
                                    <div class="flex-grow-1">
                                        <div class="fw-bold" style="font-size:13px">@t.ToolName</div>
                                        <code style="color:#60a5fa; font-size:11px">@t.ToolId</code>
                                    </div>
                                    <span class="@t.StatusBadgeClass">@t.Status</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-secondary p-4" style="font-size:13px">
                                All deployed tools are already assigned to workers.
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" id="bulkAssignBtn"
                                class="btn btn-primary" disabled>
                            🔧 Assign Selected Tools
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Single Assign Modal -->
    <div class="modal fade" id="singleAssignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">👤 Assign Tool to Worker</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/Project/AssignTool">
                    <input type="hidden" name="projectId" value="@project.ProjectId" />
                    <input type="hidden" id="singleToolId" name="toolId" value="" />
                    <div class="modal-body">
                        <div class="p-3 mb-3 rounded"
                             style="background:#0f1c35; border:1px solid #1e3a5f">
                            <div style="font-size:12px; color:#94a3b8">Assigning tool:</div>
                            <div class="fw-bold" id="singleToolName" style="font-size:15px"></div>
                        </div>
                        <label class="form-label" style="font-size:12px; color:#94a3b8">
                            Select Worker *
                        </label>
                        <select name="workerKey" class="form-select" required>
                            <option value="">— Select Worker —</option>
                            @foreach (var w in assignedWorkers)
                            {
                                <option value="@w.UniqueKey">@w.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">👤 Assign Tool</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ── Bulk Assign Tools to Worker ───────────────────────────────────────
        function openBulkAssign(workerKey, workerName) {
            document.getElementById("bulkWorkerKey").value = workerKey;
            document.getElementById("bulkWorkerName").textContent = workerName;
            document.getElementById("bulkAssignTitle").textContent =
                `🔧 Bulk Assign to ${workerName}`;
            clearAllTools();
            updateCount();
            new bootstrap.Modal(document.getElementById("bulkAssignModal")).show();
        }

        function openSingleAssign(toolId, toolName) {
            document.getElementById("singleToolId").value = toolId;
            document.getElementById("singleToolName").textContent = `${toolName} (${toolId})`;
            new bootstrap.Modal(document.getElementById("singleAssignModal")).show();
        }

        function toggleTool(row) {
            const cb = row.querySelector("input[type='checkbox']");
            if (cb) { cb.checked = !cb.checked; updateRowStyle(row, cb.checked); updateCount(); }
        }
        function updateRowStyle(row, selected) {
            row.style.background = selected ? "#0f2a4a" : "#111d33";
            row.style.border = selected ? "1px solid #3b82f6" : "1px solid transparent";
        }
        function selectAllTools() {
            document.querySelectorAll(".tool-checkbox").forEach(cb => {
                cb.checked = true;
                const row = cb.closest(".tool-row");
                if (row) updateRowStyle(row, true);
            });
            updateCount();
        }
        function clearAllTools() {
            document.querySelectorAll(".tool-checkbox").forEach(cb => {
                cb.checked = false;
                const row = cb.closest(".tool-row");
                if (row) updateRowStyle(row, false);
            });
            updateCount();
        }
        function updateCount() {
            const count = document.querySelectorAll(".tool-checkbox:checked").length;
            const el = document.getElementById("selectedCount");
            if (el) el.textContent = `${count} tool(s) selected`;
            const btn = document.getElementById("bulkAssignBtn");
            if (btn) {
                btn.disabled = count === 0;
                btn.textContent = count === 0 ? "🔧 Assign Selected Tools" : `🔧 Assign ${count} Tool(s)`;
            }
        }

        // ── Bulk Assign Workers ───────────────────────────────────────────────
        function toggleWorker(row) {
            const cb = row.querySelector("input[type='checkbox']");
            if (cb && !cb.disabled) { cb.checked = !cb.checked; updateWorkerRowStyle(row, cb.checked); updateWorkerCount(); }
        }
        function updateWorkerRowStyle(row, selected) {
            row.style.background = selected ? "#0f2a4a" : "#111d33";
            row.style.border = selected ? "1px solid #3b82f6" : "1px solid transparent";
        }
        function selectAllWorkers() {
            document.querySelectorAll(".worker-checkbox:not(:disabled)").forEach(cb => {
                cb.checked = true;
                const row = cb.closest(".worker-row");
                if (row) updateWorkerRowStyle(row, true);
            });
            updateWorkerCount();
        }
        function clearAllWorkers() {
            document.querySelectorAll(".worker-checkbox").forEach(cb => {
                cb.checked = false;
                const row = cb.closest(".worker-row");
                if (row) updateWorkerRowStyle(row, false);
            });
            updateWorkerCount();
        }
        function updateWorkerCount() {
            const count = document.querySelectorAll(".worker-checkbox:checked").length;
            const el = document.getElementById("selectedWorkerCount");
            if (el) el.textContent = `${count} worker(s) selected`;
            const btn = document.getElementById("bulkAssignWorkersBtn");
            if (btn) {
                btn.disabled = count === 0;
                btn.textContent = count === 0 ? "👥 Assign Selected Workers" : `👥 Assign ${count} Worker(s)`;
            }
        }

        // ── Deploy Tools ──────────────────────────────────────────────────────
        function filterDeployTools() {
            // FIX: trim the selected value so it matches the trimmed data-catalog attributes
            const selected = (document.getElementById('deployCatalogSelect').value || '').trim();
            const section  = document.getElementById('deployToolSection');
            const noMsg    = document.getElementById('noToolsMsg');

            clearAllDeployTools();

            if (!selected) {
                section.style.display = 'none';
                return;
            }

            section.style.display = 'block';

            let visibleCount = 0;
            document.querySelectorAll('.deploy-tool-row').forEach(row => {
                // FIX: trim the data attribute value before comparing to avoid
                // invisible whitespace mismatches causing all rows to hide/show incorrectly
                const rowCatalog = (row.dataset.catalog || '').trim();
                if (rowCatalog === selected) {
                    row.style.display = 'block';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            noMsg.style.display = visibleCount === 0 ? 'block' : 'none';
            updateDeployCount();
        }

        function toggleDeployTool(row) {
            const cb = row.querySelector("input[type='checkbox']");
            if (cb) { cb.checked = !cb.checked; updateDeployRowStyle(row, cb.checked); updateDeployCount(); }
        }
        function updateDeployRowStyle(row, selected) {
            row.style.background = selected ? "#0f2a4a" : "#111d33";
            row.style.border = selected ? "1px solid #3b82f6" : "1px solid transparent";
        }
        function selectAllDeployTools() {
            document.querySelectorAll('.deploy-tool-row').forEach(row => {
                // FIX: check display !== 'none' (works for both 'block' and 'flex')
                // rather than === 'flex' which missed rows set to 'block'
                if (row.style.display !== 'none' && row.style.display !== '') {
                    const cb = row.querySelector("input[type='checkbox']");
                    if (cb) { cb.checked = true; updateDeployRowStyle(row, true); }
                }
            });
            updateDeployCount();
        }
        function clearAllDeployTools() {
            document.querySelectorAll('.deploy-tool-checkbox').forEach(cb => {
                cb.checked = false;
                const row = cb.closest('.deploy-tool-row');
                if (row) updateDeployRowStyle(row, false);
            });
            updateDeployCount();
        }
        function updateDeployCount() {
            const count = document.querySelectorAll('.deploy-tool-checkbox:checked').length;
            const el = document.getElementById('deployToolCount');
            if (el) el.textContent = `${count} tool(s) selected`;
            const btn = document.getElementById('deployToolsBtn');
            if (btn) {
                btn.disabled = count === 0;
                btn.textContent = count === 0 ? '➕ Deploy Selected Tools' : `➕ Deploy ${count} Tool(s)`;
            }
        }

        // Reset deploy modal on close
        document.getElementById('deployToolModal')
            .addEventListener('hidden.bs.modal', function () {
                document.getElementById('deployCatalogSelect').value = '';
                document.getElementById('deployToolSection').style.display = 'none';
                clearAllDeployTools();
            });

        document.addEventListener("DOMContentLoaded", function () {
            updateCount();
            updateWorkerCount();
        });
    </script>
}

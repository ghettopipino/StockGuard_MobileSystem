    <script type="module">
        import { initializeApp } from
            'https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js';
        import { getDatabase, ref, onValue } from
            'https://www.gstatic.com/firebasejs/10.7.0/firebase-database.js';

        const app = initializeApp({
            apiKey:            "AIzaSyBshsgxRbZmG8c5orWJhGgd5IJfR8_UVOU",
            authDomain:        "stockguard-e781c.firebaseapp.com",
            databaseURL:       "https://stockguard-e781c-default-rtdb.firebaseio.com",
            projectId:         "stockguard-e781c",
            storageBucket:     "stockguard-e781c.firebasestorage.app",
            messagingSenderId: "684099081472",
            appId:             "1:684099081472:web:ff8b61664efed4b1df0fe5"
        });

        const db = getDatabase(app);

        const watchPaths = [
            'borrowRequests', 'catalogs', 'damageReports',
            'pauseRequests', 'projectTools', 'projectWorkers',
            'projects', 'tools', 'transactions',
            'transferRequests', 'users'
        ];

        let initialized    = false;
        let reloadTimer    = null;
        let lastInteract   = Date.now();
        let isNavigating   = false;

        // ── Track user interaction ─────────────────────────────────
        // Do not reload if user recently clicked or is navigating
        document.addEventListener('click',      () => lastInteract = Date.now());
        document.addEventListener('keydown',    () => lastInteract = Date.now());
        document.addEventListener('mousedown',  () => lastInteract = Date.now());

        // ── Track navigation ───────────────────────────────────────
        document.querySelectorAll('a, button, [type=submit]')
            .forEach(el => {
                el.addEventListener('click', () => {
                    isNavigating = true;
                    // Reset after 3 seconds
                    setTimeout(() => isNavigating = false, 3000);
                });
            });

        // ── Firebase listeners ─────────────────────────────────────
        watchPaths.forEach(path => {
            onValue(ref(db, path), () => {
                if (!initialized) return;

                clearTimeout(reloadTimer);
                reloadTimer = setTimeout(() => {

                    // Do not reload if user clicked in last 3 seconds
                    const timeSinceInteract =
                        Date.now() - lastInteract;
                    if (timeSinceInteract < 3000) return;

                    // Do not reload during navigation
                    if (isNavigating) return;

                    // Do not reload on form pages
                    const p = window.location.pathname.toLowerCase();
                    const isFormPage =
                        p.includes('/create') ||
                        p.includes('/edit')   ||
                        p.includes('/add');

                    if (!isFormPage) window.location.reload();

                }, 3000); // ← increased from 800ms to 3000ms
            });
        });

        // ── Wait 5 seconds before activating ──────────────────────
        // Gives Firebase time to settle all initial fires
        setTimeout(() => { initialized = true; }, 5000);
    </script>
    <!-- ── End Global Real-Time Sync ─────────────────────────────── -->
